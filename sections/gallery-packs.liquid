{%- comment -%}
  "Compón tu pared": sets of 2–3 artworks shown as a gallery wall, added to the
  cart together with one button (theme.js → data-pack-add).
  On the live store a pack shows only when it has real products; in the editor
  empty packs show as placeholders.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign visible = 0
  for block in section.blocks
    if block.settings.product_1 != blank or block.settings.product_2 != blank or block.settings.product_3 != blank
      assign visible = visible | plus: 1
    endif
  endfor
-%}
{%- if visible > 0 or request.design_mode -%}
<section class="section packs">
  <div class="page-width">
    <div class="featured__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="featured__title">{{ s.heading }}</h2>
        {%- if s.subtitle != blank -%}<p class="featured__subtitle">{{ s.subtitle }}</p>{%- endif -%}
      </div>
    </div>

    <ul class="packs__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign ids = ''
          assign total = 0
          assign count = 0
          assign all_available = true
          for i in (1..3)
            assign key = 'product_' | append: i
            assign p = b[key]
            if p != blank
              assign v = p.selected_or_first_available_variant
              assign total = total | plus: v.price
              assign count = count | plus: 1
              if v.available == false
                assign all_available = false
              endif
              if ids != ''
                assign ids = ids | append: ','
              endif
              assign ids = ids | append: v.id
            endif
          endfor
        -%}
        {%- if count > 0 or request.design_mode -%}
          <li class="pack reveal" {{ block.shopify_attributes }}>
            <div class="pack__wall pack__wall--{{ b.layout }}">
              {%- for i in (1..3) -%}
                {%- assign key = 'product_' | append: i -%}
                {%- assign p = b[key] -%}
                {%- if b.layout == 'duo' and i == 3 -%}{%- break -%}{%- endif -%}
                <a class="pack__frame pack__frame--{{ i }}"{% if p != blank %} href="{{ p.url }}"{% endif %}>
                  {%- if p != blank and p.featured_media -%}
                    {{ p.featured_media | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 400, 500', sizes: '(min-width: 990px) 12vw, 30vw', alt: p.title }}
                  {%- else -%}
                    <span class="pack__ph pack__ph--{{ i }}"></span>
                  {%- endif -%}
                </a>
              {%- endfor -%}
              {%- if b.note != blank -%}<span class="pack__badge">{{ b.note }}</span>{%- endif -%}
            </div>
            <div class="pack__info">
              <div>
                <p class="pack__title">{{ b.title }}</p>
                <p class="pack__list">
                  {%- if count > 0 -%}
                    {%- for i in (1..3) -%}
                      {%- assign key = 'product_' | append: i -%}
                      {%- if b[key] != blank -%}{% unless forloop.first %} · {% endunless %}{{ b[key].title }}{%- endif -%}
                    {%- endfor -%}
                  {%- else -%}
                    Elige las obras del pack en el editor.
                  {%- endif -%}
                </p>
              </div>
              {%- if count > 0 -%}<span class="pack__price">{{ total | money }}</span>{%- endif -%}
            </div>
            <button type="button" class="button button--accent button--full pack__add" data-pack-add="{{ ids }}"{% if count == 0 or all_available == false %} disabled{% endif %}>
              {%- if all_available -%}{{ b.button_label }}{%- else -%}Alguna obra está agotada{%- endif -%}
            </button>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Packs de pared",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "PACKS" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Compón tu pared" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Obras pensadas para colgarse juntas. Un clic y tienes la pared entera." }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Pack Trío" },
        { "type": "select", "id": "layout", "label": "Composición", "default": "trio", "options": [
          { "value": "trio", "label": "Tres en línea" },
          { "value": "stack", "label": "Una grande y dos pequeñas" },
          { "value": "duo", "label": "Dos" }
        ] },
        { "type": "product", "id": "product_1", "label": "Obra 1" },
        { "type": "product", "id": "product_2", "label": "Obra 2" },
        { "type": "product", "id": "product_3", "label": "Obra 3" },
        { "type": "text", "id": "note", "label": "Etiqueta (opcional)", "info": "Ej.: «-15% en el pack». Crea el descuento en Shopify → Descuentos para que se aplique." },
        { "type": "text", "id": "button_label", "label": "Botón", "default": "Añadir el pack" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Packs de pared",
      "blocks": [
        { "type": "pack", "settings": { "title": "Pack Trío", "layout": "trio" } },
        { "type": "pack", "settings": { "title": "Pack Salón", "layout": "stack" } },
        { "type": "pack", "settings": { "title": "Pack Dúo", "layout": "duo" } }
      ]
    }
  ]
}
{% endschema %}
