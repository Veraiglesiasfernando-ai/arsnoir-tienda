{%- comment -%}
  «Lienzos» on the home page: a sideways row of the works that come on canvas, shown as a canvas.
  Each picture changes to the canvas in a floating frame and back on its own; two buttons (or hover)
  pick one.
  Images: Shopify files «{handle}-marco-canvas.webp» and «{handle}-marco-canvasframe.webp».
  Each card opens the work with its cheapest canvas already chosen.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign collection = s.collection
-%}
{%- if collection != blank and collection.products_count > 0 -%}
<section class="section lienzos">
  <div class="page-width">
    <div class="featured__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="featured__title">{{ s.heading }}</h2>
        {%- if s.subtitle != blank -%}<p class="featured__subtitle">{{ s.subtitle }}</p>{%- endif -%}
      </div>
      <div class="featured__arrows">
        <button type="button" class="round-btn" data-scroll="-1" data-target="Slider-{{ section.id }}" aria-label="{{ 'general.previous' | t }}">&larr;</button>
        <button type="button" class="round-btn" data-scroll="1" data-target="Slider-{{ section.id }}" aria-label="{{ 'general.next' | t }}">&rarr;</button>
      </div>
    </div>
  </div>

  <ul class="slider lienzos__row" id="Slider-{{ section.id }}">
    {%- for p in collection.products limit: s.limit -%}
      {%- liquid
        assign canvas_v = nil
        for v in p.variants
          unless v.available
            continue
          endunless
          if v.title contains 'Framed' or v.title contains 'marco'
            continue
          endif
          assign is_canvas = false
          if v.title contains 'Canvas'
            assign is_canvas = true
          elsif v.title contains 'Lienzo'
            assign is_canvas = true
          endif
          if is_canvas
            if canvas_v == nil
              assign canvas_v = v
            elsif v.price < canvas_v.price
              assign canvas_v = v
            endif
          endif
        endfor
        if canvas_v == nil
          continue
        endif
        assign base = p.handle | append: '-marco-'
        assign url = p.url | append: '?variant=' | append: canvas_v.id
      -%}
      <li class="slider__item lienzos__item">
        <div class="lienzos__media" data-lienzo>
          <a href="{{ url }}" class="lienzos__pics" tabindex="-1">
            <img src="{{ base | append: 'canvas.webp' | file_url }}" alt="{{ p.title | escape }} en lienzo" loading="lazy" width="1200" height="1500">
            <img class="lienzos__framed" src="{{ base | append: 'canvasframe.webp' | file_url }}" alt="{{ p.title | escape }} en lienzo con marco" loading="lazy" width="1200" height="1500">
          </a>
          <div class="lienzos__switch" role="group" aria-label="{{ p.title | escape }}">
            <button type="button" class="is-on" data-lienzo-show="0" aria-pressed="true">{{ s.label_canvas }}</button>
            <button type="button" data-lienzo-show="1" aria-pressed="false">{{ s.label_framed }}</button>
          </div>
        </div>
        <a href="{{ url }}" class="lienzos__info">
          <span class="lienzos__title">{{ p.title }}</span>
          <span class="lienzos__price">{{ 'general.from' | t }} {{ canvas_v.price | money }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>

  {%- if s.button_label != blank -%}
    <div class="page-width featured__foot"><a class="button" href="{{ collection.url }}">{{ s.button_label }}</a></div>
  {%- endif -%}
</section>

<script>
  /* Each canvas changes to «con marco» and back by itself while it is on screen; the two buttons
     (or hovering on a computer) choose one and stop the change for that work */
  (function () {
    const items = document.querySelectorAll('#shopify-section-{{ section.id }} [data-lienzo]');
    const show = function (m, i) {
      m.classList.toggle('is-framed', i === 1);
      m.querySelectorAll('[data-lienzo-show]').forEach(function (b) {
        const on = parseInt(b.dataset.lienzoShow, 10) === i;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    };
    const visible = new Set();
    items.forEach(function (m, k) {
      m.querySelectorAll('[data-lienzo-show]').forEach(function (b) {
        b.addEventListener('click', function () { m.dataset.held = '1'; show(m, parseInt(b.dataset.lienzoShow, 10)); });
      });
      m.addEventListener('mouseenter', function () { m.dataset.hover = '1'; show(m, 1); });
      m.addEventListener('mouseleave', function () { m.dataset.hover = ''; show(m, 0); });
      m.dataset.k = k;
    });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) visible.add(e.target); else visible.delete(e.target); });
      }, { threshold: 0.6 });
      items.forEach(function (m) { io.observe(m); });
    }
    let tick = 0;
    setInterval(function () {
      tick++;
      visible.forEach(function (m) {
        if (m.dataset.held || m.dataset.hover) return;
        /* Staggered so they don't all flip at once */
        if ((tick + parseInt(m.dataset.k, 10)) % 2 === 0) show(m, m.classList.contains('is-framed') ? 0 : 1);
      });
    }, 1600);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Lienzos",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "EN LIENZO" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lienzos" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Tela sobre bastidor de madera, sin cristal ni reflejos. Y si lo quieres, con marco flotante." },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Número de obras", "min": 2, "max": 16, "step": 1, "default": 10 },
    { "type": "text", "id": "label_canvas", "label": "Etiqueta: lienzo", "default": "Lienzo" },
    { "type": "text", "id": "label_framed", "label": "Etiqueta: con marco", "default": "Lienzo con marco" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "VER TODOS LOS LIENZOS" }
  ],
  "presets": [{ "name": "Lienzos" }]
}
{% endschema %}
