{%- liquid
  assign s = section.settings
  assign collection = s.collection
-%}

<section class="section{% if s.border_top %} section--border-top{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <div>
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        <h2>{{ s.heading | default: collection.title }}</h2>
      </div>
      {%- if collection != blank -%}
        <a class="link-underline" href="{{ collection.url }}">Ver todo</a>
      {%- endif -%}
    </div>

    <ul class="product-grid" style="--cols: {{ s.columns }}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: s.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.limit) -%}
          <li>{% render 'product-card', product: blank, placeholder_index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Selección" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Nuevas obras" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Número de obras", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columnas en escritorio", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "border_top", "label": "Línea superior", "default": false }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
