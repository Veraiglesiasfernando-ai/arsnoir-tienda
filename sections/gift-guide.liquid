{%- comment -%}
  Gift guide: glass tiles by budget, by collection and the gift card.
  Price tiles link to all artworks filtered by price (Shopify filters).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign base = routes.all_products_collection_url
-%}
<section class="section gifts"{% if s.season_only %} data-q4="prebf bf xmas reyes late" hidden{% endif %}>
  <div class="page-width">
    <div class="featured__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="featured__title">{{ s.heading }}</h2>
        {%- if s.subtitle != blank -%}<p class="featured__subtitle">{{ s.subtitle }}</p>{%- endif -%}
      </div>
    </div>

    <ul class="gifts__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign url = ''
          case block.type
            when 'price'
              assign url = base | append: '?'
              if b.min > 0
                assign url = url | append: 'filter.v.price.gte=' | append: b.min | append: '&'
              endif
              if b.max > 0
                assign url = url | append: 'filter.v.price.lte=' | append: b.max
              endif
            when 'collection'
              assign url = b.collection.url | default: base
            when 'gift_card'
              assign url = settings.q4_gift_card.url
          endcase
        -%}
        {%- if url != blank -%}
          <li class="gifts__item reveal" {{ block.shopify_attributes }}>
            <a class="gift-tile gift-tile--{{ b.tone }}" href="{{ url }}">
              <span class="gift-tile__kicker">{{ b.kicker }}</span>
              <span class="gift-tile__title">{{ b.title | default: b.collection.title }}</span>
              {%- if b.text != blank -%}<span class="gift-tile__text">{{ b.text }}</span>{%- endif -%}
              <span class="gift-tile__plus" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Guía de regalos",
  "settings": [
    { "type": "checkbox", "id": "season_only", "label": "Mostrar solo durante la campaña Q4", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "REGALOS" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Guía de regalos" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Arte exclusivo para regalar. Enviamos a España y Europa." }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "price", "name": "Por precio",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "POR PRESUPUESTO" },
        { "type": "text", "id": "title", "label": "Título", "default": "Menos de 50 €" },
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "number", "id": "min", "label": "Precio mínimo (€)", "default": 0 },
        { "type": "number", "id": "max", "label": "Precio máximo (€)", "default": 50, "info": "0 = sin máximo." },
        { "type": "select", "id": "tone", "label": "Estilo", "default": "light", "options": [{ "value": "light", "label": "Cristal claro" }, { "value": "dark", "label": "Negro" }] }
      ]
    },
    {
      "type": "collection", "name": "Colección",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "PARA" },
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título (opcional)" },
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "select", "id": "tone", "label": "Estilo", "default": "light", "options": [{ "value": "light", "label": "Cristal claro" }, { "value": "dark", "label": "Negro" }] }
      ]
    },
    {
      "type": "gift_card", "name": "Tarjeta regalo", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Usa la tarjeta elegida en Configuración del tema → Campaña Q4. Sin tarjeta, no se muestra." },
        { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "SIN DUDAS" },
        { "type": "text", "id": "title", "label": "Título", "default": "Tarjeta regalo" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Llega al instante por email." },
        { "type": "select", "id": "tone", "label": "Estilo", "default": "dark", "options": [{ "value": "light", "label": "Cristal claro" }, { "value": "dark", "label": "Negro" }] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guía de regalos",
      "blocks": [
        { "type": "price", "settings": { "title": "Menos de 50 €", "min": 0, "max": 50 } },
        { "type": "price", "settings": { "title": "De 50 a 100 €", "min": 50, "max": 100 } },
        { "type": "price", "settings": { "title": "Más de 100 €", "min": 100, "max": 0, "tone": "dark" } },
        { "type": "gift_card" }
      ]
    }
  ]
}
{% endschema %}
