{%- assign s = section.settings -%}
{%- assign reviews_label = 'general.customer_reviews' | t -%}

<section class="welcome">
  <div class="welcome__glow" aria-hidden="true"></div>
  <div class="page-width welcome__inner">
    {%- if s.eyebrow != blank -%}
      <p class="welcome__eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}
    <h2 class="welcome__title">{{ s.title | default: shop.name }}</h2>
    {%- if s.subtitle != blank -%}
      <p class="welcome__subtitle">{{ s.subtitle }}</p>
    {%- endif -%}
    {%- if settings.rating_count > 0 and settings.rating_value != blank -%}
      <a href="#Reviews" class="welcome__rating">{% render 'stars', rating: settings.rating_value, count: settings.rating_count, label: reviews_label %}</a>
    {%- endif -%}

    <div class="welcome__cards">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign img = b.image | default: p.featured_media.preview_image
          assign url = b.link | default: p.url | default: routes.all_products_collection_url
          assign title = b.title | default: p.title
          assign num = forloop.index | prepend: '0' | slice: -2, 2
          if title == blank
            assign title = 'Obra ' | append: num
          endif
          assign loading = 'lazy'
          if b.featured
            assign loading = 'eager'
          endif
        -%}
        <a href="{{ url }}" class="poster poster--{{ b.tone }}{% if b.featured %} poster--featured{% endif %}" {{ block.shopify_attributes }}>
          <div class="poster__frame">
            <div class="poster__media">
              {%- if img != blank -%}
                {{ img | image_url: width: 1200 | image_tag: loading: loading, widths: '400, 600, 900, 1200', sizes: '(min-width: 900px) 32vw, 78vw', alt: title }}
              {%- else -%}
                <div class="poster__ph" aria-hidden="true"></div>
              {%- endif -%}
            </div>
            {%- if b.tag != blank -%}<span class="poster__tag">{{ b.tag }}</span>{%- endif -%}
          </div>
          <span class="poster__info">
            <span class="poster__meta">
              <span class="poster__title">{{ title }}</span>
              <span class="poster__price">
                {%- if p != blank -%}{% render 'price', product: p, show_from: true %}{%- else -%}{{ b.placeholder_price }}{%- endif -%}
              </span>
            </span>
            <span class="poster__plus" aria-hidden="true">+</span>
          </span>
        </a>
      {%- endfor -%}
    </div>

    {%- comment -%} Personalízalo: two quick ways in, right under the works {%- endcomment -%}
    {%- if s.pz_show -%}
      {%- liquid
        assign pz_p = all_products['tu-foto-en-un-cuadro']
        assign pz_photo_url = s.pz_photo_link | default: pz_p.url | default: '/products/tu-foto-en-un-cuadro'
        assign pz_tpl_url = s.pz_tpl_link | default: '/collections/personalizalo#Plantillas'
      -%}
      <div class="welcome__pz">
        <a class="wpz reveal" href="{{ pz_photo_url }}">
          <span class="wpz__media">
            {%- if s.pz_photo_image != blank -%}{{ s.pz_photo_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '140px', alt: s.pz_photo_title }}{%- endif -%}
          </span>
          <span class="wpz__body">
            <span class="wpz__tag">{{ s.pz_tag }}</span>
            <span class="wpz__title">{{ s.pz_photo_title }}</span>
            <span class="wpz__text">{{ s.pz_photo_text }}{% if pz_p != blank %} {{ 'general.from' | t }} {{ pz_p.price_min | money }}.{% endif %}</span>
            <span class="wpz__go">{{ s.pz_photo_go }} <span aria-hidden="true">&rarr;</span></span>
          </span>
        </a>
        <a class="wpz reveal" href="{{ pz_tpl_url }}">
          <span class="wpz__media">
            {%- if s.pz_tpl_image != blank -%}{{ s.pz_tpl_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '140px', alt: s.pz_tpl_title }}{%- endif -%}
          </span>
          <span class="wpz__body">
            <span class="wpz__tag">{{ s.pz_tag }}{% if s.pz_tpl_soon %} <span class="wpz__soon">· {{ s.pz_soon_label }}</span>{% endif %}</span>
            <span class="wpz__title">{{ s.pz_tpl_title }}</span>
            <span class="wpz__text">{{ s.pz_tpl_text }}</span>
            <span class="wpz__go">{{ s.pz_tpl_go }} <span aria-hidden="true">&rarr;</span></span>
          </span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bienvenida",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "BIENVENIDO A" },
    { "type": "text", "id": "title", "label": "Título", "default": "ARSNOIR" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Arte que no verás en ningún otro sitio." },
    { "type": "header", "content": "Personalízalo (debajo de las obras)" },
    { "type": "checkbox", "id": "pz_show", "label": "Mostrar las dos tarjetas de Personalízalo", "default": true },
    { "type": "text", "id": "pz_tag", "label": "Etiqueta", "default": "Personalízalo" },
    { "type": "image_picker", "id": "pz_photo_image", "label": "«Con tu foto»: imagen" },
    { "type": "text", "id": "pz_photo_title", "label": "«Con tu foto»: título", "default": "Tu foto, en un cuadro" },
    { "type": "text", "id": "pz_photo_text", "label": "«Con tu foto»: texto", "default": "Sube tu foto y la imprimimos en el tamaño y marco que elijas." },
    { "type": "text", "id": "pz_photo_go", "label": "«Con tu foto»: enlace", "default": "Subir mi foto" },
    { "type": "url", "id": "pz_photo_link", "label": "«Con tu foto»: destino", "info": "Vacío = la ficha «Tu foto, en un cuadro»." },
    { "type": "image_picker", "id": "pz_tpl_image", "label": "«Con plantilla»: imagen" },
    { "type": "text", "id": "pz_tpl_title", "label": "«Con plantilla»: título", "default": "Tu foto, en ilustración" },
    { "type": "text", "id": "pz_tpl_text", "label": "«Con plantilla»: texto", "default": "Elige una plantilla y tu foto se convierte en ilustración." },
    { "type": "text", "id": "pz_tpl_go", "label": "«Con plantilla»: enlace", "default": "Ver plantillas" },
    { "type": "url", "id": "pz_tpl_link", "label": "«Con plantilla»: destino", "info": "Vacío = las plantillas de Personalízalo." },
    { "type": "checkbox", "id": "pz_tpl_soon", "label": "Plantillas aún no a la venta", "default": true, "info": "Añade «Muy pronto» a la tarjeta de plantillas." },
    { "type": "text", "id": "pz_soon_label", "label": "Texto «Muy pronto»", "default": "Muy pronto" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Obra",
      "settings": [
        { "type": "product", "id": "product", "label": "Obra", "info": "Se muestran su imagen, nombre y precio." },
        { "type": "checkbox", "id": "featured", "label": "Carta destacada (más grande)", "default": false },
        { "type": "image_picker", "id": "image", "label": "Imagen personalizada", "info": "Opcional. Sustituye a la imagen de la obra." },
        { "type": "text", "id": "title", "label": "Nombre personalizado" },
        { "type": "text", "id": "tag", "label": "Etiqueta superior", "info": "Ej.: NUEVA, EDICIÓN LIMITADA" },
        {
          "type": "select", "id": "tone", "label": "Color del hueco vacío", "default": "light",
          "options": [
            { "value": "light", "label": "Gris claro" },
            { "value": "dark", "label": "Negro" },
            { "value": "accent", "label": "Gris oscuro" }
          ]
        },
        { "type": "text", "id": "placeholder_price", "label": "Precio de ejemplo (sin obra)", "default": "24,95 €" },
        { "type": "url", "id": "link", "label": "Enlace personalizado" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bienvenida",
      "blocks": [
        { "type": "card", "settings": { "tone": "dark" } },
        { "type": "card", "settings": { "featured": true, "tone": "light" } },
        { "type": "card", "settings": { "tone": "accent" } }
      ]
    }
  ]
}
{% endschema %}
