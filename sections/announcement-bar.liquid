{%- assign msgs = section.blocks | where: 'type', 'message' -%}
{%- if msgs.size > 0 -%}
  <div class="announce" data-announce data-interval="{{ section.settings.interval }}">
    <div class="announce__track">
      {%- for block in msgs -%}
        {%- if block.settings.text != blank -%}
          <p class="announce__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            {{ block.settings.text }}
            {%- if block.settings.link != blank -%}<span class="announce__arrow" aria-hidden="true"> &rarr;</span></a>{%- endif -%}
          </p>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "class": "announcement-section",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 4,
  "settings": [
    { "type": "range", "id": "interval", "label": "Segundos por mensaje", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 4 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Arte exclusivo de ARSNOIR — no lo encontrarás en ningún otro sitio." },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [{ "name": "Barra de anuncio", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
