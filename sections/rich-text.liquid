{%- assign s = section.settings -%}
<section class="section{% if s.border_top %} section--border-top{% endif %}">
  <div class="page-width">
    <div class="rich-text{% if s.center %} rich-text--center{% endif %}">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rich-text__body rte">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="button button--outline" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Texto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Manifiesto" },
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Creemos en las paredes tranquilas. En el contraste, el espacio vacío y las imágenes que se miran despacio. Cada lámina se imprime por encargo, sin excedentes.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "center", "label": "Centrar", "default": true },
    { "type": "checkbox", "id": "border_top", "label": "Línea superior", "default": false }
  ],
  "presets": [{ "name": "Texto" }]
}
{% endschema %}
