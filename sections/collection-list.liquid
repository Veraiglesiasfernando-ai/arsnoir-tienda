{%- assign s = section.settings -%}
{%- assign fallback_title = 'general.collection' | t -%}

<section class="section{% if s.border_top %} section--border-top{% endif %}">
  <div class="page-width">
    {%- if s.heading != blank -%}
      <div class="section-header section-header--center">
        <h2>{{ s.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="collection-grid collection-grid--{{ s.style }}" style="--cols: {{ s.columns }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign img = block.settings.image | default: c.featured_image -%}
        {%- assign title = block.settings.title | default: c.title | default: fallback_title -%}
        <a class="collection-tile" href="{{ c.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="collection-tile__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 900px) 25vw, 50vw', alt: title }}
            {%- elsif s.style == 'framed' -%}
              {% render 'frame-placeholder' %}
            {%- else -%}
              <div class="tile-ph" aria-hidden="true"><span>{{ title }}</span></div>
            {%- endif -%}
          </div>
          <div class="collection-tile__info">
            <span class="collection-tile__title">{{ title }}</span>
            <span class="collection-tile__arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colecciones",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Explorar ediciones" },
    {
      "type": "select", "id": "style", "label": "Estilo de los huecos vacíos", "default": "neutral",
      "options": [
        { "value": "neutral", "label": "Neutro (bloque gris con el nombre)" },
        { "value": "framed", "label": "Con marco negro" }
      ]
    },
    { "type": "range", "id": "columns", "label": "Columnas", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "border_top", "label": "Línea superior", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Título personalizado" },
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Opcional. Si la dejas vacía se muestra un hueco neutro." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colecciones",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
