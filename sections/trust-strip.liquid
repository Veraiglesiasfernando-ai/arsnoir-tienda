{%- comment -%}
  Trust strip: pill buttons in light blue, each with a small icon and an optional link.
  On mobile it scrolls sideways in one line. Texts are editable; keep them true (no invented claims).
{%- endcomment -%}
<section class="trust trust--pills">
  <ul class="page-width trust__list">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <li class="trust__item" {{ block.shopify_attributes }}>
        {%- if b.link != blank -%}<a class="trust__pill" href="{{ b.link }}">{%- else -%}<span class="trust__pill">{%- endif -%}
          <span class="trust__ico" aria-hidden="true">
            {%- case b.icon -%}
              {%- when 'spark' -%}<svg viewBox="0 0 24 24"><path d="M12 2l1.8 5.6L19.5 9l-5.7 1.5L12 16l-1.8-5.5L4.5 9l5.7-1.4z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></svg>
              {%- when 'print' -%}<svg viewBox="0 0 24 24"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></svg>
              {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M2 6h11v10H2zM13 10h4l4 3v3h-8z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
              {%- when 'eye' -%}<svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
              {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-9-9a5 5 0 019-3 5 5 0 019 3c-2 4.6-9 9-9 9z"/></svg>
              {%- when 'lock' -%}<svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
            {%- endcase -%}
          </span>
          <span class="trust__txt">{{ b.text }}</span>
          {%- if b.link != blank -%}<span class="trust__arrow" aria-hidden="true">→</span>{%- endif -%}
        {%- if b.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Tira de confianza",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Elemento",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Arte 100% original" },
        { "type": "select", "id": "icon", "label": "Icono", "default": "check", "options": [
          { "value": "check", "label": "Visto" }, { "value": "spark", "label": "Destello" }, { "value": "print", "label": "Impresora" },
          { "value": "truck", "label": "Camión" }, { "value": "eye", "label": "Ojo" }, { "value": "heart", "label": "Corazón" }, { "value": "lock", "label": "Candado" }
        ] },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tira de confianza",
      "blocks": [
        { "type": "item", "settings": { "text": "Arte 100% original", "icon": "spark" } },
        { "type": "item", "settings": { "text": "Impreso en Europa", "icon": "print" } },
        { "type": "item", "settings": { "text": "Envío a España y Europa", "icon": "truck" } },
        { "type": "item", "settings": { "text": "Solo en ARSNOIR", "icon": "heart" } }
      ]
    }
  ]
}
{% endschema %}
