<section class="page-width">
  {% render 'page-head', eyebrow: section.settings.eyebrow, title: page.title, subtitle: page.content, crumbs: true %}

  <div class="contact reveal">
    {%- form 'contact', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="contact__ok">Gracias por escribirnos. Te responderemos lo antes posible.</p>
      {%- elsif form.errors -%}
        <div class="contact__error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="contact__row">
        <label class="field-float">
          <span>Nombre</span>
          <input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
        </label>
        <label class="field-float">
          <span>Email</span>
          <input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
        </label>
      </div>
      <label class="field-float">
        <span>Nº de pedido (opcional)</span>
        <input type="text" name="contact[pedido]" value="{{ form.pedido }}">
      </label>
      <label class="field-float">
        <span>Mensaje</span>
        <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </label>
      <button class="button button--accent" type="submit">Enviar mensaje</button>
    {%- endform -%}

    <aside class="contact__aside">
      <p class="contact__aside-title">Antes de escribir</p>
      <ul>
        <li><a href="/pages/preguntas-frecuentes">Preguntas frecuentes &rarr;</a></li>
        <li><a href="/pages/envios-y-devoluciones">Envíos y devoluciones &rarr;</a></li>
        <li><a href="/pages/guia-de-tamanos">Guía de tamaños &rarr;</a></li>
      </ul>
      {%- if shop.email != blank -%}
        <p class="contact__mail">O escríbenos a <a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
      {%- endif -%}
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Formulario de contacto",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño (rojo)", "default": "CONTACTO" }
  ]
}
{% endschema %}
