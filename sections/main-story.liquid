{%- assign s = section.settings -%}
<section class="story story--{{ s.style }}">
  <div class="page-width">
    {% render 'page-head', eyebrow: s.eyebrow, title: page.title, subtitle: s.subtitle, crumbs: true %}

    <div class="story__card reveal">
      <div class="story__body rte">
        {{ page.content }}
      </div>
      {%- if s.signature != blank -%}
        <p class="story__signature">{{ s.signature }}</p>
      {%- endif -%}
    </div>

    {%- if s.button_label != blank or s.link_label != blank -%}
      <div class="story__cta reveal">
        {%- if s.button_label != blank -%}
          <a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a>
        {%- endif -%}
        {%- if s.link_label != blank -%}
          <a class="button button--outline" href="{{ s.link_url | default: '/' }}">{{ s.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Historia / Manifiesto",
  "settings": [
    {
      "type": "select", "id": "style", "label": "Estilo", "default": "story",
      "options": [
        { "value": "story", "label": "Historia (texto)" },
        { "value": "manifesto", "label": "Manifiesto (frases grandes numeradas)" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño (rojo)", "default": "ARSNOIR" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo" },
    { "type": "text", "id": "signature", "label": "Firma" },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Ver las obras" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "link_label", "label": "Botón secundario" },
    { "type": "url", "id": "link_url", "label": "Enlace del botón secundario" }
  ]
}
{% endschema %}
