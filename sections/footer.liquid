{%- liquid
  assign s = section.settings
  assign story_page = pages[s.story_page]
  if s.story_page == blank
    assign story_page = pages['la-historia']
  endif
-%}

<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="site-footer__story">
        <p class="eyebrow eyebrow--accent">{{ s.story_eyebrow }}</p>
        <div class="site-footer__story-text rte">
          {%- if story_page.content != blank -%}
            {{ story_page.content }}
          {%- else -%}
            {{ s.story_fallback }}
          {%- endif -%}
        </div>
        {%- if story_page != blank -%}
          <a class="site-footer__more" href="{{ story_page.url }}">{{ 'general.read_story' | t }} &rarr;</a>
        {%- endif -%}
      </div>

      <div class="site-footer__cols">
        {%- for block in section.blocks -%}
          {%- assign menu = linklists[block.settings.menu] -%}
          <div class="site-footer__col" {{ block.shopify_attributes }}>
            <p class="site-footer__heading">{{ block.settings.heading | default: menu.title }}</p>
            <ul>
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="site-footer__wordmark" aria-hidden="true">{{ s.wordmark | default: shop.name }}</div>

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | strip }}. {{ 'general.all_rights' | t }}</span>
      <div class="site-footer__social">
        {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
        {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener">Pinterest</a>{%- endif -%}
      </div>
      {%- if s.show_payment_icons -%}
        <div class="site-footer__secure">
        <span class="site-footer__secure-label">{% render 'trust-icon', name: 'lock' %} {{ 'general.secure_payment' | t }}</span>
        <ul class="site-footer__payments" aria-label="{{ 'general.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "class": "footer-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "story_eyebrow", "label": "Texto pequeño sobre la historia", "default": "LA HISTORIA" },
    { "type": "page", "id": "story_page", "label": "Página de la historia", "info": "Su texto se muestra arriba del pie. Por defecto: La Historia." },
    { "type": "richtext", "id": "story_fallback", "label": "Texto alternativo", "default": "<p>Arte de pared original. Solo en ARSNOIR.</p>" },
    { "type": "text", "id": "wordmark", "label": "Nombre gigante", "default": "ARSNOIR" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar métodos de pago", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Columna de enlaces",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "link_list", "id": "menu", "label": "Menú" }
      ]
    }
  ]
}
{% endschema %}
