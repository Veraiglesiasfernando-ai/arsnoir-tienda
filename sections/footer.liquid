<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div>
        <div class="footer__brand">{{ shop.name | strip }}</div>
        {%- if section.settings.about != blank -%}
          <div class="rte muted" style="max-width:36ch">{{ section.settings.about }}</div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- assign menu = linklists[block.settings.menu] -%}
        <div {{ block.shopify_attributes }}>
          <div class="footer__heading">{{ block.settings.heading | default: menu.title }}</div>
          <ul>
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}

      {%- if settings.social_instagram != blank or settings.social_pinterest != blank or settings.social_tiktok != blank -%}
        <div>
          <div class="footer__heading">Síguenos</div>
          <ul>
            {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
            {%- if settings.social_pinterest != blank -%}<li><a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener">Pinterest</a></li>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | strip }}</span>
      {%- if section.settings.show_payment_icons -%}
        <ul class="footer__payments" aria-label="Métodos de pago">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "class": "footer-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 3,
  "settings": [
    { "type": "richtext", "id": "about", "label": "Texto de marca", "default": "<p>Arte de pared en blanco y negro. Láminas impresas en papel fine art, pensadas para durar.</p>" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Mostrar métodos de pago", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menú",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título" },
        { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
