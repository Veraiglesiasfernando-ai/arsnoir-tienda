{%- assign s = section.settings -%}
{%- liquid
  assign days = settings.returns_days | append: ''
  assign ship = settings.free_shipping_threshold | append: ''
-%}
<section class="section guarantees">
  <div class="page-width">
    {%- if s.heading != blank -%}
      <div class="section-header section-header--center"><h2>{{ s.heading }}</h2></div>
    {%- endif -%}
    <ul class="guarantees__grid">
      {%- for block in section.blocks -%}
        {%- assign text = block.settings.text | replace: '[DIAS]', days | replace: '[ENVIO_GRATIS]', ship -%}
        {%- assign title = block.settings.title | replace: '[DIAS]', days | replace: '[ENVIO_GRATIS]', ship -%}
        <li class="guarantee" {{ block.shopify_attributes }}>
          <span class="guarantee__icon">{% render 'trust-icon', name: block.settings.icon %}</span>
          <h3 class="guarantee__title">{{ title }}</h3>
          <p class="guarantee__text">{{ text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Garantías",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Compra con total tranquilidad" },
    { "type": "paragraph", "content": "En los textos puedes usar [DIAS] y [ENVIO_GRATIS]; se sustituyen por los valores de Configuración del tema → Conversión." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantía",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icono", "default": "truck",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "return", "label": "Devolución" },
            { "value": "print", "label": "Impresión" },
            { "value": "lock", "label": "Pago seguro" },
            { "value": "star", "label": "Estrella" }
          ]
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Envío a toda España" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Gratis en pedidos desde [ENVIO_GRATIS] €." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Garantías",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Envío a toda España", "text": "Gratis en pedidos desde [ENVIO_GRATIS] €. Seguimiento en cada pedido." } },
        { "type": "item", "settings": { "icon": "return", "title": "[DIAS] días para devolver", "text": "Si no encaja en tu pared, tienes [DIAS] días para devolverla." } },
        { "type": "item", "settings": { "icon": "print", "title": "Impresión de alta calidad", "text": "Cada obra se imprime bajo demanda para ti, con papeles y tintas profesionales." } },
        { "type": "item", "settings": { "icon": "lock", "title": "Pago 100% seguro", "text": "Pagos cifrados y protegidos a través de Shopify." } }
      ]
    }
  ]
}
{% endschema %}
