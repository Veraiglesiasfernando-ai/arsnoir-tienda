{%- assign s = section.settings -%}
<section class="section section--tight{% if s.border_top %} section--border-top{% endif %}">
  <div class="page-width">
    {%- if s.heading != blank -%}
      <div class="section-header"><h2>{{ s.heading }}</h2></div>
    {%- endif -%}
    <div class="values" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <div class="values__item" {{ block.shopify_attributes }}>
          <span class="values__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.title }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compromisos",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "checkbox", "id": "border_top", "label": "Línea superior", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Elemento",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Papel fine art" },
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Papel mate de alto gramaje y tintas pigmentadas de larga duración.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compromisos",
      "blocks": [
        { "type": "item", "settings": { "title": "Papel fine art", "text": "<p>Papel mate de alto gramaje y tintas pigmentadas de larga duración.</p>" } },
        { "type": "item", "settings": { "title": "Impreso por encargo", "text": "<p>Cada lámina se imprime cuando la pides. Sin stock, sin excedentes.</p>" } },
        { "type": "item", "settings": { "title": "Envío protegido", "text": "<p>Enviado en tubo rígido o caja plana con esquinas reforzadas.</p>" } },
        { "type": "item", "settings": { "title": "Devolución 30 días", "text": "<p>Si la obra no encaja en tu pared, te devolvemos el dinero.</p>" } }
      ]
    }
  ]
}
{% endschema %}
