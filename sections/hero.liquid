{%- liquid
  assign s = section.settings
  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif
-%}

{%- if s.layout == 'split' -%}
  <section class="hero-split">
    <div class="hero-split__text">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<{{ heading_tag }} class="h1">{{ s.heading }}</{{ heading_tag }}>{%- endif -%}
      {%- if s.text != blank -%}<div class="hero__text muted">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        <div><a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a></div>
      {%- endif -%}
    </div>
    <div class="hero-split__media{% if s.grayscale %} hero__media--grayscale{% endif %}">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1800', sizes: '(min-width: 900px) 50vw, 100vw' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </section>
{%- else -%}
  <section class="hero hero--{{ s.height }}">
    <div class="hero__media{% if s.grayscale %} hero__media--grayscale{% endif %}">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
      <div class="hero__overlay" style="opacity: {{ s.overlay | divided_by: 100.0 }}"></div>
    </div>
    <div class="hero__content hero__content--{{ s.position }}{% if s.light_text %} hero__content--light{% endif %}">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<{{ heading_tag }} class="h1">{{ s.heading }}</{{ heading_tag }}>{%- endif -%}
      {%- if s.text != blank -%}<div class="hero__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        <div><a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a></div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Portada",
  "settings": [
    {
      "type": "select", "id": "layout", "label": "Diseño", "default": "split",
      "options": [
        { "value": "split", "label": "Dividido (texto + imagen)" },
        { "value": "full", "label": "Imagen completa" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "checkbox", "id": "grayscale", "label": "Mostrar imagen en blanco y negro", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Colección 01" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Arte para paredes que no necesitan color." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Láminas en blanco y negro, impresas en papel fine art de calidad museo.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver obras" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "header", "content": "Solo para \"Imagen completa\"" },
    {
      "type": "select", "id": "height", "label": "Altura", "default": "full",
      "options": [
        { "value": "full", "label": "Pantalla completa" },
        { "value": "large", "label": "Grande" },
        { "value": "medium", "label": "Media" }
      ]
    },
    {
      "type": "select", "id": "position", "label": "Posición del texto", "default": "bottom-left",
      "options": [
        { "value": "bottom-left", "label": "Abajo a la izquierda" },
        { "value": "bottom-center", "label": "Abajo centrado" },
        { "value": "center", "label": "Centro" }
      ]
    },
    { "type": "checkbox", "id": "light_text", "label": "Texto blanco", "default": true },
    { "type": "range", "id": "overlay", "label": "Oscurecer imagen", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 }
  ],
  "presets": [{ "name": "Portada" }]
}
{% endschema %}
