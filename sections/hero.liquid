{%- liquid
  assign s = section.settings
  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif
-%}

<section class="hero hero--{{ s.height }}{% if s.image == blank %} hero--solid{% endif %}">
  {%- if s.image != blank -%}
    <div class="hero__media{% if s.grayscale %} hero__media--grayscale{% endif %}">
      {{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw' }}
      <div class="hero__overlay" style="opacity: {{ s.overlay | divided_by: 100.0 }}"></div>
    </div>
  {%- endif -%}
  <div class="hero__content hero__content--center hero__content--light">
    {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
    {%- if s.heading != blank -%}<{{ heading_tag }} class="hero__heading">{{ s.heading }}</{{ heading_tag }}>{%- endif -%}
    {%- if s.text != blank -%}<div class="hero__text">{{ s.text }}</div>{%- endif -%}
    {%- if s.button_label != blank -%}
      <div><a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Portada",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo", "info": "Opcional. Sin imagen, el fondo es negro." },
    { "type": "checkbox", "id": "grayscale", "label": "Imagen en blanco y negro", "default": true },
    { "type": "range", "id": "overlay", "label": "Oscurecer imagen", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40 },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "WELCOME OFFER — 40% OFF YOUR FIRST PURCHASE" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    {
      "type": "select", "id": "height", "label": "Altura", "default": "full",
      "options": [
        { "value": "full", "label": "Pantalla completa" },
        { "value": "large", "label": "Grande" },
        { "value": "medium", "label": "Media" }
      ]
    }
  ],
  "presets": [{ "name": "Portada" }]
}
{% endschema %}
