{%- liquid
  assign cart_eyebrow = 'cart.eyebrow' | t
  assign cart_title = 'cart.page_title' | t
-%}
<section class="page-width cart-page">
  {% render 'page-head', eyebrow: cart_eyebrow, title: cart_title, crumbs: true %}

  {%- if cart.item_count > 0 -%}
    {%- liquid
      assign eligible = 0
      for item in cart.items
        if item.properties['_regalo'] == blank
          assign eligible = eligible | plus: item.final_line_price
        endif
      endfor
    -%}
    {%- if settings.gift_enabled -%}<div class="cart-page__gifts">{% render 'gift-tiers', eligible: eligible %}</div>{%- endif -%}
    {% render 'free-shipping-bar' %}
    {% render 'delivery-estimate' %}
    <form action="{{ routes.cart_url }}" method="post" class="cart" novalidate>
      <div>
        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a class="cart-item__media" href="{{ item.url }}">
                {%- render 'cart-line-image', item: item -%}
              </a>
              <div>
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                <div class="cart-item__meta">
                  {%- unless item.product.has_only_default_variant -%}
                    <div>{% render 'variant-label', variant: item.variant, product: item.product %}</div>
                  {%- endunless -%}
                  {%- for property in item.properties -%}
                    {%- unless property.last == blank or property.first contains '_' -%}
                      <div>{{ property.first }}: {{ property.last }}</div>
                    {%- endunless -%}
                  {%- endfor -%}
                  <div>{%- if item.original_price > item.final_price -%}<s class="muted">{{ item.original_price | money }}</s> {% endif -%}{{ item.final_price | money }}</div>
                </div>
                <div class="cart-item__actions">
                  <div class="qty">
                    <button type="button" data-qty="-1" aria-label="{{ 'cart.less' | t }}">&minus;</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'cart.quantity_of' | t: title: item.product.title }}">
                    <button type="button" data-qty="1" aria-label="{{ 'cart.more' | t }}">+</button>
                  </div>
                  <a class="cart-item__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                </div>
              </div>
              <div class="cart-item__price">{{ item.final_line_price | money }}</div>
            </li>
          {%- endfor -%}
        </ul>
        <button type="submit" name="update" class="link-underline" style="background:none;border:0;border-bottom:1px solid;margin-top:24px">{{ 'cart.update' | t }}</button>
      </div>

      <aside class="cart-summary">
        {%- comment -%} Products before discounts, every discount (pack, codes), shipping, then what is paid {%- endcomment -%}
        <div class="cart-summary__row"><span>{{ 'cart.items_before_discounts' | t }}</span><span>{{ cart.original_total_price | money }}</span></div>
        {%- for discount in cart.discount_applications -%}
          {%- if discount.total_allocated_amount > 0 -%}
            <div class="cart-summary__row cart-summary__row--discount"><span>{% if discount.type == 'discount_code' %}{{ 'cart.code' | t }} {% endif %}{{ discount.title | split: ' (' | first }}</span><span>&minus;{{ discount.total_allocated_amount | money }}</span></div>
          {%- endif -%}
        {%- endfor -%}
        {%- assign page_ship_threshold = settings.free_shipping_threshold | times: 100 -%}
        <div class="cart-summary__row">
          <span>{{ 'cart.shipping' | t }}</span>
          {%- if page_ship_threshold > 0 and cart.total_price >= page_ship_threshold and cart.currency.iso_code == shop.currency -%}
            <strong>{{ 'cart.free' | t }}</strong>
          {%- else -%}
            <span data-ship-estimate data-country="{{ localization.country.iso_code }}">{{ 'cart.shipping_at_checkout' | t }}</span>
          {%- endif -%}
        </div>
        <div class="cart-summary__row cart-summary__total"><span>{{ 'cart.total_before_shipping' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <small>{% if cart.taxes_included %}{{ 'cart.taxes_included' | t }} {% endif %}{{ 'cart.shipping_final_at_checkout' | t }}</small>

        {%- if settings.cart_gift -%}
          {% render 'cart-gift', id: 'page' %}
        {%- elsif section.settings.show_note -%}
          <details class="cart-note">
            <summary>{{ 'cart.add_note' | t }}</summary>
            <textarea class="field" name="note" aria-label="{{ 'cart.note_label' | t }}">{{ cart.note }}</textarea>
          </details>
        {%- endif -%}

        <button type="submit" name="checkout" class="button button--full button--accent">{{ 'cart.checkout' | t }}</button>
        <a class="cart-summary__continue" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
        <p class="cart-summary__secure">{% render 'trust-icon', name: 'lock' %} {{ 'general.secure_payment' | t }}</p>
        <ul class="cart-summary__payments" aria-label="{{ 'general.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
        {%- if additional_checkout_buttons -%}
          <div style="margin-top:12px">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
      </aside>
    </form>
    <div class="cart-page__upsell" data-cart-upsell data-product-id="{{ cart.items.first.product_id }}"></div>
  {%- else -%}
    <div class="empty-note">
      <p class="empty-note__title">{{ 'cart.empty' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.see_works' | t }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Carrito",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Permitir nota del pedido", "default": true }
  ]
}
{% endschema %}
