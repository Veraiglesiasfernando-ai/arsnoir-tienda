{%- comment -%}
  Judge.me's own review widget (app block), so customers can always write a review: the old
  metafield widget is no longer filled by Judge.me. «Escribir una opinión» above links here.
{%- endcomment -%}
<section class="section app-reviews" id="EscribirOpinion">
  <div class="page-width app-reviews__inner">
    {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
  </div>
</section>
<div class="rvm" data-rvm hidden role="dialog" aria-modal="true" aria-label="Escribir una opinión">
  <div class="rvm__card">
    <button type="button" class="rvm__close" data-rvm-close aria-label="Cerrar">✕</button>
    <p class="rvm__eyebrow">Tu opinión</p>
    <h2 class="rvm__title">¿Qué tal tu cuadro?</h2>
    <p class="rvm__sub">Puntúa, cuéntanos y, si quieres, sube una foto de cómo queda en tu pared.</p>
    <div class="rvm__body" data-rvm-body></div>
  </div>
</div>
<script>
(function () {
  /* «Escribir una opinión»: Judge.me's own form (stars, text, photo upload) in a popup, no scrolling */
  var modal = document.querySelector('[data-rvm]'), body = modal && modal.querySelector('[data-rvm-body]');
  var src = document.querySelector('#EscribirOpinion .app-reviews__inner');
  if (!modal || !src) return;
  document.body.appendChild(modal);
  function close() { modal.hidden = true; document.documentElement.classList.remove('rvm-lock'); }
  function openForm() {
    /* New Judge.me widget has its own popup form: open it directly, page stays where it is */
    var jb = document.querySelector('[data-testid="write-review-button"]');
    if (jb) { jb.click(); return; }
    if (document.querySelector('.jm-review-widget__header-and-body, [class*="jm-review-widget"]')) {
      var n = 0, w = setInterval(function () { var x = document.querySelector('[data-testid="write-review-button"]'); if (x) { clearInterval(w); x.click(); } else if (++n > 20) clearInterval(w); }, 250);
      return;
    }
    if (!body.firstChild) while (src.firstChild) body.appendChild(src.firstChild);
    modal.hidden = false; document.documentElement.classList.add('rvm-lock');
    var tries = 0, t = setInterval(function () {
      var form = body.querySelector('.jdgm-form-wrapper, .jdgm-form');
      var b = body.querySelector('.jdgm-write-rev-link');
      if (form && form.offsetParent) { clearInterval(t); return; }
      if (b) { b.click(); }
      if (++tries > 40) clearInterval(t);
    }, 250);
  }
  modal.addEventListener('click', function (e) { if (e.target === modal || e.target.closest('[data-rvm-close]')) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
  document.addEventListener('click', function (e) { if (e.target.closest('[data-rvm-open], a[href="#EscribirOpinion"]')) { e.preventDefault(); openForm(); } });
  if (/[?&]opinar=1/.test(location.search)) { window.addEventListener('load', function () { setTimeout(openForm, 800); }); }
})();
</script>
{% schema %}
{ "name": "Opiniones (Judge.me)", "blocks": [{ "type": "@app" }], "presets": [{ "name": "Opiniones (Judge.me)" }] }
{% endschema %}
