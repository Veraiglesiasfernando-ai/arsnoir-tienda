{%- comment -%}
  Slide-in cart. Rendered in the layout and re-rendered through the Section
  Rendering API (?sections=cart-drawer) after every cart change.
{%- endcomment -%}
<div class="drawer" id="CartDrawer" data-cart-drawer aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.label' | t }}" tabindex="-1">
    <div class="drawer__head">
      <p class="drawer__title">{{ 'cart.title' | t }} <span class="drawer__count" data-cart-count-text>{{ cart.item_count }}</span></p>
      <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__ship">{% render 'free-shipping-bar' %}{% render 'delivery-estimate', compact: true %}</div>
      <ul class="drawer__items">
        {%- for item in cart.items -%}
          <li class="drawer-item">
            <a class="drawer-item__media" href="{{ item.url }}">
              {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}
            </a>
            <div class="drawer-item__body">
              <a class="drawer-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="drawer-item__variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="drawer-item__row">
                <div class="drawer-qty">
                  <button type="button" data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.less' | t }}">&minus;</button>
                  <span>{{ item.quantity }}</span>
                  <button type="button" data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.more' | t }}">+</button>
                </div>
                <span class="drawer-item__price">{{ item.final_line_price | money }}</span>
              </div>
              <button type="button" class="drawer-item__remove" data-cart-change data-line="{{ forloop.index }}" data-quantity="0">{{ 'cart.remove' | t }}</button>
            </div>
          </li>
        {%- endfor -%}
        <li class="drawer__upsell" data-cart-upsell data-product-id="{{ cart.items.first.product_id }}"></li>
      </ul>
      <div class="drawer__foot">
        <div class="drawer__total"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <p class="drawer__note">{% if cart.taxes_included %}{{ 'cart.taxes_included' | t }} {% endif %}{% if settings.free_shipping_threshold == 0 and settings.shipping_message != blank %}{{ settings.shipping_message }}.{% else %}{{ 'cart.shipping_at_checkout' | t }}{% endif %}</p>
        <form action="{{ routes.cart_url }}" method="post">
          {% render 'cart-gift', id: 'drawer' %}
          <button type="submit" name="checkout" class="button button--accent button--full">{{ 'cart.checkout' | t }}</button>
        </form>
        <a class="drawer__view" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
        <p class="drawer__secure">{% render 'trust-icon', name: 'lock' %} {{ 'general.secure_payment' | t }}</p>
      </div>
    {%- else -%}
      <div class="drawer__empty">
        <p class="drawer__empty-title">{{ 'cart.empty' | t }}</p>
        <p class="drawer__empty-text">{{ 'cart.empty_text' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.see_works' | t }}</a>
      </div>
    {%- endif -%}
  </aside>
</div>

{% schema %}
{ "name": "Carrito lateral", "settings": [] }
{% endschema %}
