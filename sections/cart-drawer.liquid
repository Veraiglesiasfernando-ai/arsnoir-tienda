{%- comment -%}
  Slide-in cart. Rendered in the layout and re-rendered through the Section
  Rendering API (?sections=cart-drawer) after every cart change.

  Everything shown is real Shopify data: the gift line and its 0 € price, the pack and
  welcome-code discounts come from Shopify discounts (cart.discount_applications);
  the tiers only mirror the thresholds configured in Theme settings. theme.js adds or
  removes the mystery gift line to match the tier, and drops it if Shopify does not
  make it free (e.g. a non-combinable code won). No fake timers or stock.
{%- endcomment -%}
{%- liquid
  assign gift_variant = false
  if settings.gift_enabled and settings.gift_product != blank
    assign gift_variant = settings.gift_product.selected_or_first_available_variant
  endif

  assign eligible = 0
  assign gift_qty = 0
  for item in cart.items
    if gift_variant and item.variant_id == gift_variant.id
      assign gift_qty = gift_qty | plus: item.quantity
    else
      assign eligible = eligible | plus: item.final_line_price
    endif
  endfor

  assign has_code = false
  assign has_discount = false
  for d in cart.discount_applications
    if d.type == 'discount_code'
      assign has_code = true
    endif
    if d.total_allocated_amount > 0
      assign has_discount = true
    endif
  endfor

  assign ship_threshold = settings.free_shipping_threshold | times: 100
-%}
<div class="drawer" id="CartDrawer" data-cart-drawer aria-hidden="true" style="--cart-accent: {{ settings.cart_accent | default: '#B3001B' }}">
  <div class="drawer__overlay" data-drawer-close></div>
  <aside class="drawer__panel cartx" role="dialog" aria-modal="true" aria-label="{{ 'cart.label' | t }}" tabindex="-1"
    data-item-count="{{ cart.item_count }}" data-has-code="{{ has_code }}" data-has-discount="{{ has_discount }}">
    <script type="application/json" data-cart-config>
      {
        "giftVariant": {% if gift_variant %}{{ gift_variant.id }}{% else %}null{% endif %},
        "giftAvailable": {% if gift_variant and gift_variant.available %}true{% else %}false{% endif %},
        "tier1": {{ settings.gift_tier1 | times: 100 }},
        "tier2": {{ settings.gift_tier2 | times: 100 }},
        "giftQty": {{ gift_qty }},
        "eligible": {{ eligible }},
        "exitCode": {{ settings.exit_code | strip | json }},
        "exitEnabled": {{ settings.exit_enabled | json }}
      }
    </script>

    <div class="drawer__head">
      <p class="drawer__title">{{ 'cart.title' | t }} <span class="drawer__count" data-cart-count-text>{{ cart.item_count }}</span></p>
      <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>

    {%- if cart.item_count > 0 -%}
      {%- if gift_variant -%}
        {% render 'gift-tiers', eligible: eligible %}
      {%- endif -%}

      {%- if settings.q4_enabled -%}
        <div class="cartx__q4" data-q4="bf" hidden>
          <span class="cartx__q4-text">{% if settings.q4_bf_offer != blank %}{{ settings.q4_bf_offer }} · {% endif %}{{ 'cart.q4_bf' | t }}</span>
          {% render 'cart-countdown', to: 'bfEnd' %}
        </div>
        <div class="cartx__q4" data-q4="xmas" hidden>
          <span class="cartx__q4-text">{{ 'cart.q4_xmas' | t }}</span>
          {% render 'cart-countdown', to: 'xmas' %}
        </div>
        <div class="cartx__q4" data-q4="reyes" hidden>
          <span class="cartx__q4-text">{{ 'cart.q4_reyes' | t }}</span>
          {% render 'cart-countdown', to: 'reyes' %}
        </div>
      {%- endif -%}

      <div class="cartx__scroll">
        <ul class="cartx__items">
          {%- for item in cart.items -%}
            {%- liquid
              assign line = forloop.index
              assign is_gift = false
              if gift_variant and item.variant_id == gift_variant.id
                assign is_gift = true
              endif
              assign ed_size = item.product.metafields.custom.edition_size.value | default: 0
              assign ed_sold = item.product.metafields.custom.edition_sold.value | default: 0
              assign ed_left = ed_size | minus: ed_sold

              # Frame choice: every available framed variant (black, white, wood…) with the same size.
              assign frames = ''
              assign frame_count = 0
              assign frame_idx = -1
              unless is_gift
                for opt in item.product.options_with_values
                  assign k = opt.name | downcase
                  if k contains 'marco' or k contains 'acabado' or k contains 'frame'
                    assign frame_idx = forloop.index0
                  endif
                endfor
              endunless
              if frame_idx >= 0
                assign current_frame = item.variant.options[frame_idx] | downcase
                if current_frame contains 'sin' or current_frame contains 'without' or current_frame contains 'no '
                  for v in item.product.variants
                    if v.available == false
                      continue
                    endif
                    assign v_frame = v.options[frame_idx] | downcase
                    if v_frame contains 'sin' or v_frame contains 'without' or v_frame contains 'no '
                      continue
                    endif
                    assign same = true
                    for o in v.options
                      if forloop.index0 != frame_idx and o != item.variant.options[forloop.index0]
                        assign same = false
                      endif
                    endfor
                    if same
                      assign diff = v.price | minus: item.variant.price | times: item.quantity
                      assign diff_money = diff | money
                      assign frame_name = v.options[frame_idx] | remove: 'Marco ' | remove: 'marco ' | remove: 'Frame ' | remove: ' frame' | capitalize
                      capture swatch
                        render 'frame-swatch', value: v.options[frame_idx]
                      endcapture
                      capture chip
                        echo '<button type="button" class="cartx-frame" data-frame-upgrade data-key="' | append: item.key | append: '" data-variant="' | append: v.id | append: '" data-quantity="' | append: item.quantity | append: '">'
                        echo swatch
                        echo '<span class="cartx-frame__name">' | append: frame_name | append: '</span>'
                        echo '<span class="cartx-frame__price">+' | append: diff_money | append: '</span></button>'
                      endcapture
                      assign frames = frames | append: chip
                      assign frame_count = frame_count | plus: 1
                    endif
                  endfor
                endif
              endif
            -%}
            <li class="cartx-item{% if is_gift %} cartx-item--gift{% endif %}">
              {%- if is_gift -%}
                <span class="cartx-item__media cartx-item__media--mystery" aria-hidden="true"><span>?</span></span>
              {%- else -%}
                <a class="cartx-item__media" href="{{ item.url }}">
                  {%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title }}{%- else -%}<span class="cartx-item__ph"></span>{%- endif -%}
                </a>
              {%- endif -%}
              <div class="cartx-item__body">
                <div class="cartx-item__top">
                  {%- if is_gift -%}
                    <p class="cartx-item__title">{{ 'cart.gift_title' | t }}</p>
                  {%- else -%}
                    <a class="cartx-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                    <button type="button" class="cartx-item__remove" data-cart-change data-line="{{ line }}" data-quantity="0" aria-label="{{ 'cart.remove' | t }}">{% render 'icon', name: 'close' %}</button>
                  {%- endif -%}
                </div>
                {%- if is_gift -%}
                  <p class="cartx-item__variant">{{ 'cart.gift_subtitle' | t }}</p>
                {%- elsif item.product.has_only_default_variant == false -%}
                  <p class="cartx-item__variant">{{ item.options_with_values | map: 'value' | join: ' · ' }}</p>
                {%- endif -%}
                {%- if is_gift == false and ed_size > 0 and ed_left > 0 -%}
                  <p class="cartx-item__edition">
                    {%- if ed_left == 1 -%}{{ 'cart.edition_last' | t }}{%- else -%}{{ 'cart.edition_left' | t: left: ed_left, total: ed_size }}{%- endif -%}
                  </p>
                {%- endif -%}
                <div class="cartx-item__row">
                  {%- if is_gift -%}
                    <span class="cartx-item__qty-fixed">× {{ item.quantity }}</span>
                  {%- else -%}
                    <div class="drawer-qty">
                      <button type="button" data-cart-change data-line="{{ line }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="{{ 'cart.less' | t }}">&minus;</button>
                      <span>{{ item.quantity }}</span>
                      <button type="button" data-cart-change data-line="{{ line }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="{{ 'cart.more' | t }}">+</button>
                    </div>
                  {%- endif -%}
                  <span class="cartx-item__price">
                    {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                    {%- if is_gift and item.final_line_price == 0 -%}<strong class="cartx-free">{{ 'cart.free' | t }}</strong>{%- else -%}{{ item.final_line_price | money }}{%- endif -%}
                  </span>
                </div>
                {%- if frame_count > 0 -%}
                  <div class="cartx-upgrade">
                    <p class="cartx-upgrade__title"><strong>{{ 'cart.add_frame' | t }}</strong> <span>{{ 'cart.add_frame_hint' | t }}</span></p>
                    <div class="cartx-upgrade__frames">{{ frames }}</div>
                  </div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="drawer__upsell" data-cart-upsell data-product-id="{{ cart.items.first.product_id }}"></div>
      </div>

      <div class="drawer__foot cartx__foot">
        {%- for d in cart.discount_applications -%}
          {%- if d.total_allocated_amount > 0 -%}
            {%- liquid
              assign is_pack = false
              if settings.pack_discount_title != blank and d.title contains settings.pack_discount_title
                assign is_pack = true
              endif
              assign is_gift_discount = false
              if gift_variant and d.type == 'automatic' and d.title contains 'egalo'
                assign is_gift_discount = true
              endif
            -%}
            {%- unless is_gift_discount -%}
              <div class="cartx__row cartx__row--discount">
                <span>{% if is_pack %}<span class="cartx-check" aria-hidden="true"></span>{{ settings.pack_message }}{% elsif d.type == 'discount_code' %}{{ 'cart.code' | t }} {{ d.title }}{% else %}{{ d.title }}{% endif %}</span>
                <span>&minus;{{ d.total_allocated_amount | money }}</span>
              </div>
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="cartx__row cartx__row--sub"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <div class="cartx__row cartx__row--ship">
          <span>{{ 'cart.shipping' | t }}</span>
          {%- if ship_threshold > 0 and eligible >= ship_threshold -%}
            <strong class="cartx-free">{{ 'cart.free' | t }}</strong>
          {%- else -%}
            <span data-ship-estimate data-country="{{ localization.country.iso_code }}">{{ 'cart.shipping_at_checkout' | t }}</span>
          {%- endif -%}
        </div>
        <form action="{{ routes.cart_url }}" method="post" class="cartx__form">
          <button type="submit" name="checkout" class="button button--accent button--full cartx__checkout">
            {% render 'trust-icon', name: 'lock' %}
            <span>{{ 'cart.secure_checkout' | t }}</span>
            <span class="cartx__checkout-total">{{ cart.total_price | money }}</span>
          </button>
        </form>
        <ul class="cartx__badges">
          <li>
            {%- if settings.rating_count > 0 and settings.rating_value != blank -%}
              <span class="cartx__badge-top">★★★★★</span><span>{{ settings.rating_value }} · {{ settings.rating_count }} {{ 'general.reviews' | t }}</span>
            {%- else -%}
              <span class="cartx__badge-top">{% render 'icon', name: 'heart' %}</span><span>{{ 'cart.badge_original' | t }}</span>
            {%- endif -%}
          </li>
          <li><span class="cartx__badge-top">{% render 'trust-icon', name: 'print' %}</span><span>{{ 'cart.badge_quality' | t }}</span></li>
          <li><span class="cartx__badge-top">{% render 'trust-icon', name: 'return' %}</span><span>{{ 'cart.trust_returns' | t: days: settings.returns_days }}</span></li>
        </ul>
      </div>
    {%- else -%}
      <div class="drawer__empty">
        <p class="drawer__empty-title">{{ 'cart.empty' | t }}</p>
        <p class="drawer__empty-text">{{ 'cart.empty_text' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.see_works' | t }}</a>
      </div>
    {%- endif -%}
  </aside>

  {%- if settings.exit_enabled and settings.exit_code != blank -%}
    <div class="cart-exit" data-cart-exit hidden>
      <div class="cart-exit__backdrop" data-cart-exit-close></div>
      <div class="cart-exit__card" role="dialog" aria-modal="true" aria-labelledby="CartExitTitle">
        <p class="cart-exit__logo">{{ shop.name | strip | downcase }}</p>
        <p class="cart-exit__title" id="CartExitTitle">{{ settings.exit_heading }}</p>
        <div data-cart-exit-form>
          {%- if settings.exit_text != blank -%}<p class="cart-exit__text">{{ settings.exit_text }}</p>{%- endif -%}
          {%- form 'customer', id: 'CartExitForm', class: 'cart-exit__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,cart-exit">
            <label class="visually-hidden" for="CartExitEmail">{{ 'general.email' | t }}</label>
            <input class="cart-exit__field" id="CartExitEmail" type="email" name="contact[email]" placeholder="{{ 'general.your_email' | t }}" autocomplete="email" required>
            <button class="button button--accent button--full" type="submit">{{ settings.exit_button }}</button>
          {%- endform -%}
          <p class="cart-exit__error" data-cart-exit-error hidden>{{ 'cart.exit_error' | t }}</p>
        </div>
        <p class="cart-exit__ok" data-cart-exit-ok hidden><span class="cartx-check" aria-hidden="true"></span>{{ settings.exit_success }}</p>
        <button type="button" class="cart-exit__decline" data-cart-exit-decline>{{ settings.exit_decline }}</button>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Carrito lateral", "settings": [] }
{% endschema %}
