{%- comment -%}
  «Crea tu póster» (template product.poster): the customer picks a design (collage, canción, tipográfico,
  revista, fotomatón), uploads photos and writes the texts, and sees it live in its frame. On «Añadir al
  carrito» the browser draws the print file at full size and sends it with the order as the line-item file
  «Archivo para imprimir» (plus «Diseño» and «Textos» as properties), like «Tu foto». Plain form post
  to /cart/add (no ajax) so the file always travels with it.
  Variants: same structure as «Tu foto» — Size / Product (Premium Matte Paper Poster | … Wooden Framed Poster) / Style.
{%- endcomment -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Caveat:wght@600&family=Inter:wght@400;600;800&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Space+Mono:wght@400;700&display=swap">
{%- liquid
  assign posters = product.variants | where: 'option2', 'Premium Matte Paper Poster'
  assign framed = product.variants | where: 'option2', 'Premium Matte Paper Wooden Framed Poster'
-%}
<section class="pst page-width" data-pst>
  <div class="pst__grid">
    <div class="pst__stage">
      <div class="pst__wall">
        <div class="pst__frame" data-pst-frame data-kind="none">
          <canvas class="pst__canvas" data-pst-canvas width="600" height="800" aria-label="Vista previa de tu póster"></canvas>
        </div>
      </div>
      <p class="pst__note">Vista previa. Se imprime así, en alta calidad, al tamaño que elijas.</p>
    </div>

    <div class="pst__panel">
      <p class="pst__eyebrow">ARSNOIR · Crea tu póster</p>
      <h1 class="pst__title">{{ product.title }}</h1>
      <p class="pst__price"><span data-pst-price>{{ product.price_min | money }}</span> <small data-pst-from>desde</small></p>
      <p class="pst__vat">IVA incluido · Envío 4,95 €, gratis desde 80 €.</p>

      <p class="pst__step"><b>1</b> Elige el diseño</p>
      <div class="pst__designs" role="radiogroup" aria-label="Diseño">
        <button type="button" class="pst__design is-on" data-design="collage" aria-pressed="true"><span class="pst__dico pst__dico--collage"></span>Collage</button>
        <button type="button" class="pst__design" data-design="cancion" aria-pressed="false"><span class="pst__dico pst__dico--cancion"></span>Canción</button>
        <button type="button" class="pst__design" data-design="tipo" aria-pressed="false"><span class="pst__dico pst__dico--tipo"></span>Tipográfico</button>
        <button type="button" class="pst__design" data-design="revista" aria-pressed="false"><span class="pst__dico pst__dico--revista"></span>Revista</button>
        <button type="button" class="pst__design" data-design="fotomaton" aria-pressed="false"><span class="pst__dico pst__dico--fotomaton"></span>Fotomatón</button>
        <button type="button" class="pst__design" data-design="mapa" aria-pressed="false"><span class="pst__dico pst__dico--mapa"></span>Mapa</button>
        <button type="button" class="pst__design" data-design="estrellas" aria-pressed="false"><span class="pst__dico pst__dico--estrellas"></span>Estrellas</button>
      </div>

      <p class="pst__step"><b>2</b> Tus fotos y tus textos</p>
      <div class="pst__fields">
        <div class="pst__f" data-for="collage cancion revista fotomaton">
          <label class="pst__upload" for="PstPhotos">
            <input id="PstPhotos" type="file" accept="image/jpeg,image/png,image/webp" multiple data-pst-photos>
            <span class="pst__upload-plus" aria-hidden="true">+</span>
            <span><b data-pst-uptxt>Sube tus fotos</b><small data-pst-uphint>De 2 a 6 fotos</small></span>
          </label>
          <div class="pst__thumbs" data-pst-thumbs></div>
        </div>
        <div class="pst__f" data-for="collage"><label for="PstCT">Título</label><input id="PstCT" data-k="c_title" maxlength="28" value="Nuestra familia"></div>
        <div class="pst__f" data-for="collage"><label for="PstCS">Subtítulo</label><input id="PstCS" data-k="c_sub" maxlength="32" value="Navidad · 2026"></div>
        <div class="pst__f" data-for="cancion"><label for="PstST">Canción</label><input id="PstST" data-k="s_title" maxlength="30" value="Nuestra canción"></div>
        <div class="pst__f" data-for="cancion"><label for="PstSA">Artista o vuestros nombres</label><input id="PstSA" data-k="s_artist" maxlength="34" value="Álex & Sara · desde 2023"></div>
        <div class="pst__f pst__f--row" data-for="cancion"><span class="pst__lbl">Fondo</span>
          <label class="pst__chip"><input type="radio" name="pst_s_bg" data-k="s_bg" value="Negro" checked><span>Negro</span></label>
          <label class="pst__chip"><input type="radio" name="pst_s_bg" data-k="s_bg" value="Crema"><span>Crema</span></label>
        </div>
        <div class="pst__f" data-for="tipo"><label for="PstT1">Primer nombre</label><input id="PstT1" data-k="t_n1" maxlength="16" value="Álex"></div>
        <div class="pst__f" data-for="tipo"><label for="PstT2">Segundo nombre</label><input id="PstT2" data-k="t_n2" maxlength="16" value="Sara"></div>
        <div class="pst__f" data-for="tipo"><label for="PstTD">Fecha</label><input id="PstTD" data-k="t_date" maxlength="20" value="14 · 02 · 2023"></div>
        <div class="pst__f" data-for="tipo"><label for="PstTQ">Frase</label><input id="PstTQ" data-k="t_quote" maxlength="70" value="Contigo, todos los días son domingo."></div>
        <div class="pst__f pst__f--row" data-for="tipo"><span class="pst__lbl">Colores</span>
          <label class="pst__chip"><input type="radio" name="pst_t_th" data-k="t_theme" value="Crema" checked><span>Crema</span></label>
          <label class="pst__chip"><input type="radio" name="pst_t_th" data-k="t_theme" value="Granate"><span>Granate</span></label>
          <label class="pst__chip"><input type="radio" name="pst_t_th" data-k="t_theme" value="Negro"><span>Negro</span></label>
          <label class="pst__chip"><input type="radio" name="pst_t_th" data-k="t_theme" value="Salvia"><span>Salvia</span></label>
        </div>
        <div class="pst__f" data-for="revista"><label for="PstMM">Nombre de la revista</label><input id="PstMM" data-k="m_mast" maxlength="10" value="ARSNOIR"></div>
        <div class="pst__f" data-for="revista"><label for="PstMH">Titular (usa / para partir la línea)</label><input id="PstMH" data-k="m_head" maxlength="30" value="Familia/del año"></div>
        <div class="pst__f" data-for="revista"><label for="PstMS">Frases del lado (separa con /)</label><input id="PstMS" data-k="m_side" maxlength="80" value="El año de Lía/Primeras palabras, primeros pasos/Especial Navidad"></div>
        <div class="pst__f" data-for="revista"><label for="PstMD">Fecha</label><input id="PstMD" data-k="m_date" maxlength="14" value="DIC 2026"></div>
        <div class="pst__f" data-for="fotomaton"><label for="PstF1">Texto de la tira</label><input id="PstF1" data-k="f_cap" maxlength="22" value="A&S · 14.02.26"></div>
        <div class="pst__f" data-for="fotomaton"><label for="PstF2">Frase a mano</label><input id="PstF2" data-k="f_hand" maxlength="28" value="nuestros momentos"></div>
        <div class="pst__f" data-for="mapa estrellas"><label for="PstPlace">Lugar (ciudad, calle o sitio)</label>
          <div class="pst__geo"><input id="PstPlace" data-k="p_place" maxlength="80" value="Madrid" autocomplete="off"><button type="button" class="pst__geo-btn" data-pst-geo>Buscar</button></div>
          <p class="pst__status" data-pst-status aria-live="polite"></p>
        </div>
        <div class="pst__f" data-for="mapa"><label for="PstMT">Título</label><input id="PstMT" data-k="map_title" maxlength="18" value="MADRID"></div>
        <div class="pst__f" data-for="mapa"><label for="PstMSub">Frase</label><input id="PstMSub" data-k="map_sub" maxlength="34" value="Donde nos conocimos"></div>
        <div class="pst__f pst__f--row" data-for="mapa"><span class="pst__lbl">Colores</span>
          <label class="pst__chip"><input type="radio" name="pst_map_th" data-k="map_theme" value="Claro" checked><span>Claro</span></label>
          <label class="pst__chip"><input type="radio" name="pst_map_th" data-k="map_theme" value="Oscuro"><span>Oscuro</span></label>
          <label class="pst__chip"><input type="radio" name="pst_map_th" data-k="map_theme" value="Granate"><span>Granate</span></label>
        </div>
        <div class="pst__f pst__f--two" data-for="estrellas">
          <div><label for="PstSD">Fecha</label><input id="PstSD" type="date" data-k="sky_date" value="2024-03-24"></div>
          <div><label for="PstSH">Hora</label><input id="PstSH" type="time" data-k="sky_time" value="23:41"></div>
        </div>
        <div class="pst__f" data-for="estrellas"><label for="PstSkT">Título</label><input id="PstSkT" data-k="sky_title" maxlength="30" value="La noche que naciste"></div>
      </div>

      <p class="pst__step"><b>3</b> Tamaño y marco</p>
      <div class="pst__types">
        <button type="button" class="pst__type" data-type="poster" aria-pressed="false">Póster<small>sin marco</small></button>
        <button type="button" class="pst__type is-on" data-type="framed" aria-pressed="true">Con marco<small>listo para colgar</small></button>
      </div>
      <div class="pst__f pst__f--row" data-pst-frames><span class="pst__lbl">Marco</span>
        <label class="pst__chip"><input type="radio" name="pst_frame" value="Black frame" checked><span><i class="pst__sw pst__sw--black"></i>Negro</span></label>
        <label class="pst__chip"><input type="radio" name="pst_frame" value="White frame"><span><i class="pst__sw pst__sw--white"></i>Blanco</span></label>
        <label class="pst__chip"><input type="radio" name="pst_frame" value="Wood frame"><span><i class="pst__sw pst__sw--wood"></i>Madera</span></label>
      </div>
      <select class="pst__size" data-pst-size aria-label="Tamaño"></select>

      {%- form 'product', product, class: 'pst__form', data-pst-form: '', enctype: 'multipart/form-data' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-pst-variant>
        <input type="hidden" name="quantity" value="1">
        <input type="hidden" name="properties[Diseño]" data-pst-prop-design>
        <input type="hidden" name="properties[Textos]" data-pst-prop-texts>
        <input type="hidden" name="properties[Fotos subidas]" data-pst-prop-count>
        <input type="file" name="properties[Archivo para imprimir]" hidden tabindex="-1" aria-hidden="true" data-pst-file>
        <button type="submit" class="pst__add" data-pst-add>Añadir al carrito</button>
        <p class="pst__err" data-pst-err hidden></p>
      {%- endform -%}
      <ul class="pst__trust">
        <li>Impreso en Europa en papel mate de 200 g/m²</li>
        <li>Lo ves tal cual antes de pagar</li>
        <li>Envío con seguimiento · 4-10 días hábiles</li>
      </ul>
    </div>
  </div>
  <script type="application/json" data-pst-variants>
    [{%- for v in posters -%}{"id":{{ v.id }},"size":{{ v.option1 | json }},"type":"poster","frame":"-","price":{{ v.price }},"available":{{ v.available }}},{%- endfor -%}{%- for v in framed -%}{"id":{{ v.id }},"size":{{ v.option1 | json }},"type":"framed","frame":{{ v.option3 | json }},"price":{{ v.price }},"available":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  </script>
</section>

<script>
(function () {
  var root = document.querySelector('[data-pst]');
  if (!root || root.dataset.ready) return; root.dataset.ready = '1';
  var $ = function (s) { return root.querySelector(s); };
  var VARS = JSON.parse(($('[data-pst-variants]').textContent || '[]').replace(/,\s*]$/, ']'));
  var money = function (c) { return new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(c / 100); };
  var canvas = $('[data-pst-canvas]'), ctx = canvas.getContext('2d');
  var S = { design: 'collage', type: 'framed', frame: 'Black frame', size: '', photos: [] };
  /* ---------- sizes ---------- */
  function dims(label) {
    var a = /A(\d)/.exec(label); var A = { 1: [59.4, 84.1], 2: [42, 59.4], 3: [29.7, 42], 4: [21, 29.7] };
    var m = /(\d+(?:\.\d+)?)\s*x\s*(\d+(?:\.\d+)?)/.exec(label);
    if (/^A\d/.test(label) && a) return A[a[1]];
    return m ? [parseFloat(m[1]), parseFloat(m[2])] : [30, 40];
  }
  function niceSize(label) { var d = dims(label); return (/^A\d/.test(label) ? label.slice(0, 2) + ' · ' : '') + String(d[0]).replace('.', ',') + '×' + String(d[1]).replace('.', ',') + ' cm'; }
  function current() { return VARS.find(function (v) { return v.size === S.size && v.type === S.type && (S.type === 'poster' || v.frame === S.frame); }); }
  function fillSizes() {
    var sel = $('[data-pst-size]'), seen = {}, list = VARS.filter(function (v) { return v.type === S.type && (S.type === 'poster' || v.frame === S.frame); });
    list.sort(function (a, b) { var x = dims(a.size), y = dims(b.size); return x[0] * x[1] - y[0] * y[1]; });
    sel.innerHTML = '';
    list.forEach(function (v) { if (seen[v.size]) return; seen[v.size] = 1; var o = document.createElement('option'); o.value = v.size; o.textContent = niceSize(v.size) + ' — ' + money(v.price); sel.appendChild(o); });
    if (!seen[S.size]) { var pick = list.find(function (v) { return /30x40/.test(v.size); }) || list[0]; S.size = pick ? pick.size : ''; }
    sel.value = S.size;
  }
  function syncVariant() {
    var v = current();
    $('[data-pst-frames]').hidden = S.type !== 'framed';
    var fr = $('[data-pst-frame]'); fr.dataset.kind = S.type === 'framed' ? ({ 'Black frame': 'black', 'White frame': 'white', 'Wood frame': 'wood' }[S.frame] || 'black') : 'none';
    if (v) { $('[data-pst-variant]').value = v.id; $('[data-pst-price]').textContent = money(v.price); $('[data-pst-from]').hidden = true; $('[data-pst-add]').textContent = 'Añadir al carrito · ' + money(v.price); }
    draw();
  }
  /* ---------- texts ---------- */
  function val(k) { var el = root.querySelector('[data-k="' + k + '"]:checked') || root.querySelector('input[data-k="' + k + '"]:not([type=radio])'); return el ? el.value.trim() : ''; }
  /* ---------- photos ---------- */
  var MAXP = { collage: 6, cancion: 1, revista: 1, fotomaton: 8 };
  var MINP = { collage: 2, cancion: 1, revista: 1, fotomaton: 4 };
  var DEMO = [{{ 'arsnoir-regalo-foto-familia.jpg' | file_img_url: '1200x' | json }}, {{ 'arsnoir-salon-familia-navidad.jpg' | file_img_url: '1200x' | json }}, {{ 'arsnoir-regalo-retrato-comic.jpg' | file_img_url: '1200x' | json }}];
  var demoImgs = [];
  DEMO.forEach(function (u) { var i = new Image(); i.crossOrigin = 'anonymous'; i.onload = draw; i.src = u; demoImgs.push(i); });
  function photos() { var p = S.photos.length ? S.photos : demoImgs.filter(function (i) { return i.complete && i.naturalWidth; }); return p; }
  function loadFile(f) {
    return new Promise(function (res) {
      var url = URL.createObjectURL(f), img = new Image();
      img.onload = function () {
        var k = Math.min(1, 2600 / Math.max(img.naturalWidth, img.naturalHeight));
        if (k >= 1) return res(img);
        var c = document.createElement('canvas'); c.width = Math.round(img.naturalWidth * k); c.height = Math.round(img.naturalHeight * k);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height); URL.revokeObjectURL(url); res(c);
      };
      img.onerror = function () { res(null); };
      img.src = url;
    });
  }
  $('[data-pst-photos]').addEventListener('change', function (e) {
    var files = Array.prototype.slice.call(e.target.files || []).slice(0, 8);
    Promise.all(files.map(loadFile)).then(function (list) {
      S.photos = S.photos.concat(list.filter(Boolean)).slice(-8);
      thumbs(); draw();
    });
    e.target.value = '';
  });
  function thumbs() {
    var box = $('[data-pst-thumbs]'); box.innerHTML = '';
    S.photos.forEach(function (p, i) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'pst__thumb'; b.setAttribute('aria-label', 'Quitar foto ' + (i + 1));
      var c = document.createElement('canvas'); c.width = 120; c.height = 120; cover(c.getContext('2d'), p, 0, 0, 120, 120); b.appendChild(c);
      b.addEventListener('click', function () { S.photos.splice(i, 1); thumbs(); draw(); });
      box.appendChild(b);
    });
    $('[data-pst-uptxt]').textContent = S.photos.length ? 'Añadir más fotos' : 'Sube tus fotos';
  }
  /* ---------- drawing helpers ---------- */
  function W0(img) { return img.naturalWidth || img.width; } function H0(img) { return img.naturalHeight || img.height; }
  /* cover crop; fy = vertical focus (faces sit in the upper part of most photos) */
  function cover(c, img, x, y, w, h, fy, zoom) {
    if (!img) { c.fillStyle = '#d9d4cb'; c.fillRect(x, y, w, h); return; }
    fy = fy == null ? 0.32 : fy; zoom = zoom || 1;
    var iw = W0(img), ih = H0(img), s = Math.max(w / iw, h / ih) * zoom, sw = w / s, sh = h / s;
    var sx = (iw - sw) / 2, sy = Math.max(0, Math.min(ih - sh, ih * fy - sh / 2));
    c.drawImage(img, sx, sy, sw, sh, x, y, w, h);
  }
  function txt(c, t, x, y, font, color, align, ls) {
    c.font = font; c.fillStyle = color; c.textAlign = align || 'center'; c.textBaseline = 'alphabetic';
    if ('letterSpacing' in c) c.letterSpacing = (ls || 0) + 'px';
    c.fillText(t, x, y);
    if ('letterSpacing' in c) c.letterSpacing = '0px';
  }
  function fit(c, t, font, max, size) { var s = size; do { c.font = font.replace('#', s); if (c.measureText(t).width <= max) break; s *= 0.94; } while (s > 6); return font.replace('#', s); }
  function wrap(c, t, max) { var w = t.split(' '), lines = [], l = ''; w.forEach(function (x) { var tt = l ? l + ' ' + x : x; if (c.measureText(tt).width > max && l) { lines.push(l); l = x; } else l = tt; }); if (l) lines.push(l); return lines; }
  /* black-and-white copy of a photo (cached), for the photo booth */
  var BW = new WeakMap();
  function bw(img) { if (!img) return img; if (BW.has(img)) return BW.get(img); var c2 = document.createElement('canvas'); c2.width = W0(img); c2.height = H0(img); var x = c2.getContext('2d'); x.drawImage(img, 0, 0); try { gray(x, 0, 0, c2.width, c2.height); } catch (e) { return img; } BW.set(img, c2); return c2; }
  function hash(s) { var h = 7; for (var i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 2147483647; return h || 1; }
  function gray(c, x, y, w, h) { var d = c.getImageData(x, y, w, h), p = d.data; for (var i = 0; i < p.length; i += 4) { var g = 0.3 * p[i] + 0.59 * p[i + 1] + 0.11 * p[i + 2]; g = Math.max(0, Math.min(255, (g - 128) * 1.15 + 132)); p[i] = p[i + 1] = p[i + 2] = g; } c.putImageData(d, x, y); }
  /* ---------- designs ---------- */
  var D = {};
  D.collage = function (c, W, H) {
    var P = photos(), n = Math.max(2, Math.min(6, P.length || 3)), m = W * 0.07, g = W * 0.022, top = m, aw = W - 2 * m, ah = H * 0.76 - m;
    c.fillStyle = '#fbfaf7'; c.fillRect(0, 0, W, H);
    var cells = [];
    if (n === 2) cells = [[0, 0, 1, .5], [0, .5, 1, .5]];
    else if (n === 3) cells = [[0, 0, 1, .58], [0, .58, .5, .42], [.5, .58, .5, .42]];
    else if (n === 4) cells = [[0, 0, .5, .5], [.5, 0, .5, .5], [0, .5, .5, .5], [.5, .5, .5, .5]];
    else if (n === 5) cells = [[0, 0, 1, .5], [0, .5, .5, .25], [.5, .5, .5, .25], [0, .75, .5, .25], [.5, .75, .5, .25]];
    else cells = [[0, 0, .5, 1 / 3], [.5, 0, .5, 1 / 3], [0, 1 / 3, .5, 1 / 3], [.5, 1 / 3, .5, 1 / 3], [0, 2 / 3, .5, 1 / 3], [.5, 2 / 3, .5, 1 / 3]];
    cells.forEach(function (q, i) { var l = q[0] > 0.001, r = q[0] + q[2] < 0.999, t = q[1] > 0.001, b2 = q[1] + q[3] < 0.999; var x = m + q[0] * aw + (l ? g / 2 : 0), y = top + q[1] * ah + (t ? g / 2 : 0), w = q[2] * aw - (l ? g / 2 : 0) - (r ? g / 2 : 0), h = q[3] * ah - (t ? g / 2 : 0) - (b2 ? g / 2 : 0); cover(c, P[i % (P.length || 1)], x, y, w, h); });
    var t = val('c_title').toUpperCase(), s = val('c_sub').toUpperCase();
    txt(c, t, W / 2, H * 0.87, fit(c, t, '400 #px "Playfair Display"', aw, W * 0.062), '#141414', 'center', W * 0.008);
    txt(c, s, W / 2, H * 0.915, '400 ' + W * 0.022 + 'px Inter', '#8a8278', 'center', W * 0.012);
  };
  D.cancion = function (c, W, H) {
    var dark = val('s_bg') !== 'Crema', bg = dark ? '#111' : '#f3eee6', fg = dark ? '#fff' : '#141414', mu = dark ? '#a3a3a3' : '#6b655d', P = photos();
    c.fillStyle = bg; c.fillRect(0, 0, W, H);
    var m = W * 0.08, pw = W - 2 * m, ph = Math.min(pw, H * 0.5);
    c.save(); c.beginPath(); if (c.roundRect) c.roundRect(m, m, pw, ph, W * 0.012); else c.rect(m, m, pw, ph); c.clip(); cover(c, P[0], m, m, pw, ph, 0.08 + 0.2); c.restore();
