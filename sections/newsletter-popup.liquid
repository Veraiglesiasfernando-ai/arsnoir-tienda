{%- comment -%}
  Glass pop-up: email sign-up for new works, limited editions and offers first.
  Opens after a delay or on exit intent, once every N days. An optional discount
  code (empty by default) is shown and applied after signing up.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- if s.enabled -%}
<div class="npop" data-npop data-delay="{{ s.delay }}" data-days="{{ s.days }}" data-min-pages="{{ s.min_pages }}" data-code="{{ s.code | escape }}"{% if request.design_mode and s.preview %} data-preview{% endif %} hidden>
  <div class="npop__backdrop" data-npop-close></div>
  <div class="npop__card{% if s.image != blank %} npop__card--image{% endif %}" role="dialog" aria-modal="true" aria-labelledby="NpopTitle">
    {%- if s.image != blank -%}
      <div class="npop__media">{{ s.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '320px', alt: '' }}</div>
    {%- endif -%}
    <div class="npop__body">
      <button type="button" class="npop__close" aria-label="{{ 'general.close' | t }}" data-npop-close>{% render 'icon', name: 'close' %}</button>
      {%- form 'customer', id: 'NewsletterPopup', class: 'npop__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,popup">
        {%- if form.posted_successfully? -%}
          <div class="npop__done" data-npop-success>
            <p class="npop__eyebrow">{{ s.eyebrow }}</p>
            <p class="npop__title" id="NpopTitle">{{ s.success_heading }}</p>
            <p class="npop__text">{{ s.success_text }}</p>
            {%- if s.code != blank -%}
              <button type="button" class="npop__code" data-copy="{{ s.code | escape }}">
                <span>{{ s.code }}</span><small data-copy-label>{{ 'general.copy' | t }}</small>
              </button>
            {%- endif -%}
            <a class="button button--accent button--full" href="{{ routes.all_products_collection_url }}">{{ 'general.see_works' | t }}</a>
          </div>
        {%- else -%}
          <p class="npop__eyebrow">{{ s.eyebrow }}</p>
          <p class="npop__title" id="NpopTitle">{{ s.heading }}</p>
          <p class="npop__text">{{ s.text }}</p>
          {%- if form.errors -%}<p class="npop__error">{{ form.errors | default_errors }}</p>{%- endif -%}
          <label class="visually-hidden" for="NpopEmail">{{ 'general.email' | t }}</label>
          <input class="npop__field" id="NpopEmail" type="email" name="contact[email]" placeholder="{{ 'general.your_email' | t }}" autocomplete="email" required>
          <button class="button button--accent button--full" type="submit">{{ s.button_label }}</button>
          <button type="button" class="npop__skip" data-npop-close>{{ s.dismiss_label }}</button>
          {%- if s.legal != blank -%}<p class="npop__legal">{{ s.legal }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Pop-up de novedades",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Activar", "default": true },
    { "type": "checkbox", "id": "preview", "label": "Mostrar siempre en el editor", "default": false },
    { "type": "range", "id": "min_pages", "label": "Aparece a partir de la página nº", "min": 1, "max": 5, "step": 1, "default": 2, "info": "Solo a quien ya está mirando obras. En ordenador también aparece si alguien va a salir de la web." },
    { "type": "range", "id": "delay", "label": "Segundos en esa página antes de aparecer", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 6 },
    { "type": "range", "id": "days", "label": "No volver a mostrar durante", "min": 1, "max": 60, "step": 1, "unit": "d", "default": 14 },
    { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "ÚNETE A ARSNOIR" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Sé el primero en enterarte" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Obras nuevas, ediciones limitadas y ofertas antes que nadie. Arte que no verás en ningún otro sitio." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Quiero enterarme" },
    { "type": "text", "id": "dismiss_label", "label": "Texto para cerrar", "default": "Ahora no" },
    { "type": "text", "id": "legal", "label": "Texto legal", "default": "Puedes darte de baja cuando quieras." },
    { "type": "header", "content": "Después de suscribirse" },
    { "type": "text", "id": "success_heading", "label": "Título", "default": "Ya estás dentro." },
    { "type": "text", "id": "success_text", "label": "Texto", "default": "Te avisaremos antes que a nadie cuando salga algo nuevo." },
    { "type": "text", "id": "code", "label": "Código de descuento (opcional)", "info": "Vacío = sin descuento. Si lo rellenas, debe existir en Shopify → Descuentos, y se enseña y aplica al suscribirse." }
  ]
}
{% endschema %}
