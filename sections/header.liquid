{%- liquid
  assign s = section.settings
  assign link_1_url = s.link_1_url | default: routes.all_products_collection_url
  assign link_2_url = s.link_2_url | default: '/pages/manifiesto'
  assign mobile_menu = linklists[s.mobile_menu]
-%}

<div class="glass-header-wrap">
  <header class="glass-header">
    <nav class="glass-header__nav" aria-label="Principal">
      <details class="mobile-menu">
        <summary aria-label="Menú">{% render 'icon', name: 'menu' %}</summary>
        <div class="mobile-menu__panel">
          <ul>
            {%- if mobile_menu.links.size > 0 -%}
              {%- for link in mobile_menu.links -%}
                <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- if s.link_1_label != blank -%}<li><a href="{{ link_1_url }}">{{ s.link_1_label }}</a></li>{%- endif -%}
              {%- if s.link_2_label != blank -%}<li><a href="{{ link_2_url }}">{{ s.link_2_label }}</a></li>{%- endif -%}
            {%- endif -%}
            <li><a href="{{ routes.search_url }}">Buscar</a></li>
          </ul>
        </div>
      </details>
      <ul class="glass-header__links">
        {%- if s.link_1_label != blank -%}<li><a href="{{ link_1_url }}">{{ s.link_1_label }}</a></li>{%- endif -%}
        {%- if s.link_2_label != blank -%}<li><a href="{{ link_2_url }}">{{ s.link_2_label }}</a></li>{%- endif -%}
      </ul>
    </nav>

    <a class="glass-header__logo" href="{{ routes.root_url }}">
      {%- if s.logo != blank -%}
        {%- assign logo_style = 'width:' | append: s.logo_width | append: 'px;height:auto;' -%}
        {{ s.logo | image_url: width: 600 | image_tag: style: logo_style, alt: shop.name }}
      {%- else -%}
        {{ s.logo_text | default: shop.name | strip }}
      {%- endif -%}
    </a>

    <div class="glass-header__icons">
      <a href="{{ routes.search_url }}" aria-label="Buscar">{% render 'icon', name: 'search' %}</a>
      <a href="{{ routes.cart_url }}" class="glass-header__cart" aria-label="Carrito, {{ cart.item_count }} artículos">
        {% render 'icon', name: 'bag' %}
        {%- if cart.item_count > 0 -%}<span class="cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </header>
</div>

{% schema %}
{
  "name": "Cabecera",
  "class": "header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo (texto)", "default": "ARSNOIR" },
    { "type": "image_picker", "id": "logo", "label": "Logo (imagen)", "info": "Opcional. Si subes una imagen, sustituye al texto." },
    { "type": "range", "id": "logo_width", "label": "Ancho del logo", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "header", "content": "Enlaces" },
    { "type": "text", "id": "link_1_label", "label": "Enlace 1", "default": "OBRAS" },
    { "type": "url", "id": "link_1_url", "label": "Destino enlace 1" },
    { "type": "text", "id": "link_2_label", "label": "Enlace 2", "default": "MANIFIESTO" },
    { "type": "url", "id": "link_2_url", "label": "Destino enlace 2" },
    { "type": "link_list", "id": "mobile_menu", "label": "Menú del móvil", "default": "main-menu", "info": "Lista completa de enlaces que se ve al abrir el menú en el móvil." }
  ]
}
{% endschema %}
