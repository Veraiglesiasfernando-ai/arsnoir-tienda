{%- liquid
  assign s = section.settings
  assign menu = linklists[s.menu]
-%}

<div class="glass-header-wrap">
  <header class="glass-header">
    <div class="glass-header__start">
      <details class="mobile-menu">
        <summary aria-label="Menú">{% render 'icon', name: 'menu' %}</summary>
        <div class="mobile-menu__panel">
          <ul>
            {%- for link in menu.links -%}
              <li>
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
                {%- if link.links.size > 0 -%}
                  <ul class="mobile-menu__sub">
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
            <li><a href="{{ routes.search_url }}" data-search-open>Buscar</a></li>
            <li><a href="{{ s.favorites_page.url | default: '/pages/favoritos' }}">Favoritos</a></li>
            {%- if shop.customer_accounts_enabled -%}
              <li><a href="{{ routes.account_url }}">{% if customer %}Mi cuenta{% else %}Iniciar sesión{% endif %}</a></li>
            {%- endif -%}
          </ul>
        </div>
      </details>

      <a class="glass-header__logo" href="{{ routes.root_url }}">
        {%- if s.logo != blank -%}
          {%- assign logo_style = 'width:' | append: s.logo_width | append: 'px;height:auto;' -%}
          {{ s.logo | image_url: width: 600 | image_tag: style: logo_style, alt: shop.name }}
        {%- else -%}
          {{ s.logo_text | default: shop.name | strip }}
        {%- endif -%}
      </a>
    </div>

    <nav class="glass-header__nav" aria-label="Menú principal">
      <ul class="glass-header__links">
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <li class="nav-drop">
              <a href="{{ link.url }}" class="nav-drop__toggle" aria-haspopup="true"{% if link.current or link.child_active %} aria-current="page"{% endif %}>
                {{- link.title -}}
                <svg class="nav-drop__caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              </a>
              <div class="nav-drop__panel{% if link.links.size > 5 %} nav-drop__panel--cols{% endif %}">
                <ul>
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
                <a class="nav-drop__all" href="{{ link.url }}">Ver todo &rarr;</a>
              </div>
            </li>
          {%- else -%}
            <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="glass-header__icons">
      <a href="{{ routes.search_url }}" class="glass-header__search" aria-label="Buscar" data-search-open>{% render 'icon', name: 'search' %}</a>
      {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
        {% render 'localization', id: 'HeaderLocalization' %}
      {%- endif -%}
      <a href="{{ s.favorites_page.url | default: '/pages/favoritos' }}" class="glass-header__fav" aria-label="Favoritos">
        {% render 'icon', name: 'heart' %}<span class="fav-count" data-fav-count hidden></span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="glass-header__account" aria-label="{% if customer %}Mi cuenta{% else %}Iniciar sesión{% endif %}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="glass-header__cart" aria-label="Carrito, {{ cart.item_count }} artículos">
        {% render 'icon', name: 'bag' %}
        {%- if cart.item_count > 0 -%}<span class="cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </header>
</div>

{%- liquid
  assign popular = s.popular_searches | split: ','
-%}
<div class="search-overlay" data-search-overlay data-suggest-url="{{ routes.predictive_search_url }}" hidden>
  <div class="search-overlay__backdrop" data-search-close></div>
  <div class="search-overlay__panel" role="dialog" aria-modal="true" aria-label="Buscar">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form">
      <input type="hidden" name="type" value="product">
      {% render 'icon', name: 'search' %}
      <label for="SearchOverlay" class="visually-hidden">Buscar</label>
      <input id="SearchOverlay" type="search" name="q" placeholder="{{ s.search_placeholder | escape }}" autocomplete="off" data-search-input>
      <button type="button" class="search-overlay__close" aria-label="Cerrar" data-search-close>{% render 'icon', name: 'close' %}</button>
    </form>
    <div class="search-overlay__body">
      <div class="search-overlay__popular" data-search-popular>
        {%- if popular.size > 0 and s.popular_searches != blank -%}
          <p class="search-overlay__label">Búsquedas populares</p>
          <ul class="search-chips">
            {%- for term in popular -%}
              {%- assign t = term | strip -%}
              {%- if t != blank -%}
                <li><a href="{{ routes.search_url }}?type=product&q={{ t | url_encode }}">{{ t }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div class="search-overlay__results" data-search-results aria-live="polite"></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cabecera",
  "class": "header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo (texto)", "default": "arsnoir" },
    { "type": "image_picker", "id": "logo", "label": "Logo (imagen)", "info": "Opcional. Si subes una imagen, sustituye al texto." },
    { "type": "range", "id": "logo_width", "label": "Ancho del logo", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu", "info": "Se muestra en el centro en escritorio y en el menú hamburguesa en móvil. Los elementos con subelementos se abren como desplegable de cristal." },
    { "type": "page", "id": "favorites_page", "label": "Página de favoritos", "info": "Página con la plantilla «page.favoritos». Por defecto, /pages/favoritos." },
    { "type": "header", "content": "Buscador" },
    { "type": "text", "id": "search_placeholder", "label": "Texto del buscador", "default": "Busca una obra, un estilo, un color…" },
    { "type": "text", "id": "popular_searches", "label": "Búsquedas populares", "default": "Motor, Urban, Abstract, Minimalista, Blanco y negro, Salón", "info": "Separadas por comas. Se muestran al abrir el buscador." }
  ]
}
{% endschema %}
