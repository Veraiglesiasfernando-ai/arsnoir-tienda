{%- liquid
  assign s = section.settings
  assign ig_url = s.url | default: settings.social_instagram
-%}
<section class="section community">
  <div class="page-width">
    <div class="featured__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="featured__title">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<p class="featured__subtitle">{{ s.text }}</p>{%- endif -%}
      </div>
      {%- if ig_url != blank -%}
        <a class="button" href="{{ ig_url }}" target="_blank" rel="noopener">{% render 'trust-icon', name: 'instagram' %}<span>{{ s.handle }}</span></a>
      {%- endif -%}
    </div>
    <ul class="community__grid">
      {%- for block in section.blocks -%}
        <li class="community__tile" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank or ig_url != blank -%}<a href="{{ block.settings.link | default: ig_url }}" target="_blank" rel="noopener">{%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 900px) 16vw, 33vw' }}
          {%- else -%}
            <span class="community__ph" aria-hidden="true">{% render 'trust-icon', name: 'instagram' %}</span>
          {%- endif -%}
          {%- if block.settings.link != blank or ig_url != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Instagram / comunidad",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "COMUNIDAD" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu pared, en nuestro feed" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Cuelga tu obra, hazle una foto y etiquétanos con #ARSNOIR." },
    { "type": "text", "id": "handle", "label": "Usuario", "default": "@arsnoir" },
    { "type": "url", "id": "url", "label": "Enlace a Instagram", "info": "Si lo dejas vacío se usa el de Configuración del tema → Redes sociales." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Foto",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Solo fotos tuyas o de clientes que te den permiso." },
        { "type": "url", "id": "link", "label": "Enlace a la publicación" }
      ]
    }
  ],
  "presets": [
    { "name": "Instagram / comunidad", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] }
  ]
}
{% endschema %}
