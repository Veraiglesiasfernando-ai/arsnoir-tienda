<section class="page-width section">
  <span class="eyebrow">Diario</span>
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="collection-grid" style="--cols: 3; margin-top: 48px">
      {%- for article in blog.articles -%}
        <a class="collection-tile" href="{{ article.url }}">
          <div class="collection-tile__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 900px) 33vw, 50vw' }}
            {%- else -%}
              <div class="tile-ph" aria-hidden="true"></div>
            {%- endif -%}
          </div>
          <div class="collection-tile__info">
            <span class="collection-tile__title">{{ article.title }}</span>
            <span class="collection-tile__count">{{ article.published_at | date: '%d.%m.%Y' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Anterior</a>{%- endif -%}
        <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Siguiente &rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
