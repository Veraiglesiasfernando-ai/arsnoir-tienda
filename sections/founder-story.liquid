{%- comment -%}
  Founder story: a big photo on one half (edge to edge) and the story on the other.
  Without a photo the section stays hidden for customers (only the theme editor shows a placeholder).
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign fd_alt = s.alt | default: s.heading -%}
{%- if s.image != blank or request.design_mode -%}
<section class="founder{% if s.reverse %} founder--reverse{% endif %}" style="--fd-bg: {{ s.bg }};">
  <div class="founder__media">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 750px) 50vw, 100vw', alt: fd_alt }}
    {%- else -%}
      <div class="founder__ph">Tu foto aquí</div>
    {%- endif -%}
  </div>
  <div class="founder__copy">
    {%- if s.eyebrow != blank -%}<p class="founder__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="founder__title">{{ s.heading | newline_to_br }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="founder__text">{{ s.text }}</div>{%- endif -%}
    {%- if s.signature != blank -%}<p class="founder__sign">{{ s.signature }}</p>{%- endif -%}
    {%- if s.button_label != blank -%}<a class="button button--outline founder__btn" href="{{ s.button_link | default: '/pages/contacto' }}">{{ s.button_label }}</a>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Mi historia (fundador)",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Tu foto", "info": "Vertical y con buena luz. Sin foto, la sección no se muestra." },
    { "type": "text", "id": "alt", "label": "Descripción de la foto", "default": "Vera, fundador de ARSNOIR" },
    { "type": "checkbox", "id": "reverse", "label": "Foto a la derecha", "default": false },
    { "type": "color", "id": "bg", "label": "Fondo del texto", "default": "#F4F1EC" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "QUIÉN ESTÁ DETRÁS" },
    { "type": "textarea", "id": "heading", "label": "Título", "default": "Hola, soy Vera." },
    { "type": "richtext", "id": "text", "label": "Historia", "default": "<p>Cuenta aquí tu historia.</p>" },
    { "type": "text", "id": "signature", "label": "Firma", "default": "Vera · Fundador de ARSNOIR" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Escríbeme" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Mi historia (fundador)" }]
}
{% endschema %}
