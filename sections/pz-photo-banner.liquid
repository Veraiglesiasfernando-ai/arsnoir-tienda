{%- comment -%}
  Personalízalo: "your photo as it is" — one image and one short pitch, side by side.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign link = s.link | default: '/products/tu-foto-en-un-cuadro' -%}
<section class="pzb">
  <div class="page-width pzb__grid">
    <a class="pzb__media" href="{{ link }}" tabindex="-1" aria-hidden="true">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: '' }}
      {%- endif -%}
    </a>
    <div class="pzb__copy">
      {%- if s.eyebrow != blank -%}<p class="pzb__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="pzb__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="pzb__text">{{ s.text }}</p>{%- endif -%}
      {%- if s.button_label != blank -%}<a class="pzi__btn" href="{{ link }}">{{ s.button_label }} <span aria-hidden="true">→</span></a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Personalízalo · tu foto",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "SIN ILUSTRAR" },
    { "type": "text", "id": "heading", "label": "Título", "default": "¿Prefieres tu foto tal cual?" },
    { "type": "text", "id": "text", "label": "Texto", "default": "La imprimimos en el tamaño y el marco que elijas." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Sube tu foto" },
    { "type": "url", "id": "link", "label": "Enlace", "info": "Vacío = Tu foto en un cuadro." }
  ],
  "presets": [{ "name": "Personalízalo · tu foto" }]
}
{% endschema %}
