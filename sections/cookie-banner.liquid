{%- comment -%}
  Glass cookie banner wired to Shopify's Customer Privacy API, so the visitor's
  choice is the real consent Shopify uses for analytics and marketing.
  Turn off Shopify's own banner (Settings → Customer privacy) to avoid showing two.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="cookie" id="CookieBanner" data-cookie-banner{% if request.design_mode and s.preview %} data-preview{% endif %} hidden role="dialog" aria-live="polite" aria-label="{{ s.title | escape }}">
  <div class="cookie__card">
    {%- comment -%} Closing = rejecting (no analytics or marketing cookies), as the AEPD allows {%- endcomment -%}
    <button type="button" class="cookie__close" data-cookie="reject" aria-label="Cerrar sin aceptar">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8"/></svg>
    </button>
    <p class="cookie__title">{{ s.title }}</p>
    <p class="cookie__text">{{ s.text }}</p>
    {%- comment -%} Second layer: one switch per purpose (AEPD: accept, reject and configure, at the same level) {%- endcomment -%}
    <div class="cookie__prefs" data-cookie-prefs hidden>
      <label class="cookie__pref">
        <span><b>Necesarias</b><small>Carrito, pago y seguridad. Siempre activas.</small></span>
        <input type="checkbox" checked disabled>
      </label>
      <label class="cookie__pref">
        <span><b>Análisis</b><small>Saber qué páginas se visitan para mejorar la tienda.</small></span>
        <input type="checkbox" data-cookie-kind="analytics">
      </label>
      <label class="cookie__pref">
        <span><b>Marketing</b><small>Anuncios que encajen contigo (Meta, Google).</small></span>
        <input type="checkbox" data-cookie-kind="marketing">
      </label>
      <label class="cookie__pref">
        <span><b>Preferencias</b><small>Recordar tus elecciones, como el idioma.</small></span>
        <input type="checkbox" data-cookie-kind="preferences">
      </label>
    </div>
    <div class="cookie__actions">
      <button type="button" class="button button--accent cookie__accept" data-cookie="accept">{{ s.accept_label }}</button>
      <button type="button" class="button button--outline cookie__reject" data-cookie="reject">{{ s.reject_label }}</button>
      <button type="button" class="button button--outline cookie__config" data-cookie="config">{{ s.config_label | default: 'Configurar' }}</button>
      <button type="button" class="button button--accent cookie__save" data-cookie="save" hidden>{{ s.save_label | default: 'Guardar mi elección' }}</button>
    </div>
    {%- if s.policy_label != blank -%}
      <a class="cookie__policy" href="{{ s.policy_link | default: '/policies/privacy-policy' }}">{{ s.policy_label }}</a>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var banner = document.getElementById('CookieBanner');
    if (!banner) return;
    var KEY = 'arsnoir_cookie_choice';

    function show() {
      banner.hidden = false;
      requestAnimationFrame(function () { banner.classList.add('is-visible'); });
    }
    function hide() {
      banner.classList.remove('is-visible');
      setTimeout(function () { banner.hidden = true; }, 400);
    }
    function remember(choice) {
      try { localStorage.setItem(KEY, choice); } catch (e) {}
    }
    function stored() {
      try { return localStorage.getItem(KEY); } catch (e) { return null; }
    }

    if (banner.hasAttribute('data-preview')) { show(); }

    var prefs = banner.querySelector('[data-cookie-prefs]');
    var kinds = banner.querySelectorAll('[data-cookie-kind]');
    function layer(open) {
      prefs.hidden = !open;
      banner.classList.toggle('is-config', open);
      banner.querySelector('[data-cookie="config"]').hidden = open;
      banner.querySelector('[data-cookie="save"]').hidden = !open;
    }
    function apply(c) {
      var privacy = window.Shopify && window.Shopify.customerPrivacy;
      var consent = { analytics: c.analytics, marketing: c.marketing, preferences: c.preferences, sale_of_data: c.marketing };
      if (privacy && privacy.setTrackingConsent) {
        privacy.setTrackingConsent(consent, function () {});
      }
      remember(JSON.stringify(c));
      hide();
    }
    function all(on) { return { analytics: on, marketing: on, preferences: on }; }
    function current() {
      var v = stored();
      if (v === 'accept') return all(true);
      try { var c = JSON.parse(v); if (c && typeof c === 'object') return c; } catch (e) {}
      return all(false);
    }

    banner.addEventListener('click', function (event) {
      var btn = event.target.closest('[data-cookie]');
      if (!btn) return;
      var what = btn.dataset.cookie;
      if (what === 'config') { layer(true); return; }
      if (what === 'save') {
        var c = all(false);
        kinds.forEach(function (k) { c[k.dataset.cookieKind] = k.checked; });
        apply(c);
        return;
      }
      apply(all(what === 'accept'));
    });

    /* «Configurar cookies» (footer, or any link to #cookies): change the choice at any time */
    document.addEventListener('click', function (event) {
      var link = event.target.closest('[data-cookie-open], a[href="#cookies"]');
      if (!link) return;
      event.preventDefault();
      var c = current();
      kinds.forEach(function (k) { k.checked = !!c[k.dataset.cookieKind]; });
      layer(true);
      show();
    });

    /* Shown once: on the visitor's first page. A choice is remembered for good;
       without a choice it is not shown again in the same visit (no choice = no
       analytics/marketing cookies). */
    function seenThisVisit() {
      try { return sessionStorage.getItem(KEY + '_seen') === '1'; } catch (e) { return false; }
    }
    function markSeen() {
      try { sessionStorage.setItem(KEY + '_seen', '1'); } catch (e) {}
    }
    function init() {
      if (banner.hasAttribute('data-preview')) return;
      if (stored() || seenThisVisit()) return;
      var privacy = window.Shopify && window.Shopify.customerPrivacy;
      if (privacy && typeof privacy.shouldShowBanner === 'function' && !privacy.shouldShowBanner()) return;
      markSeen();
      show();
    }

    if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
      window.Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function (error) {
        init();
      });
    } else {
      init();
    }
  })();
</script>

{% schema %}
{
  "name": "Aviso de cookies",
  "settings": [
    { "type": "paragraph", "content": "Usa la API de privacidad de Shopify. Desactiva el aviso de cookies de Shopify en Configuración → Privacidad del cliente para no mostrar dos." },
    { "type": "checkbox", "id": "preview", "label": "Mostrar siempre en el editor (vista previa)", "default": false },
    { "type": "text", "id": "title", "label": "Título", "default": "Usamos cookies" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Usamos cookies propias y de terceros (como Meta y Google) para que la tienda funcione, saber qué se visita y mostrarte anuncios que encajen contigo. Tú decides: acéptalas, recházalas o elige cuáles." },
    { "type": "text", "id": "accept_label", "label": "Botón aceptar", "default": "Aceptar" },
    { "type": "text", "id": "reject_label", "label": "Botón rechazar", "default": "Rechazar" },
    { "type": "text", "id": "config_label", "label": "Botón configurar", "default": "Configurar" },
    { "type": "text", "id": "save_label", "label": "Botón guardar (al configurar)", "default": "Guardar mi elección" },
    { "type": "text", "id": "policy_label", "label": "Texto del enlace", "default": "Política de privacidad y cookies" },
    { "type": "url", "id": "policy_link", "label": "Enlace a la política" }
  ]
}
{% endschema %}
