<section class="page-width section center" style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center">
  <div class="footer__brand" style="margin-bottom:3rem">{{ shop.name | strip | downcase }}</div>
  <h1>{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}

  <div class="newsletter" style="width:100%">
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message" style="width:100%">Te avisaremos cuando abramos.</p>
      {%- else -%}
        <input class="field" type="email" name="contact[email]" placeholder="Tu email" aria-label="Email" required>
        <button class="button" type="submit">Avisarme</button>
      {%- endif -%}
    {%- endform -%}
  </div>

  <details style="margin-top:3rem;font-size:13px">
    <summary class="muted" style="cursor:pointer">Entrar con contraseña</summary>
    {%- form 'storefront_password', class: 'newsletter__form' -%}
      {%- if form.errors -%}<p class="form-message">{{ form.errors | default_errors }}</p>{%- endif -%}
      <input class="field" type="password" name="password" placeholder="Contraseña" aria-label="Contraseña" required>
      <button class="button" type="submit">Entrar</button>
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Página de contraseña",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Muy pronto." }
  ]
}
{% endschema %}
