<article class="page-width section">
  <div class="page-content">
    <span class="eyebrow">{{ article.published_at | date: '%d.%m.%Y' }}</span>
    <h1>{{ article.title }}</h1>
    {%- if article.image -%}
      <div style="margin:32px 0">
        {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 760px) 720px, 100vw' }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p style="margin-top:48px"><a class="link-underline" href="{{ blog.url }}">&larr; Volver</a></p>
  </div>
</article>

{% schema %}
{ "name": "Artículo", "settings": [] }
{% endschema %}
