{%- assign s = section.settings -%}
<section class="join" id="Join">
  <div class="page-width join__inner">
    <div>
      <h2 class="join__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="join__text">{{ s.text }}</p>{%- endif -%}
    </div>
    {%- form 'customer', class: 'join__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="join__ok">{{ s.success }}</p>
      {%- else -%}
        {%- if form.errors -%}<p class="join__error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="visually-hidden" for="Join-{{ section.id }}">{{ 'general.email' | t }}</label>
        <input class="join__field" id="Join-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ 'general.your_email' | t }}" autocomplete="email" required>
        <button class="button button--accent" type="submit">{{ s.button_label }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter (negro)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Únete a ARSNOIR" },
    { "type": "text", "id": "text", "label": "Texto", "default": "10% en tu primera compra y acceso primero a cada obra nueva." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "UNIRME" },
    { "type": "text", "id": "success", "label": "Mensaje al suscribirse", "default": "Ya estás dentro. Revisa tu email." }
  ],
  "presets": [{ "name": "Newsletter (negro)" }]
}
{% endschema %}
