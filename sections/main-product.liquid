{%- liquid
  # Without ?variant= in the link, start on the cheapest size/finish available (not Shopify's first variant)
  assign current_variant = product.selected_or_first_available_variant
  if product.selected_variant == blank
    for v in product.variants
      if v.available and v.price < current_variant.price
        assign current_variant = v
      endif
    endfor
    # Gelato prints: the photos show the black frame, so start on the cheapest black-framed
    # variant here (it used to switch in JS after load, leaving «Desde 24,95 €» next to a framed photo)
    assign framed_found = false
    for v in product.variants
      assign vt = v.title | downcase
      if v.available and vt contains 'framed' and vt contains 'black'
        unless vt contains 'canvas'
          if framed_found == false or v.price < framed_start.price
            assign framed_start = v
            assign framed_found = true
          endif
        endunless
      endif
    endfor
    if framed_found
      assign current_variant = framed_start
    endif
  endif
  assign form_id = 'ProductForm-' | append: section.id
  assign price_id = 'Price-' | append: section.id
-%}

{%- comment -%}
  New page on desktop: thumbnails in a column next to one big photo that fits the screen (portraits with
  the photo studio keep their own gallery, which the studio drives)
{%- endcomment -%}
{%- assign rail = false -%}
{%- if section.settings.pdp_v2 -%}
  {%- assign rail = true -%}
  {%- for sb in section.blocks -%}{%- if sb.type == 'template_studio' -%}{%- assign rail = false -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
<section class="page-width" data-product-handle="{{ product.handle }}">
  <div class="product{% if rail %} product--rail{% endif %}">
    <div class="product__gallery">
      {%- if rail -%}{% render 'fav-button', handle: product.handle, class: 'fav-btn--media' %}{%- endif -%}
      {%- liquid
        # Gelato attaches one near-identical mockup per variant (alt = a UUID, or «…: vista N»). When the product
        # has our own photos ("… con marco negro"), show only ours; otherwise just a few of Gelato's.
        assign own_photos = false
        if product.media.first.alt contains ' con marco '
          assign own_photos = true
        endif
        assign gelato_shown = 0
      -%}
      {%- assign lead = section.settings.lead_image -%}
      {%- if lead != blank -%}
        {%- comment -%} Lead photo first (e.g. the piece as a gift), then the video right under it {%- endcomment -%}
        <div class="product__media product__media--lead">
          {{ lead | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 800, 1100, 1400, 1600', sizes: '(min-width: 900px) 55vw, 90vw', alt: lead.alt | default: product.title }}
        </div>
        {%- if section.settings.gallery_video != blank -%}
        <div class="product__media product__media--video">
          <video data-src="{{ section.settings.gallery_video }}" data-lazy-video muted loop playsinline preload="none"{% if section.settings.gallery_video_poster != blank %} poster="{{ section.settings.gallery_video_poster | image_url: width: 1200 }}"{% endif %} aria-label="{{ 'product.frame_video' | t }}"></video>
        </div>
        {%- endif -%}
      {%- endif -%}
      {%- for media in product.media -%}
        {%- liquid
          assign alt_parts = media.alt | split: '-'
          assign is_gelato = false
          if media.alt.size == 36 and alt_parts.size == 5
            assign is_gelato = true
          endif
          # Same mockups after their alt text was written for Google («…, cuadro de ARSNOIR: vista 3»)
          if media.alt contains 'cuadro de ARSNOIR: vista'
            assign is_gelato = true
          endif
          if is_gelato
            if own_photos
              continue
            endif
            assign gelato_shown = gelato_shown | plus: 1
            if gelato_shown > 6
              continue
            endif
          endif
          assign is_lifestyle = false
          if section.settings.lifestyle_from > 0 and forloop.index >= section.settings.lifestyle_from
            assign is_lifestyle = true
          endif
          assign load = 'lazy'
          if forloop.first
            assign load = 'eager'
          endif
        -%}
        <div class="product__media{% if is_lifestyle %} product__media--lifestyle{% endif %}" data-media-id="{{ media.id }}">
          {%- if media.media_type == 'image' and forloop.first -%}
            {% render 'framed-main', media: media, product: product, load: load %}
          {%- elsif media.media_type == 'image' -%}
            {{ media | image_url: width: 1600 | image_tag:
              loading: load,
              widths: '500, 800, 1100, 1400, 1600',
              sizes: '(min-width: 900px) 55vw, 90vw',
              alt: media.alt | default: product.title
            }}
          {%- else -%}
            {{ media | media_tag: image_size: '1600x' }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="product__media">{% render 'frame-placeholder' %}</div>
      {%- endfor -%}
      {%- if section.settings.gallery_video != blank and lead == blank -%}
        {%- comment -%} Looping "how the frame is made" video under the photos (fills the column on desktop) {%- endcomment -%}
        <div class="product__media product__media--video">
          <video data-src="{{ section.settings.gallery_video }}" data-lazy-video muted loop playsinline preload="none"{% if section.settings.gallery_video_poster != blank %} poster="{{ section.settings.gallery_video_poster | image_url: width: 1200 }}"{% endif %} aria-label="{{ 'product.frame_video' | t }}"></video>
        </div>
      {%- endif -%}
      {%- if section.settings.size_visual -%}{% render 'size-visual', product: product, big: true %}{%- endif -%}
    </div>
    {%- if rail -%}
      <script>
        (function () {
          var g = document.currentScript.previousElementSibling;
          if (!g || g.dataset.rail) return;
          g.dataset.rail = '1';
          var items = Array.prototype.filter.call(g.children, function (m) { return m.classList.contains('product__media'); });
          if (items.length < 2) { if (items[0]) items[0].classList.add('is-shown'); return; }
          var nav = document.createElement('div');
          nav.className = 'prail';
          nav.setAttribute('aria-label', 'Fotos');
          var show = function (i) {
            items.forEach(function (m, k) { m.classList.toggle('is-shown', k === i); });
            nav.querySelectorAll('button').forEach(function (b, k) { b.classList.toggle('is-active', k === i); b.setAttribute('aria-current', k === i ? 'true' : 'false'); });
          };
          items.forEach(function (m, i) {
            var img = m.querySelector('img');
            var vid = m.querySelector('video');
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'prail__thumb';
            b.setAttribute('aria-label', 'Foto ' + (i + 1));
            var src = img ? (img.currentSrc || img.src) : (vid && vid.getAttribute('poster'));
            if (src) { var t = document.createElement('img'); t.src = src; t.alt = ''; t.loading = 'lazy'; b.appendChild(t); }
            else b.classList.add('prail__thumb--play');
            b.addEventListener('click', function () {
              show(i);
              if (vid && vid.dataset.src && !vid.src) { vid.src = vid.dataset.src; }
              if (vid) vid.play && vid.play().catch(function () {});
            });
            nav.appendChild(b);
          });
          g.insertBefore(nav, g.firstChild);
          /* The framed photo (it swaps colour with the frame) only shows once a frame is chosen;
             until then the big photo is the print on its own */
          var thumbs = nav.querySelectorAll('button');
          var fi = -1;
          items.forEach(function (m, i) { if (fi < 0 && m.querySelector('img[data-black]')) fi = i; });
          var KIND = { negro: 'black', blanco: 'white', madera: 'wood' };
          var current = function () { for (var k = 0; k < items.length; k++) if (items[k].classList.contains('is-shown')) return k; return -1; };
          var setFrame = function (frame) {
            if (fi < 0) return;
            var on = !!KIND[frame];
            thumbs[fi].hidden = !on;
            if (on) {
              var img = items[fi].querySelector('img[data-black]');
              var url = KIND[frame] === 'black' ? img.dataset.black : img.dataset[KIND[frame]];
              var note = items[fi].querySelector('.pmedia__note');
              if (note) note.remove();
              if (url && img.getAttribute('src') !== url) {
                img.removeAttribute('srcset');
                img.onerror = function () { img.onerror = null; img.src = img.dataset.black; };
                img.src = url;
              }
              show(fi);
            } else if (current() === fi || current() < 0) {
              show(fi === 0 ? 1 : 0);
            }
          };
          show(0);
          var start = function () {
            var box = document.querySelector('[data-pdc]');
            if (!box) return;
            setFrame(box.dataset.frame || 'sin');
            new MutationObserver(function () { setFrame(box.dataset.frame || 'sin'); }).observe(box, { attributes: true, attributeFilter: ['data-frame'] });
          };
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
        })();
      </script>
    {%- endif -%}

    <div class="product__info">
      {% render 'breadcrumbs' %}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            <div class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</div>

          {%- when 'title' -%}
            {%- if section.settings.brand_line != blank -%}<p class="product__brand">{{ section.settings.brand_line }}</p>{%- endif -%}
            <div class="product__title-row" {{ block.shopify_attributes }}>
              <h1 class="product__title">{{ product.title }}</h1>
              {% render 'fav-button', handle: product.handle, class: 'fav-btn--inline' %}
            </div>
            {%- comment -%} Stars only when a review app has written real ratings to the standard metafields {%- endcomment -%}
            {%- assign p_rating = product.metafields.reviews.rating.value -%}
            {%- liquid
              assign jm_badge = product.metafields.judgeme.badge | append: ''
              assign jm_badge_on = false
              if jm_badge contains 'data-number-of-reviews'
                assign jm_badge_on = true
                if jm_badge contains 'data-number-of-reviews="0"' or jm_badge contains "data-number-of-reviews='0'"
                  assign jm_badge_on = false
                endif
              endif
            -%}
            {%- assign p_count = product.metafields.reviews.rating_count.value | default: 0 -%}
            {%- if p_rating != blank and p_count > 0 -%}
              <a href="#Reviews" class="product__rating">{% render 'stars', rating: p_rating.rating, max: p_rating.scale_max, count: p_count %}</a>
            {%- elsif jm_badge_on -%}
              {%- comment -%} Judge.me's own star badge, only once there is at least one review {%- endcomment -%}
              <div class="product__rating jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">{{ product.metafields.judgeme.badge }}</div>
            {%- endif -%}

          {%- when 'price' -%}
            {%- comment -%}
              The price of exactly what is selected (size + finish), with a line saying what it is and
              whether the frame is included. theme.js keeps both in step with the picker.
            {%- endcomment -%}
            {%- liquid
              assign vs_size = ''
              assign vs_finish = ''
              assign vs_p = ''
              assign vs_s = ''
              for o in product.options_with_values
                assign ok = o.name | downcase
                assign ov = current_variant.options[forloop.index0]
                if ok contains 'tama' or ok contains 'size' or ok contains 'medida'
                  assign vs_size = ov
                elsif ok == 'product' or ok == 'producto' or ok == 'material'
                  assign vs_p = ov
                elsif ok == 'style' or ok == 'estilo'
                  assign vs_s = ov
                elsif ok contains 'marco' or ok contains 'frame' or ok contains 'acabado'
                  assign vs_finish = ov
                endif
              endfor
            -%}
            {%- capture vs_size_label -%}{%- if vs_size != '' -%}{% render 'option-label', value: vs_size, kind: 'size' %}{%- endif -%}{%- endcapture -%}
            {%- capture vs_finish_label -%}
              {%- if vs_p != '' -%}{% render 'option-label', value: vs_p, kind: 'finish', style: vs_s %}{%- else -%}{{ vs_finish }}{%- endif -%}
            {%- endcapture -%}
            {%- assign vs_finish_label = vs_finish_label | strip -%}
            <div class="product__price" id="{{ price_id }}" data-show-save {{ block.shopify_attributes }}>
              {%- if section.settings.pdp_v2 and product.selected_variant == blank and product.price_varies -%}
                <span class="price"><span>{{ 'general.from' | t }} {{ product.price_min | money }}</span></span>
              {%- else -%}
                {%- render 'price', product: product, variant: current_variant, show_save: true -%}
              {%- endif -%}
            </div>
            {%- comment -%}
              When the selected option has no earlier price but others do (e.g. «Sin marco» selected,
              framed sizes reduced), show the cheapest real reduction under the price. theme.js hides it
              while the selected variant carries its own struck price.
            {%- endcomment -%}
            {%- assign deal_v = nil -%}
            {%- for v in product.variants -%}
              {%- if v.available and v.compare_at_price > v.price -%}
                {%- if deal_v == nil or v.price < deal_v.price -%}{%- assign deal_v = v -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if deal_v -%}
              {%- assign deal_save = deal_v.compare_at_price | minus: deal_v.price -%}
              <button type="button" class="product__deal" data-product-deal data-pick-frame{% if current_variant.compare_at_price > current_variant.price %} hidden{% endif %}>
                <span class="product__deal-tag">Oferta</span>
                <span class="product__deal-text">
                  <span class="product__deal-label">{{ 'general.framed_from' | t }}</span>
                  <span class="product__deal-prices"><s>{{ deal_v.compare_at_price | money }}</s> <b>{{ deal_v.price | money }}</b></span>
                </span>
                <span class="product__deal-save">Ahorras {{ deal_save | money }}</span>
                <span class="product__deal-go" aria-hidden="true">→</span>
              </button>
            {%- endif -%}
            {%- if product.has_only_default_variant == false and section.settings.pdp_v2 != true -%}
              <p class="product__variant-summary" id="{{ price_id }}-summary" data-variant-summary>
                {%- assign fl = vs_finish_label | downcase -%}
                <span data-summary-size>{{ vs_size_label | strip }}</span>
                {%- if vs_finish_label != '' -%}
                  {%- if vs_size_label != '' %} · {% endif -%}
                  <span data-summary-finish>
                    {%- if fl contains 'sin marco' -%}{{ 'product.summary_no_frame' | t }}
                    {%- elsif fl contains 'lienzo' -%}{{ vs_finish_label }}
                    {%- elsif fl contains 'marco' -%}{{ 'product.summary_frame_included' | t: frame: vs_finish_label }}
                    {%- else -%}{{ vs_finish_label }}{%- endif -%}
                  </span>
                {%- endif -%}
              </p>
            {%- endif -%}
            {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
              <div class="product__tax">
                {%- if cart.taxes_included -%}{{ 'cart.taxes_included' | t }}{%- endif -%}
                {%- if settings.free_shipping_threshold == 0 and settings.shipping_message != blank -%}
                  {%- if shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}" style="text-decoration:underline">{{ 'product.free_shipping' | t }}</a>.{% else %} {{ 'product.free_shipping' | t }}.{% endif -%}
                {%- elsif shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}" style="text-decoration:underline">{{ 'product.shipping' | t }}</a> · {{ 'cart.shipping_at_checkout' | t }}{%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="accordion product__desc-acc" {{ block.shopify_attributes }} style="margin-top:0;border-top:0">
                <details{% if block.settings.open %} open{% endif %}>
                  <summary>{{ block.settings.heading | default: 'Descripción' }}</summary>
                  <div class="accordion__content rte">{{ product.description }}</div>
                </details>
              </div>
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- unless product.has_only_default_variant -%}
                {%- liquid
                  assign size_help = block.settings.size_help.url | default: pages['guia-de-tamanos'].url
                  assign frame_help = block.settings.frame_help.url
                  assign selected_opts = current_variant.options
                  # With the theme's image upload, "Sube tu imagen" is step 1
                  assign is_template = false
                  if product.tags contains 'plantilla'
                    assign is_template = true
                  endif
                  assign step_offset = 0
                  for b in section.blocks
                    if b.type == 'custom_guard' and b.settings.upload and is_template == false
                      assign step_offset = 1
                    endif
                    if b.type == 'photo_step'
                      assign step_offset = 1
                    endif
                    if b.type == 'template_studio' and b.settings.endpoint != blank
                      assign step_offset = 1
                      if b.settings.needs_name
                        assign step_offset = 2
                      endif
                    endif
                  endfor
                -%}
                {%- liquid
                  # Gelato products come with Size / Product / Style: Product + Style are shown
                  # together as one "finish" step (Sin marco, Marco negro, Lienzo…)
                  assign product_i = -1
                  assign style_i = -1
                  for o in product.options_with_values
                    assign k = o.name | downcase
                    if k == 'product' or k == 'producto' or k == 'material'
                      assign product_i = forloop.index0
                    elsif k == 'style' or k == 'estilo'
                      assign style_i = forloop.index0
                    endif
                  endfor
                  assign merged = false
                  if product_i >= 0 and style_i >= 0
                    assign merged = true
                  endif
                  assign step_n = step_offset
                -%}
                {%- comment -%} Personalised illustrations: a shorter picker (sizes that don't exist for the chosen finish are hidden; canvas behind one link) {%- endcomment -%}
                {%- comment -%} The size guide buttons go right under «Elige tu tamaño» (the size_compare block, if the template has one) {%- endcomment -%}
                {%- assign sc_block = nil -%}
                {%- for sb in section.blocks -%}{%- if sb.type == 'size_compare' -%}{%- assign sc_block = sb -%}{%- endif -%}{%- endfor -%}
                {%- assign simple_picker = false -%}
                {%- for sb in section.blocks -%}{%- if sb.type == 'template_studio' -%}{%- assign simple_picker = true -%}{%- endif -%}{%- endfor -%}
                {%- assign picker_dom_id = 'VariantPicker-' | append: section.id -%}
                <variant-picker id="VariantPicker-{{ section.id }}" class="vsteps{% if simple_picker %} vsteps--simple{% endif %}{% if section.settings.pdp_v2 %} vsteps--v2{% endif %}" data-form="{{ form_id }}" data-price="{{ price_id }}">
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign option_index = forloop.index0
                      assign option_key = option.name | downcase
                      assign is_size = false
                      if option_key contains 'tama' or option_key contains 'size' or option_key contains 'medida'
                        assign is_size = true
                      endif
                      assign is_frame = false
                      if option_key contains 'marco' or option_key contains 'frame' or option_key contains 'acabado'
                        assign is_frame = true
                      endif
                      assign is_hidden = false
                      if merged and option_index == product_i or merged and option_index == style_i
                        assign is_hidden = true
                      endif
                      if merged and option_index == style_i
                        assign is_frame = true
                      endif
                      assign recommended = block.settings.recommended_size
                      if is_frame
                        assign recommended = block.settings.recommended_frame
                      endif
                      assign step_title = option.name
                      if is_size
                        assign step_title = 'product.step_size' | t
                      elsif is_frame
                        assign step_title = 'product.step_finish' | t
                      endif
                      unless is_hidden
                        assign step_n = step_n | plus: 1
                      endunless
                      assign label_kind = ''
                      if is_size
                        assign label_kind = 'size'
                      endif
                    -%}
                    {%- comment -%} «A2» matches «A2 (42 x 59.4 cm)» and «A2 · 42×59,4 cm» alike {%- endcomment -%}
                    {%- if is_size and recommended != blank -%}
                      {%- assign want = recommended | strip -%}
                      {%- assign want_len = want | size -%}
                      {%- assign found = blank -%}
                      {%- for value in option.values -%}
                        {%- assign head = value | slice: 0, want_len -%}
                        {%- if value == want or head == want -%}{%- assign found = value -%}{%- break -%}{%- endif -%}
                      {%- endfor -%}
                      {%- assign recommended = found -%}
                    {%- endif -%}
                    {%- if is_size and recommended == blank and block.settings.highlight_largest -%}
                      {%- assign best = 0 -%}
                      {%- for value in option.values -%}
                        {%- capture r -%}{% render 'option-label', value: value, kind: 'rank' %}{%- endcapture -%}
                        {%- assign r = r | plus: 0 -%}
                        {%- if r < 20 and r > best -%}{%- assign best = r -%}{%- assign recommended = value -%}{%- endif -%}
                      {%- endfor -%}
                      {%- if best == 0 -%}{%- assign recommended = option.values | last -%}{%- endif -%}
                    {%- endif -%}
                    {%- capture selected_label -%}{% render 'option-label', value: option.selected_value, kind: label_kind %}{%- endcapture -%}
                    <fieldset class="option vstep{% if is_size %} option--size{% endif %}{% if is_frame %} option--frame{% endif %}{% if is_hidden %} vstep--merged{% endif %}" data-option-kind="{% if is_size %}size{% elsif is_frame %}frame{% else %}other{% endif %}"{% if is_hidden %} hidden{% endif %}>
                      <legend class="vstep__head">
                        <span class="vstep__num">{{ step_n }}</span>
                        <span class="vstep__title">{{ step_title }}</span>
                        {%- unless is_size -%}<span class="vstep__value" data-selected-value>{{ selected_label }}</span>{%- endunless -%}
                      </legend>
                      {%- if is_size and size_help != blank -%}<a class="vstep__help" href="{{ size_help }}">{{ 'product.size_guide' | t }}</a>{%- endif -%}
                      {%- if is_size and sc_block and sc_inline != true -%}{%- render 'size-compare', product: product, block: sc_block -%}{%- assign sc_inline = true -%}{%- endif -%}
                      {%- if is_frame and frame_help != blank and is_hidden == false -%}<a class="vstep__help" href="{{ frame_help }}">{{ 'product.about_frames' | t }}</a>{%- endif -%}

                      {%- assign size_boxes = false -%}{%- if is_size and section.settings.size_boxes -%}{%- assign size_boxes = true -%}{%- endif -%}
                      <details class="vsel{% unless is_size %} vsel--static{% endunless %}{% if size_boxes %} vsel--boxes{% endif %}"{% if is_size and size_boxes == false %} data-vsel{% else %} open{% endif %}>
                        <summary class="vsel__current"{% unless is_size %} tabindex="-1" aria-hidden="true"{% endunless %}>
                          <span data-selected-value>{{ selected_label }}</span>
                          <span class="vsel__price" data-atc-price-mirror>{{ current_variant.price | money }}</span>
                          <svg class="vsel__caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                        </summary>
                        <div class="option__values{% if is_size %} vsel__list{% elsif is_frame %} ftiles{% endif %}">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0
                            # Price of this value combined with the other options currently selected
                            assign row_price = ''
                            for v in product.variants
                              if v.options[option_index] == value
                                assign match = true
                                for o in v.options
                                  if forloop.index0 != option_index and o != selected_opts[forloop.index0]
                                    assign match = false
                                  endif
                                endfor
                                if match
                                  assign row_price = v.price | money
                                endif
                              endif
                            endfor
                          -%}
                          {%- capture display -%}{% render 'option-label', value: value, kind: label_kind %}{%- endcapture -%}
                          {%- capture rank -%}{%- if is_size -%}{% render 'option-label', value: value, kind: 'rank' %}{%- else -%}{{ forloop.index }}{%- endif -%}{%- endcapture -%}
                          <input type="radio"
                            id="{{ input_id }}"
                            name="{{ section.id }}-{{ option.name | handle }}"
                            value="{{ value | escape }}"
                            data-display="{{ display | escape }}"
                            style="order: {{ rank }}"
                            {% if option.selected_value == value %}checked{% endif %}>
                          {%- if is_size -%}
                            <label for="{{ input_id }}" class="vsel__row" style="order: {{ rank }}">
                              <span>{{ display }}</span>
                              {%- if value == recommended -%}<span class="option__badge">{{ block.settings.recommended_label }}</span>{%- endif -%}
                              <span class="vsel__rowprice" data-row-price data-option-index="{{ option_index }}" data-value="{{ value | escape }}">{{ row_price }}</span>
                            </label>
                          {%- elsif is_frame -%}
                            {%- capture swatch -%}{%- render 'frame-swatch', value: value -%}{%- endcapture -%}
                            {%- assign kind = swatch | split: 'data-frame-kind="' | last | split: '"' | first -%}
                            {%- assign vdown = value | downcase -%}
                            <label for="{{ input_id }}" class="ftile{% if vdown contains 'lienzo' or vdown contains 'canvas' %} ftile--canvas{% endif %}">
                              {%- if value == recommended -%}<span class="option__badge ftile__badge">{{ block.settings.recommended_label }}</span>{%- endif -%}
                              <span class="ftile__img ftile__img--{{ kind }}">{{ swatch }}</span>
                              <span class="ftile__name">{{ display }}</span>
                            </label>
                          {%- else -%}
                            <label for="{{ input_id }}">{{ display }}</label>
                          {%- endif -%}
                        {%- endfor -%}
                        </div>
                      </details>
                      {%- if simple_picker and is_frame -%}
                        {%- assign all_vals = option.values | join: '|' | downcase -%}
                        {%- if all_vals contains 'lienzo' or all_vals contains 'canvas' -%}
                          <button type="button" class="vsimple__canvas" data-show-canvas>{{ 'product.show_canvas' | t }}</button>
                        {%- endif -%}
                      {%- endif -%}
                    </fieldset>

                    {%- comment -%} Combined finish step, right after the size {%- endcomment -%}
                    {%- if merged and is_size -%}
                      {%- liquid
                        assign step_n = step_n | plus: 1
                        assign pairs = ''
                        for v in product.variants
                          assign pair = v.options[product_i] | append: '§' | append: v.options[style_i]
                          assign check = '¦' | append: pairs | append: '¦'
                          assign key = '¦' | append: pair | append: '¦'
                          unless check contains key
                            if pairs == ''
                              assign pairs = pair
                            else
                              assign pairs = pairs | append: '¦' | append: pair
                            endif
                          endunless
                        endfor
                        assign pair_list = pairs | split: '¦'
                        assign cur_p = current_variant.options[product_i]
                        assign cur_s = current_variant.options[style_i]
                      -%}
                      {%- capture cur_label -%}{% render 'option-label', value: cur_p, kind: 'finish', style: cur_s %}{%- endcapture -%}
                      <div class="option vstep option--frame vstep--finish" data-finish-step data-p-index="{{ product_i }}" data-s-index="{{ style_i }}">
                        <p class="vstep__head">
                          <span class="vstep__num">{{ step_n }}</span>
                          <span class="vstep__title">{{ 'product.step_finish' | t }}</span>
                          <span class="vstep__value" data-finish-value>{{ cur_label }}</span>
                        </p>
                        {%- if frame_help != blank -%}<a class="vstep__help" href="{{ frame_help }}">{{ 'product.about_frames' | t }}</a>{%- endif -%}
                        <div class="option__values ftiles" role="radiogroup" aria-label="{{ 'product.step_finish' | t | escape }}">
                          {%- for pair in pair_list -%}
                            {%- liquid
                              assign pp = pair | split: '§' | first
                              assign ps = pair | split: '§' | last
                              assign pl = pp | downcase
                              assign kind = 'none'
                              assign sl = ps | downcase
                              if sl contains 'black'
                                assign kind = 'black'
                              elsif sl contains 'white'
                                assign kind = 'white'
                              elsif sl contains 'wood'
                                assign kind = 'wood'
                              elsif pl contains 'canvas'
                                assign kind = 'canvas'
                              endif
                              assign order = 1
                              case kind
                                when 'black'
                                  assign order = 2
                                when 'white'
                                  assign order = 3
                                when 'wood'
                                  assign order = 4
                                when 'canvas'
                                  assign order = 5
                              endcase
                              if pl contains 'canvas' and kind != 'canvas'
                                assign order = order | plus: 4
                                assign kind = kind | append: ' ftile__img--canvasframe'
                              endif
                            -%}
                            {%- capture pair_label -%}{% render 'option-label', value: pp, kind: 'finish', style: ps %}{%- endcapture -%}
                            <button type="button" style="order: {{ order }}" class="ftile{% if pp == cur_p and ps == cur_s %} is-active{% endif %}" role="radio" aria-checked="{% if pp == cur_p and ps == cur_s %}true{% else %}false{% endif %}" data-p="{{ pp | escape }}" data-s="{{ ps | escape }}" data-label="{{ pair_label | escape }}">
                              {%- if pair_label == block.settings.recommended_frame -%}<span class="option__badge ftile__badge">{{ block.settings.recommended_label }}</span>{%- endif -%}
                              <span class="ftile__img ftile__img--{{ kind }}"></span>
                              <span class="ftile__name">{{ pair_label }}</span>
                            </button>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                  <script type="application/json" data-variants>{{ product.variants | json }}</script>
                </variant-picker>
                {%- if section.settings.pdp_v2 -%}
                  {%- render 'pdp-chooser', product: product, picker_id: picker_dom_id, step_offset: step_offset, size_help: size_help -%}
                {%- elsif section.settings.size_visual -%}
                  {% render 'size-visual', product: product %}
                  <script src="{{ 'size-visual.js' | asset_url }}" defer></script>
                {%- endif -%}
              {%- endunless -%}

              {%- render 'pack-picker', product: product, current_variant: current_variant, form_id: form_id -%}
              {%- render 'mixpix-styles', product: product, form_id: form_id -%}
              {%- form 'product', product, id: form_id, data-ajax-cart: 'true' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <div class="product__buy{% if section.settings.pdp_v2 %} product__buy--v2{% endif %}">
                  <div class="qty">
                    <button type="button" data-qty="-1" aria-label="{{ 'cart.less' | t }}">&minus;</button>
                    <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}">
                    <button type="button" data-qty="1" aria-label="{{ 'cart.more' | t }}">+</button>
                  </div>
                  {%- if section.settings.pdp_v2 -%}
                  <button type="submit" class="button pdc-add"
                    data-add-text="{{ 'product.add_to_cart' | t }}"
                    data-sold-out-text="{{ 'product.sold_out' | t }}"
                    data-unavailable-text="{{ 'product.unavailable' | t }}"
                    {% unless current_variant.available %}disabled{% endunless %}>
                    {%- if current_variant.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
                  </button>
                  {%- else -%}
                  <button type="submit" class="button button--accent"
                    data-add-text="{{ 'product.add_to_cart' | t }}"
                    data-with-price
                    data-sold-out-text="{{ 'product.sold_out' | t }}"
                    data-unavailable-text="{{ 'product.unavailable' | t }}"
                    {% unless current_variant.available %}disabled{% endunless %}>
                    {%- if current_variant.available -%}{{ 'product.add_to_cart' | t }} · {{ current_variant.price | money }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
                  </button>
                  {%- endif -%}
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
                {%- if block.settings.show_installments -%}
                  <div class="product__installments">{{ form | payment_terms }}</div>
                {%- endif -%}
              {%- endform -%}
              {%- if section.settings.pdp_v2 -%}
                {%- comment -%} 4 lines with ✓ under the button (docs/ficha-producto-plan.md) {%- endcomment -%}
                <ul class="pdc-checks">
                  <li>{{ 'product.check_made' | t }}</li>
                  <li>{{ 'product.check_delivery' | t: min: settings.delivery_min, max: settings.delivery_max }}</li>
                  {%- if settings.free_shipping_threshold > 0 -%}<li>{{ 'product.check_free_ship' | t: threshold: settings.free_shipping_threshold }}</li>{%- endif -%}
                  <li><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{{ 'product.check_returns' | t }}</a></li>
                </ul>
              {%- elsif settings.free_shipping_threshold > 0 -%}
                {%- comment -%}
                  The shipping rule next to the button, from the theme settings (one source): prints and
                  framed prints have the flat rate of their Shopify delivery profiles; canvases have their
                  own rates per size, so for a canvas it says the price is shown at checkout.
                  theme.js swaps the two lines when the finish changes. Only for the shop currency.
                {%- endcomment -%}
                {%- assign threshold_money = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros -%}
                {%- assign cv_t = current_variant.title | downcase -%}
                {%- assign is_canvas = false -%}
                {%- comment -%} Illustrations ship on their own flat-rate profile (canvas included): no separate canvas line there {%- endcomment -%}
                {%- assign canvas_own_rate = true -%}
                {%- if product.template_suffix contains 'ilustracion' -%}{%- assign canvas_own_rate = false -%}{%- endif -%}
                {%- if canvas_own_rate -%}{%- if cv_t contains 'canvas' or cv_t contains 'lienzo' -%}{%- assign is_canvas = true -%}{%- endif -%}{%- endif -%}
                {%- if cart.currency.iso_code == shop.currency -%}
                  <p class="product__ship-hint" data-ship-rule{% unless canvas_own_rate %} data-flat{% endunless %}>
                    <span data-ship-rule-print{% if is_canvas %} hidden{% endif %}>
                      {%- if settings.shipping_rate_print != blank -%}{{ 'product.ship_rule' | t: rate: settings.shipping_rate_print, threshold: threshold_money }}{%- else -%}{{ 'product.ship_rule_nofee' | t: threshold: threshold_money }}{%- endif -%}
                    </span>
                    <span data-ship-rule-canvas{% unless is_canvas %} hidden{% endunless %}>{{ 'product.ship_rule_canvas' | t: threshold: threshold_money }}</span>
                    {%- if settings.gift_enabled -%}{%- assign gift_money = settings.gift_tier1 | times: 100 | money_without_trailing_zeros %} · {{ 'product.gift_from' | t: amount: gift_money }}{%- endif -%}
                  </p>
                {%- endif -%}
              {%- elsif settings.shipping_message != blank -%}
                <p class="product__ship-hint">{{ settings.shipping_message }}{% if settings.shipping_details != blank %}<span class="product__ship-sub">{{ settings.shipping_details }}</span>{% endif %}</p>
              {%- endif -%}
            </div>
            {%- comment -%} Illustrations: «other styles» after the button, out of the way of the 4 steps {%- endcomment -%}
            {%- if simple_picker -%}{%- render 'pz-styles-strip', product: product -%}{%- endif -%}

          {%- when 'custom_guard' -%}
            {%- comment -%} Personalízalo: quality notice + required image-rights checkbox (recorded as a line item property). {%- endcomment -%}
            <div class="cguard" data-cguard data-min-ppi="{{ block.settings.min_ppi }}" data-good-ppi="300"
              data-low-text="{{ 'product.cguard_low' | t | escape }}" data-mid-text="{{ 'product.cguard_mid' | t | escape }}" data-ok-text="{{ 'product.cguard_ok' | t | escape }}" {{ block.shopify_attributes }}>
              {%- assign show_upload = block.settings.upload -%}
              {%- if product.tags contains 'plantilla' -%}{%- assign show_upload = false -%}{%- endif -%}
              {%- if show_upload -%}
                <p class="vstep__head cguard__head"><span class="vstep__num">1</span><span class="vstep__title">{{ 'product.upload_step' | t }}</span></p>
              {%- elsif block.settings.heading != blank -%}<p class="cguard__title">{{ block.settings.heading }}</p>{%- endif -%}
              {%- if block.settings.notice != blank -%}<p class="cguard__notice">{{ block.settings.notice }}</p>{%- endif -%}
              {%- if show_upload -%}
                <div class="cupload" data-change-text="{{ 'product.upload_change' | t | escape }}" data-meta-text="{{ 'product.upload_meta' | t | escape }}">
                  <label class="cupload__drop" for="Upload-{{ section.id }}">
                    <input class="cupload__input" id="Upload-{{ section.id }}" type="file" name="properties[Imagen]" form="{{ form_id }}" accept="image/jpeg,image/png" required data-cupload>
                    <span class="cupload__icon" aria-hidden="true">+</span>
                    <span class="cupload__label" data-cupload-label>{{ 'product.upload_cta' | t }}</span>
                  </label>
                  <p class="cupload__hint cupload__hint--below">{{ 'product.upload_hint' | t }}</p>
                  <div class="cupload__preview" data-cupload-preview hidden>
                    <div class="cupload__wall">
                      <div class="cupload__frame" data-cupload-frame><img alt="" width="600" height="800" data-cupload-img></div>
                    </div>
                    <p class="cupload__meta" data-cupload-meta></p>
                  </div>
                  {%- comment -%} A sangre / con borde blanco: saved in the order as «Borde»; the preview shows the margin {%- endcomment -%}
                  <div class="tstudio__opts cupload__border" role="radiogroup" aria-label="Acabado de la imagen">
                    <span class="tstudio__opts-label">Acabado de la imagen</span>
                    <label class="tstudio__font"><input type="radio" name="properties[Borde]" value="A sangre" form="{{ form_id }}" checked><span>A sangre</span></label>
                    <label class="tstudio__font"><input type="radio" name="properties[Borde]" value="Con borde blanco" form="{{ form_id }}" data-white><span>Con borde blanco</span></label>
                  </div>
                </div>
              {%- endif -%}
              <p class="cguard__check" data-cguard-result hidden></p>
              {%- comment -%} No box to tick: adding to the cart is the confirmation, and it is still saved in the order {%- endcomment -%}
              <input type="hidden" name="properties[Derechos de imagen]" value="Confirmados al añadir al carrito" form="{{ form_id }}">
              <p class="cguard__rights-note">Al añadir al carrito confirmas que tienes los derechos para imprimir esta imagen.</p>
              {%- if block.settings.note != blank -%}<p class="cguard__note">{{ block.settings.note }}</p>{%- endif -%}
            </div>

          {%- when 'gift_recipient' -%}
            {%- comment -%} Gift card: send it straight to the recipient by email, with a message and a date (Shopify's recipient fields) {%- endcomment -%}
            {%- if product.gift_card? -%}
              <div class="gcr" data-gcr {{ block.shopify_attributes }}>
                <label class="gcr__toggle">
                  <input type="checkbox" name="properties[__shopify_send_gift_card_to_recipient]" form="{{ form_id }}" data-gcr-toggle>
                  <span>{{ block.settings.toggle_label }}</span>
                </label>
                <div class="gcr__fields" data-gcr-fields hidden>
                  <label class="gcr__field"><span>{{ block.settings.email_label }}</span>
                    <input type="email" name="properties[Recipient email]" form="{{ form_id }}" autocomplete="off" required disabled></label>
                  <label class="gcr__field"><span>{{ block.settings.name_label }}</span>
                    <input type="text" name="properties[Recipient name]" form="{{ form_id }}" autocomplete="off" disabled></label>
                  <label class="gcr__field"><span>{{ block.settings.message_label }}</span>
                    <textarea name="properties[Message]" form="{{ form_id }}" rows="3" maxlength="200" placeholder="{{ block.settings.message_placeholder | escape }}" disabled></textarea></label>
                  <label class="gcr__field"><span>{{ block.settings.date_label }}</span>
                    <input type="date" name="properties[Send on]" form="{{ form_id }}" disabled data-gcr-date></label>
                  <input type="hidden" name="properties[__shopify_offset]" form="{{ form_id }}" disabled data-gcr-offset>
                  <p class="gcr__hint">{{ block.settings.hint }}</p>
                </div>
              </div>
              <script>
                (function () {
                  var box = document.currentScript.previousElementSibling;
                  var toggle = box.querySelector('[data-gcr-toggle]');
                  var fields = box.querySelector('[data-gcr-fields]');
                  var date = box.querySelector('[data-gcr-date]');
                  var today = new Date(); var max = new Date(); max.setDate(max.getDate() + 90);
                  var iso = function (d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); };
                  date.min = iso(today); date.max = iso(max);
                  box.querySelector('[data-gcr-offset]').value = new Date().getTimezoneOffset();
                  toggle.addEventListener('change', function () {
                    fields.hidden = !toggle.checked;
                    fields.querySelectorAll('input, textarea').forEach(function (el) { el.disabled = !toggle.checked; });
                  });
                })();
              </script>
            {%- endif -%}

          {%- when 'template_studio' -%}
            {%- render 'template-studio', block: block, form_id: form_id, product: product, section_id: section.id -%}

          {%- when 'template_link' -%}
            {%- unless product.tags contains 'plantilla' -%}
              {%- assign tl = block.settings.link | default: '/collections/personalizalo#Plantillas' -%}
              <p class="ptpl-link" {{ block.shopify_attributes }}>{{ block.settings.text }} <a href="{{ tl }}">{{ block.settings.link_label }}</a></p>
            {%- endunless -%}

          {%- when 'text_link' -%}
            {%- if block.settings.link != blank -%}
              <p class="ptpl-link" {{ block.shopify_attributes }}>{{ block.settings.text }} <a href="{{ block.settings.link }}">{{ block.settings.link_label }}</a></p>
            {%- endif -%}

          {%- when 'photo_step' -%}
            {%- comment -%}
              «Tu foto, en un cuadro»: the photo comes first. The upload itself happens in Gelato's
              personaliser (app embed, an iframe on another domain we don't touch); this step explains
              the order and opens it. theme.js finds Gelato's «Personalizar» button by its text; if it
              isn't there (app not loaded / renamed) the button scrolls to the buy area instead.
            {%- endcomment -%}
            <div class="pstep" data-photo-step {{ block.shopify_attributes }}>
              <p class="vstep__head"><span class="vstep__num">1</span><span class="vstep__title">{{ block.settings.title | default: 'Sube tu foto' }}</span></p>
              {%- if block.settings.text != blank -%}<p class="pstep__text">{{ block.settings.text }}</p>{%- endif -%}
              <button type="button" class="button button--accent button--full pstep__go" data-photo-step-go>{{ block.settings.button | default: 'Sube tu foto' }}</button>
              <p class="pstep__status" role="status" aria-live="polite" data-photo-step-status></p>
              {%- if block.settings.steps != blank -%}<p class="pstep__steps">{{ block.settings.steps }}</p>{%- endif -%}
            </div>

          {%- when 'notice' -%}
            {%- if block.settings.text != blank -%}
              <p class="pnotice" {{ block.shopify_attributes }}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 8v5m0 3v.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span>{{ block.settings.text }}</span></p>
            {%- endif -%}

          {%- when 'edition' -%}
            {%- liquid
              assign ed_size = product.metafields.custom.edition_size.value | default: 0
              assign ed_sold = product.metafields.custom.edition_sold.value | default: 0
            -%}
            {%- if ed_size > 0 -%}
              {%- liquid
                assign ed_left = ed_size | minus: ed_sold | at_least: 0
                assign ed_pct = ed_sold | times: 100.0 | divided_by: ed_size | at_most: 100
                assign ed_next = ed_sold | plus: 1
              -%}
              <div class="edition" {{ block.shopify_attributes }}>
                <div class="edition__head">
                  <span class="edition__label">{{ 'product.edition_label' | t }}</span>
                  <span class="edition__total">{{ 'product.edition_total' | t: count: ed_size }}</span>
                </div>
                <div class="edition__bar" role="progressbar" aria-valuemin="0" aria-valuemax="{{ ed_size }}" aria-valuenow="{{ ed_sold }}"><span style="width: {{ ed_pct }}%"></span></div>
                {%- if ed_left > 0 -%}
                  <p class="edition__count">{{ 'product.edition_left_html' | t: left: ed_left, total: ed_size, next: ed_next }}</p>
                {%- else -%}
                  <p class="edition__count">{{ 'product.edition_sold_out_html' | t }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'delivery' -%}
            {%- if section.settings.pdp_v2 -%}
              {%- comment -%} New page: delivery is in the checklist under the button {%- endcomment -%}
            {%- elsif block.settings.boxed -%}
              {%- comment -%} Info box: made to order + delivery estimate + free-shipping threshold (all real data) {%- endcomment -%}
              <div class="pinfo" {{ block.shopify_attributes }}>
                {%- if block.settings.made_to_order != blank -%}<p class="pinfo__row pinfo__row--ok"><span class="pinfo__dot" aria-hidden="true"></span>{{ block.settings.made_to_order }}</p>{%- endif -%}
                {% render 'delivery-estimate' %}
                {%- if settings.free_shipping_threshold > 0 -%}
                  <p class="pinfo__row">{% render 'trust-icon', name: 'box' %}<span>{{ block.settings.free_ship_label }} <b>{{ settings.free_shipping_threshold }} €</b></span></p>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}<a class="pinfo__link" href="{{ block.settings.link_url | default: shop.shipping_policy.url }}">{{ block.settings.link_label }}</a>{%- endif -%}
              </div>
            {%- else -%}
              <div {{ block.shopify_attributes }}>{% render 'delivery-estimate' %}</div>
            {%- endif -%}

          {%- when 'payments' -%}
            {%- comment -%} Under the buy button: the payment methods really enabled in the shop + two short promises
              (new page: icons and guarantee only; the promises are already in the checklist) {%- endcomment -%}
            <div class="paybar{% if section.settings.pdp_v2 %} paybar--v2{% endif %}" {{ block.shopify_attributes }}>
              {%- if shop.enabled_payment_types.size > 0 -%}
                <ul class="paybar__icons" aria-label="{{ block.settings.icons_label | escape }}">
                  {%- for type in shop.enabled_payment_types -%}
                    <li>{{ type | payment_type_svg_tag: class: 'paybar__icon' }}</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if section.settings.pdp_v2 != true and block.settings.pill_1 != blank or section.settings.pdp_v2 != true and block.settings.pill_2 != blank -%}
                <ul class="paybar__pills">
                  {%- if block.settings.pill_1 != blank -%}<li>{% render 'trust-icon', name: 'lock' %}<span>{{ block.settings.pill_1 }}</span></li>{%- endif -%}
                  {%- if block.settings.pill_2 != blank -%}<li>{% render 'trust-icon', name: block.settings.pill_2_icon %}<span>{{ block.settings.pill_2 | replace: '[DIAS]', settings.returns_days }}</span></li>{%- endif -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.guarantee != blank -%}
                <p class="paybar__guarantee">{% render 'trust-icon', name: 'print' %}<span>{{ block.settings.guarantee }}</span></p>
              {%- endif -%}
            </div>

          {%- when 'wall_preview' -%}
            {% render 'wall-preview', product: product, block: block %}

          {%- when 'size_compare' -%}
            {%- comment -%} Already shown under the size step when the template has the variant picker {%- endcomment -%}
            {%- unless sc_inline -%}{% render 'size-compare', product: product, block: block %}{%- endunless -%}

          {%- when 'material' -%}
            <div class="product__material" {{ block.shopify_attributes }}>
              {%- if block.settings.material != blank -%}<p><strong>{{ 'product.material' | t }}</strong> {{ block.settings.material }}</p>{%- endif -%}
              {%- if block.settings.frame != blank -%}<p><strong>{{ 'product.frame' | t }}</strong> {{ block.settings.frame }}</p>{%- endif -%}
            </div>

          {%- when 'complete_wall' -%}
            {% render 'complete-wall', product: product, block: block %}

          {%- when 'trust' -%}
            {%- comment -%} New page: same promises as the checklist under the button, so not repeated {%- endcomment -%}
            {%- if section.settings.pdp_v2 -%}{%- continue -%}{%- endif -%}
            <ul class="product__trust" {{ block.shopify_attributes }}>
              <li>{% render 'trust-icon', name: 'print' %}<span>{{ block.settings.line_1 }}</span></li>
              <li>{% render 'trust-icon', name: 'truck' %}<span>{{ block.settings.line_2 }}</span></li>
              <li>{% render 'trust-icon', name: 'return' %}<span>{{ block.settings.line_3 | replace: '[DIAS]', settings.returns_days }}</span></li>
              <li>{% render 'trust-icon', name: 'lock' %}<span>{{ block.settings.line_4 }}</span></li>
            </ul>

          {%- when 'notes' -%}
            {%- comment -%} New page: nothing between the price and the picker (the checklist says it under the button) {%- endcomment -%}
            {%- if section.settings.pdp_v2 -%}{%- continue -%}{%- endif -%}
            <ul class="product__notes" {{ block.shopify_attributes }}>
              {%- if block.settings.note_1 != blank -%}<li>{{ block.settings.note_1 }}</li>{%- endif -%}
              {%- if block.settings.note_2 != blank -%}<li>{{ block.settings.note_2 }}</li>{%- endif -%}
              {%- if block.settings.note_3 != blank -%}<li>{{ block.settings.note_3 }}</li>{%- endif -%}
            </ul>

          {%- when 'collapsible' -%}
            <div class="accordion" {{ block.shopify_attributes }} style="margin-top:0;border-top:0">
              <details{% if block.settings.open %} open{% endif %}>
                <summary>{{ block.settings.heading }}</summary>
                <div class="accordion__content rte">
                  {%- if block.settings.video_url != blank -%}
                    <video class="accordion__video" src="{{ block.settings.video_url }}" muted loop playsinline preload="none"{% if block.settings.video_poster != blank %} poster="{{ block.settings.video_poster | image_url: width: 900 }}"{% endif %} aria-label="{{ block.settings.heading | escape }}"></video>
                  {%- endif -%}
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>
            </div>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<div class="sticky-buy" data-sticky-buy aria-hidden="true">
  <div class="sticky-buy__meta">
    <span class="sticky-buy__title">{{ product.title }}</span>
    <span class="sticky-buy__price">{% render 'price', product: product, variant: current_variant %}</span>
  </div>
  <button type="submit" class="button button--accent" form="{{ form_id }}" tabindex="-1"{% unless current_variant.available %} disabled{% endunless %}>
    {%- if current_variant.available -%}{{ 'product.add_short' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
  </button>
</div>

{%- if section.settings.quality_block -%}{% render 'product-quality', product: product %}{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
    "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "sku": {{ variant.sku | json }},
        "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "url": {{ request.origin | append: variant.url | json }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

