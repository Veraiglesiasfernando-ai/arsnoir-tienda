                    /* New photo: filter thumbnails, orientation from the photo, framing back to the centre */
                    var refreshEditor = function () {
                      if (!editor || !photoUrl) return;
                      editor.querySelectorAll('.fedit__flt img').forEach(function (im) { im.src = photoUrl; });
                      var probe = new Image();
                      probe.onload = function () { photoW = probe.naturalWidth; photoH = probe.naturalHeight; orient = probe.naturalWidth > probe.naturalHeight ? 'h' : 'v'; applyOrient(); sync(); paintRoomsSoon(); renderQuality(); };
                      probe.src = photoUrl;
                      applyCrop();
                    };
                    /* Vertical / horizontal print: the frame keeps the size's proportions, turned the chosen way */
                    var turn = function (fr) {
                      if (!fr || !orient) return;
                      var ar = (fr.style.aspectRatio || '21 / 29.7').split('/').map(parseFloat);
                      if (ar.length < 2 || !ar[0] || !ar[1]) return;
                      var land = ar[0] > ar[1];
                      if ((orient === 'h') !== land) { var v = ar[1] + ' / ' + ar[0]; if (fr.style.aspectRatio !== v) fr.style.aspectRatio = v; }
                      fr.classList.toggle('is-land', orient === 'h');
                    };
                    var applyOrient = function () {
                      turn(wall.querySelector('[data-cupload-frame]'));
                      if (!editor) return;
                      edAll('[data-orient]').forEach(function (b) { b.classList.toggle('is-on', b.dataset.orient === orient); });
                      editor.querySelector('[data-orient-prop]').value = orient === 'h' ? 'Horizontal' : 'Vertical';
