                        '<div class="fqmodal__body"><p>Si subes una imagen de baja resolución, el cuadro puede salir borroso. Mira qué tamaños van bien con tu foto:</p><ul class="fqmodal__list" data-qlist></ul>' +
                        '<p class="fqmodal__note">En naranja o rojo: si eliges ese tamaño, revisamos tu foto y la mejoramos antes de imprimir. Si tienes una con más resolución, mejor súbela.</p></div></div>';
                      document.body.appendChild(qmodal);
                      var closeQ = function () { qmodal.hidden = true; document.documentElement.classList.remove('has-fmodal'); };
                      qmodal.addEventListener('click', function (e) { if (e.target === qmodal || e.target.closest('[data-qclose]')) closeQ(); });
                      fbar.querySelector('[data-qopen]').addEventListener('click', function () { renderQuality(); qmodal.hidden = false; document.documentElement.classList.add('has-fmodal'); });
