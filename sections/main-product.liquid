{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign price_id = 'Price-' | append: section.id
-%}

<section class="page-width" data-product-handle="{{ product.handle }}">
  <div class="product">
    <div class="product__gallery">
      {%- for media in product.media -%}
        {%- liquid
          assign is_lifestyle = false
          if section.settings.lifestyle_from > 0 and forloop.index >= section.settings.lifestyle_from
            assign is_lifestyle = true
          endif
          assign load = 'lazy'
          if forloop.first
            assign load = 'eager'
          endif
        -%}
        <div class="product__media{% if is_lifestyle %} product__media--lifestyle{% endif %}" data-media-id="{{ media.id }}">
          {%- if media.media_type == 'image' -%}
            {{ media | image_url: width: 1600 | image_tag:
              loading: load,
              widths: '500, 800, 1100, 1400, 1600',
              sizes: '(min-width: 900px) 55vw, 90vw',
              alt: media.alt | default: product.title
            }}
          {%- else -%}
            {{ media | media_tag: image_size: '1600x' }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="product__media">{% render 'frame-placeholder' %}</div>
      {%- endfor -%}
    </div>

    <div class="product__info">
      {% render 'breadcrumbs' %}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            <div class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</div>

          {%- when 'title' -%}
            <div class="product__title-row" {{ block.shopify_attributes }}>
              <h1 class="product__title">{{ product.title }}</h1>
              {% render 'fav-button', handle: product.handle, class: 'fav-btn--inline' %}
            </div>
            {%- comment -%} Stars only when a review app has written real ratings to the standard metafields {%- endcomment -%}
            {%- assign p_rating = product.metafields.reviews.rating.value -%}
            {%- assign p_count = product.metafields.reviews.rating_count.value | default: 0 -%}
            {%- if p_rating != blank and p_count > 0 -%}
              <a href="#Reviews" class="product__rating">{% render 'stars', rating: p_rating.rating, max: p_rating.scale_max, count: p_count %}</a>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="product__price" id="{{ price_id }}" {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant %}
            </div>
            {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
              <div class="product__tax">
                {%- if cart.taxes_included -%}{{ 'cart.taxes_included' | t }}{%- endif -%}
                {%- if settings.free_shipping_threshold == 0 and settings.shipping_message != blank -%}
                  {%- if shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}" style="text-decoration:underline">{{ 'product.free_shipping' | t }}</a>.{% else %} {{ 'product.free_shipping' | t }}.{% endif -%}
                {%- elsif shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}" style="text-decoration:underline">{{ 'product.shipping' | t }}</a> · {{ 'cart.shipping_at_checkout' | t }}{%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- unless product.has_only_default_variant -%}
                <variant-picker data-form="{{ form_id }}" data-price="{{ price_id }}">
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign option_index = forloop.index0
                      assign option_key = option.name | downcase
                      assign is_size = false
                      if option_key contains 'tama' or option_key contains 'size' or option_key contains 'medida'
                        assign is_size = true
                      endif
                      assign is_frame = false
                      if option_key contains 'marco' or option_key contains 'frame' or option_key contains 'acabado'
                        assign is_frame = true
                      endif
                      assign recommended = block.settings.recommended_size
                      if is_size and recommended == blank and block.settings.highlight_largest
                        assign recommended = option.values | last
                      endif
                    -%}
                    <fieldset class="option{% if is_size %} option--size{% endif %}{% if is_frame %} option--frame{% endif %}" data-option-kind="{% if is_size %}size{% elsif is_frame %}frame{% else %}other{% endif %}">
                      <legend>{{ option.name }} <span data-selected-value>{{ option.selected_value }}</span></legend>
                      <div class="option__values">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                          <input type="radio"
                            id="{{ input_id }}"
                            name="{{ section.id }}-{{ option.name | handle }}"
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}checked{% endif %}>
                          <label for="{{ input_id }}">
                            {%- if is_frame -%}{%- render 'frame-swatch', value: value -%}{%- endif -%}
                            {{- value -}}
                            {%- if is_size and value == recommended -%}<span class="option__badge">{{ block.settings.recommended_label }}</span>{%- endif -%}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json">{{ product.variants | json }}</script>
                </variant-picker>
              {%- endunless -%}

              {%- form 'product', product, id: form_id, data-ajax-cart: 'true' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <div class="product__buy">
                  <div class="qty">
                    <button type="button" data-qty="-1" aria-label="{{ 'cart.less' | t }}">&minus;</button>
                    <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}">
                    <button type="button" data-qty="1" aria-label="{{ 'cart.more' | t }}">+</button>
                  </div>
                  <button type="submit" class="button button--accent"
                    data-add-text="{{ 'product.add_to_cart' | t }}"
                    data-sold-out-text="{{ 'product.sold_out' | t }}"
                    data-unavailable-text="{{ 'product.unavailable' | t }}"
                    {% unless current_variant.available %}disabled{% endunless %}>
                    {%- if current_variant.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
                  </button>
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
                {%- if block.settings.show_installments -%}
                  <div class="product__installments">{{ form | payment_terms }}</div>
                {%- endif -%}
              {%- endform -%}
              {%- if settings.free_shipping_threshold > 0 -%}
                {%- assign threshold_money = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros -%}
                <p class="product__ship-hint">{{ 'product.free_shipping_from' | t: amount: threshold_money }}</p>
              {%- elsif settings.shipping_message != blank -%}
                <p class="product__ship-hint">{{ settings.shipping_message }}{% if settings.shipping_details != blank %}<span class="product__ship-sub">{{ settings.shipping_details }}</span>{% endif %}</p>
              {%- endif -%}
            </div>

          {%- when 'edition' -%}
            {%- liquid
              assign ed_size = product.metafields.custom.edition_size.value | default: 0
              assign ed_sold = product.metafields.custom.edition_sold.value | default: 0
            -%}
            {%- if ed_size > 0 -%}
              {%- liquid
                assign ed_left = ed_size | minus: ed_sold | at_least: 0
                assign ed_pct = ed_sold | times: 100.0 | divided_by: ed_size | at_most: 100
                assign ed_next = ed_sold | plus: 1
              -%}
              <div class="edition" {{ block.shopify_attributes }}>
                <div class="edition__head">
                  <span class="edition__label">{{ 'product.edition_label' | t }}</span>
                  <span class="edition__total">{{ 'product.edition_total' | t: count: ed_size }}</span>
                </div>
                <div class="edition__bar" role="progressbar" aria-valuemin="0" aria-valuemax="{{ ed_size }}" aria-valuenow="{{ ed_sold }}"><span style="width: {{ ed_pct }}%"></span></div>
                {%- if ed_left > 0 -%}
                  <p class="edition__count">{{ 'product.edition_left_html' | t: left: ed_left, total: ed_size, next: ed_next }}</p>
                {%- else -%}
                  <p class="edition__count">{{ 'product.edition_sold_out_html' | t }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'delivery' -%}
            <div {{ block.shopify_attributes }}>{% render 'delivery-estimate' %}</div>

          {%- when 'wall_preview' -%}
            {% render 'wall-preview', product: product, block: block %}

          {%- when 'size_compare' -%}
            {% render 'size-compare', product: product, block: block %}

          {%- when 'material' -%}
            <div class="product__material" {{ block.shopify_attributes }}>
              {%- if block.settings.material != blank -%}<p><strong>{{ 'product.material' | t }}</strong> {{ block.settings.material }}</p>{%- endif -%}
              {%- if block.settings.frame != blank -%}<p><strong>{{ 'product.frame' | t }}</strong> {{ block.settings.frame }}</p>{%- endif -%}
            </div>

          {%- when 'trust' -%}
            <ul class="product__trust" {{ block.shopify_attributes }}>
              <li>{% render 'trust-icon', name: 'print' %}<span>{{ block.settings.line_1 }}</span></li>
              <li>{% render 'trust-icon', name: 'truck' %}<span>{{ block.settings.line_2 }}</span></li>
              <li>{% render 'trust-icon', name: 'return' %}<span>{{ block.settings.line_3 | replace: '[DIAS]', settings.returns_days }}</span></li>
              <li>{% render 'trust-icon', name: 'lock' %}<span>{{ block.settings.line_4 }}</span></li>
            </ul>

          {%- when 'notes' -%}
            <ul class="product__notes" {{ block.shopify_attributes }}>
              {%- if block.settings.note_1 != blank -%}<li>{{ block.settings.note_1 }}</li>{%- endif -%}
              {%- if block.settings.note_2 != blank -%}<li>{{ block.settings.note_2 }}</li>{%- endif -%}
              {%- if block.settings.note_3 != blank -%}<li>{{ block.settings.note_3 }}</li>{%- endif -%}
            </ul>

          {%- when 'collapsible' -%}
            <div class="accordion" {{ block.shopify_attributes }} style="margin-top:0;border-top:0">
              <details{% if block.settings.open %} open{% endif %}>
                <summary>{{ block.settings.heading }}</summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>
            </div>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<div class="sticky-buy" data-sticky-buy aria-hidden="true">
  <div class="sticky-buy__meta">
    <span class="sticky-buy__title">{{ product.title }}</span>
    <span class="sticky-buy__price">{% render 'price', product: product, variant: current_variant %}</span>
  </div>
  <button type="submit" class="button button--accent" form="{{ form_id }}" tabindex="-1"{% unless current_variant.available %} disabled{% endunless %}>
    {%- if current_variant.available -%}{{ 'product.add_short' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
  </button>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
    "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        "sku": {{ variant.sku | json }},
        "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "url": {{ request.origin | append: variant.url | json }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Obra",
  "settings": [
    {
      "type": "range", "id": "lifestyle_from", "label": "Fotos ambientadas a partir de la imagen nº", "min": 0, "max": 6, "step": 1, "default": 2,
      "info": "Las primeras imágenes se muestran sobre paspartú gris; a partir de este número, a sangre (fotos de la obra en una pared). 0 = todas con paspartú."
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Artista", "limit": 1 },
    { "type": "title", "name": "Título", "limit": 1 },
    { "type": "price", "name": "Precio", "limit": 1 },
    { "type": "description", "name": "Descripción", "limit": 1 },
    {
      "type": "buy_buttons", "name": "Opciones y compra", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar botón de pago rápido", "default": false },
        { "type": "checkbox", "id": "show_installments", "label": "Mostrar pago a plazos", "default": true, "info": "Aparece solo si tienes activado el pago a plazos (Klarna, Shop Pay Installments…) en Configuración → Pagos." },
        { "type": "header", "content": "Tamaño destacado" },
        { "type": "checkbox", "id": "highlight_largest", "label": "Destacar el tamaño más grande", "default": true, "info": "Se aplica a la opción llamada Tamaño / Medida / Size." },
        { "type": "text", "id": "recommended_size", "label": "O destacar este tamaño exacto", "info": "Ej.: 50 × 70 cm. Tiene prioridad sobre la opción anterior." },
        { "type": "text", "id": "recommended_label", "label": "Etiqueta", "default": "Recomendado" }
      ]
    },
    {
      "type": "edition", "name": "Edición limitada", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Se muestra solo en obras con los metafields «Edición limitada: nº de copias» (custom.edition_size) y «Edición limitada: copias vendidas» (custom.edition_sold)." }
      ]
    },
    {
      "type": "delivery", "name": "Fecha de entrega", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "«Recíbelo entre el … y el …», calculado con el plazo de Configuración del tema → Campaña Q4. En temporada indica si llega antes de Navidad o de Reyes." }
      ]
    },
    {
      "type": "wall_preview", "name": "Mírala en tu pared", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Mírala en tu pared" },
        { "type": "text", "id": "default_size", "label": "Tamaño si la obra no tiene variantes", "default": "50 × 70 cm" },
        { "type": "header", "content": "Estancia 1" },
        { "type": "text", "id": "room_1_label", "label": "Nombre", "default": "Salón" },
        { "type": "image_picker", "id": "room_1_image", "label": "Foto (opcional)", "info": "Foto de una pared real. Sin foto se muestra una estancia dibujada a escala." },
        { "type": "range", "id": "room_1_wall", "label": "Ancho de la pared en la foto", "min": 150, "max": 600, "step": 10, "unit": "cm", "default": 320 },
        { "type": "range", "id": "room_1_bottom", "label": "Altura del borde inferior de la obra", "min": 20, "max": 80, "step": 1, "unit": "%", "default": 58 },
        { "type": "text", "id": "room_1_ref", "label": "Referencia (se lee «a escala junto a …»)", "default": "un sofá de 210 cm" },
        { "type": "header", "content": "Estancia 2" },
        { "type": "text", "id": "room_2_label", "label": "Nombre", "default": "Dormitorio" },
        { "type": "image_picker", "id": "room_2_image", "label": "Foto (opcional)" },
        { "type": "range", "id": "room_2_wall", "label": "Ancho de la pared en la foto", "min": 150, "max": 600, "step": 10, "unit": "cm", "default": 300 },
        { "type": "range", "id": "room_2_bottom", "label": "Altura del borde inferior de la obra", "min": 20, "max": 80, "step": 1, "unit": "%", "default": 60 },
        { "type": "text", "id": "room_2_ref", "label": "Referencia", "default": "una cama de 160 cm" },
        { "type": "header", "content": "Estancia 3" },
        { "type": "text", "id": "room_3_label", "label": "Nombre", "default": "Oficina" },
        { "type": "image_picker", "id": "room_3_image", "label": "Foto (opcional)" },
        { "type": "range", "id": "room_3_wall", "label": "Ancho de la pared en la foto", "min": 150, "max": 600, "step": 10, "unit": "cm", "default": 260 },
        { "type": "range", "id": "room_3_bottom", "label": "Altura del borde inferior de la obra", "min": 20, "max": 80, "step": 1, "unit": "%", "default": 60 },
        { "type": "text", "id": "room_3_ref", "label": "Referencia", "default": "un escritorio de 140 cm" }
      ]
    },
    {
      "type": "size_compare", "name": "Comparador de tamaños", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Compara los tamaños" },
        { "type": "text", "id": "note", "label": "Nota", "default": "A escala, junto a una persona de 175 cm. Pulsa un tamaño para elegirlo." }
      ]
    },
    {
      "type": "material", "name": "Material", "limit": 1,
      "settings": [
        { "type": "text", "id": "material", "label": "Material", "default": "Papel Premium Matte 200 g/m², acabado mate · giclée 12 colores · certificado FSC y tintas al agua (sostenible)." },
        { "type": "text", "id": "frame", "label": "Marco (opcional)", "default": "madera maciza sostenible, listo para colgar." }
      ]
    },
    {
      "type": "trust", "name": "Garantías", "limit": 1,
      "settings": [
        { "type": "text", "id": "line_1", "label": "Línea 1", "default": "Impresión profesional de alta calidad" },
        { "type": "text", "id": "line_2", "label": "Línea 2", "default": "Envío GRATIS a España y Europa con seguimiento" },
        { "type": "text", "id": "line_3", "label": "Línea 3", "default": "[DIAS] días para devolver" },
        { "type": "text", "id": "line_4", "label": "Línea 4", "default": "Pago 100% seguro" }
      ]
    },
    {
      "type": "notes", "name": "Notas breves", "limit": 1,
      "settings": [
        { "type": "text", "id": "note_1", "label": "Nota 1", "default": "Pieza exclusiva de ARSNOIR" },
        { "type": "text", "id": "note_2", "label": "Nota 2", "default": "Obra original y exclusiva" },
        { "type": "text", "id": "note_3", "label": "Nota 3" }
      ]
    },
    {
      "type": "collapsible", "name": "Desplegable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Detalles de la obra" },
        { "type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Añade aquí los detalles de la obra.</p>" },
        { "type": "page", "id": "page", "label": "Contenido desde una página" },
        { "type": "checkbox", "id": "open", "label": "Abierto por defecto", "default": false }
      ]
    }
  ]
}
{% endschema %}
