                  {%- else -%}
                  <button type="submit" class="button button--accent"
                    data-add-text="{{ 'product.add_to_cart' | t }}"
                    data-with-price
                    data-sold-out-text="{{ 'product.sold_out' | t }}"
                    data-unavailable-text="{{ 'product.unavailable' | t }}"
                    {% unless current_variant.available %}disabled{% endunless %}>
                    {%- if current_variant.available -%}{{ 'product.add_to_cart' | t }} · {{ current_variant.price | money }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
                  </button>
                  {%- endif -%}
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
                {%- if block.settings.show_installments -%}
                  <div class="product__installments">{{ form | payment_terms }}</div>
                {%- endif -%}
              {%- endform -%}
              {%- if section.settings.pdp_v2 -%}
                {%- comment -%} 4 lines with ✓ under the button (docs/ficha-producto-plan.md) {%- endcomment -%}
                <ul class="pdc-checks">
                  <li>{{ 'product.check_made' | t }}</li>
                  <li>{{ 'product.check_delivery' | t: min: settings.delivery_min, max: settings.delivery_max }}</li>
                  {%- if settings.free_shipping_threshold > 0 -%}<li>{{ 'product.check_free_ship' | t: threshold: settings.free_shipping_threshold }}</li>{%- endif -%}
                  <li><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">{{ 'product.check_returns' | t }}</a></li>
                </ul>
              {%- elsif settings.free_shipping_threshold > 0 -%}
                {%- comment -%}
                  The shipping rule next to the button, from the theme settings (one source): prints and
                  framed prints have the flat rate of their Shopify delivery profiles; canvases have their
                  own rates per size, so for a canvas it says the price is shown at checkout.
                  theme.js swaps the two lines when the finish changes. Only for the shop currency.
                {%- endcomment -%}
                {%- assign threshold_money = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros -%}
                {%- assign cv_t = current_variant.title | downcase -%}
                {%- assign is_canvas = false -%}
                {%- comment -%} Since 13/11/2026 every variant, canvas included, is in the one flat-rate profile: no separate canvas line {%- endcomment -%}
                {%- assign canvas_own_rate = false -%}
                {%- if canvas_own_rate -%}{%- if cv_t contains 'canvas' or cv_t contains 'lienzo' -%}{%- assign is_canvas = true -%}{%- endif -%}{%- endif -%}
                {%- if cart.currency.iso_code == shop.currency -%}
                  <p class="product__ship-hint" data-ship-rule{% unless canvas_own_rate %} data-flat{% endunless %}>
                    <span data-ship-rule-print{% if is_canvas %} hidden{% endif %}>
                      {%- if settings.shipping_rate_print != blank -%}{{ 'product.ship_rule' | t: rate: settings.shipping_rate_print, threshold: threshold_money }}{%- else -%}{{ 'product.ship_rule_nofee' | t: threshold: threshold_money }}{%- endif -%}
                    </span>
                    <span data-ship-rule-canvas{% unless is_canvas %} hidden{% endunless %}>{{ 'product.ship_rule_canvas' | t: threshold: threshold_money }}</span>
                    {%- capture gift_flag -%}{% render 'gift-on' %}{%- endcapture -%}{%- if gift_flag == '1' -%}{%- assign gift_money = settings.gift_tier1 | times: 100 | money_without_trailing_zeros %} · {{ 'product.gift_from' | t: amount: gift_money }}{%- endif -%}
                  </p>
                {%- endif -%}
              {%- elsif settings.shipping_message != blank -%}
                <p class="product__ship-hint">{{ settings.shipping_message }}{% if settings.shipping_details != blank %}<span class="product__ship-sub">{{ settings.shipping_details }}</span>{% endif %}</p>
              {%- endif -%}
            </div>
            {%- comment -%} Illustrations: «other styles» after the button, out of the way of the 4 steps {%- endcomment -%}
            {%- if simple_picker -%}{%- render 'pz-styles-strip', product: product -%}{%- endif -%}

          {%- when 'custom_guard' -%}
            {%- comment -%} Personalízalo: quality notice + required image-rights checkbox (recorded as a line item property). {%- endcomment -%}
            <div class="cguard" data-cguard data-min-ppi="{{ block.settings.min_ppi }}" data-good-ppi="300"
              data-low-text="{{ 'product.cguard_low' | t | escape }}" data-mid-text="{{ 'product.cguard_mid' | t | escape }}" data-ok-text="{{ 'product.cguard_ok' | t | escape }}" {{ block.shopify_attributes }}>
              {%- assign show_upload = block.settings.upload -%}
              {%- if product.tags contains 'plantilla' -%}{%- assign show_upload = false -%}{%- endif -%}
              {%- if show_upload -%}
                <p class="vstep__head cguard__head"><span class="vstep__num">1</span><span class="vstep__title">{{ 'product.upload_step' | t }}</span></p>
              {%- elsif block.settings.heading != blank -%}<p class="cguard__title">{{ block.settings.heading }}</p>{%- endif -%}
              {%- if block.settings.notice != blank -%}<p class="cguard__notice">{{ block.settings.notice }}</p>{%- endif -%}
              {%- if show_upload -%}
                <div class="cupload" data-change-text="{{ 'product.upload_change' | t | escape }}" data-meta-text="{{ 'product.upload_meta' | t | escape }}">
                  {%- comment -%} Big square with «+» (the photo shows in it once chosen), wide black button, formats below {%- endcomment -%}
                  <label class="cupload__drop cupload__drop--big" for="Upload-{{ section.id }}">
                    <input class="cupload__input" id="Upload-{{ section.id }}" type="file" name="properties[Imagen]" form="{{ form_id }}" accept="image/jpeg,image/png" required data-cupload>
                    <img class="cupload__mini" alt="" data-cupload-mini hidden>
                    <span class="cupload__icon" aria-hidden="true">+</span>
                  </label>
                  <label class="button cupload__btn" for="Upload-{{ section.id }}"><span aria-hidden="true">+</span> <span data-cupload-label>{{ 'product.upload_cta' | t }}</span></label>
                  <p class="cupload__hint cupload__hint--below">{{ 'product.upload_hint' | t }}</p>
                  <div class="cupload__preview" data-cupload-preview hidden>
                    <div class="cupload__wall">
                      <div class="cupload__frame" data-cupload-frame><img alt="" width="600" height="800" data-cupload-img></div>
                    </div>
                    <p class="cupload__meta" data-cupload-meta></p>
                  </div>
                  {%- comment -%} A sangre / con borde blanco: saved in the order as «Borde»; the preview shows the margin {%- endcomment -%}
                  <div class="tstudio__opts cupload__border" role="radiogroup" aria-label="Acabado de la imagen">
                    <span class="tstudio__opts-label">Acabado de la imagen</span>
                    <label class="tstudio__font"><input type="radio" name="properties[Borde]" value="A sangre" form="{{ form_id }}" checked><span>A sangre</span></label>
                    <label class="tstudio__font"><input type="radio" name="properties[Borde]" value="Con borde blanco" form="{{ form_id }}" data-white data-bd="#ffffff"><span>Blanco</span></label>
                    <label class="tstudio__font"><input type="radio" name="properties[Borde]" value="Con borde negro" form="{{ form_id }}" data-white data-bd="#141414"><span>Negro</span></label>
                    <label class="tstudio__font"><input type="radio" name="properties[Borde]" value="Con borde arena" form="{{ form_id }}" data-white data-bd="#efe8dc"><span>Arena</span></label>
                  </div>
                  {%- if block.settings.text_option -%}{% render 'photo-text', form_id: form_id %}{%- endif -%}
                </div>
              {%- endif -%}
              {%- if show_upload -%}
                <script>
                  (function () {
                    /* The uploaded photo (with frame, border and text) also shows big in the gallery, first,
                       in the frame chosen in Tipo · Tamaño · Marco; and it is hung in the room photos */
                    var guard = document.currentScript.closest('[data-cguard]');
                    var wall = guard && guard.querySelector('.cupload__wall');
                    if (!wall) return;
                    var KIND = { negro: 'black', blanco: 'white', madera: 'wood' };
                    var COLOR = { black: '#151515', white: '#fbfbfa', wood: '#b98d5e' };
                    /* the picker comes after this block in the page: look it up when needed */
                    var kind = function () { var pdc = document.querySelector('[data-pdc]'); return (pdc && KIND[pdc.dataset.frame]) || 'none'; };
                    var media = null, handle = null, thumb = null, photoUrl = '';
                    var crop = { x: 50, y: 50, z: 1 };
                    var photoFilter = 'Original';
                    var editor = null;
                    var modal = null, modalView = null;
                    /* border: colour of the chosen «Borde» (none = full bleed); a text goes in a wider margin */
                    var bdInput = function () { return guard.querySelector('input[name="properties[Borde]"][data-white]:checked'); };
                    var bdColor = function () { var i = bdInput(); return (i && i.dataset.bd) || '#ffffff'; };
                    var capPos = function () {
                      var tx = document.getElementById('PhotoText');
                      if (!bdInput() || !tx || !tx.value.trim()) return '';
                      var top = document.querySelector('input[name="properties[Posición del texto]"][value="Arriba"]:checked');
                      return top ? 'top' : 'bottom';
                    };
                    var dressFrame = function (fr) {
                      if (!fr) return;
                      /* only real changes: the wall is watched for changes and would loop */
                      var on = !!bdInput(), col = bdColor(), cap = capPos();
                      if (fr.classList.contains('has-white') !== on) fr.classList.toggle('has-white', on);
                      if (fr.style.getPropertyValue('--bd') !== col) fr.style.setProperty('--bd', col);
                      if ((fr.dataset.cap || '') !== cap) fr.dataset.cap = cap;
                      /* canvas: the outer band of the photo wraps round the sides of the stretcher */
                      var pd = document.querySelector('[data-pdc]');
                      var cv = !!(pd && pd.dataset.curType === 'lienzo');
                      if (fr.classList.contains('is-canvas') !== cv) fr.classList.toggle('is-canvas', cv);
                    };
                    var fbar = null, qmodal = null, photoW = 0, photoH = 0;
                    var placeBar = function () {
                      if (!fbar) return;
                      var gal = document.querySelector('.product__gallery');
                      if (!gal) return;
                      if (window.matchMedia('(min-width: 990px)').matches) { if (fbar.parentElement !== gal) gal.appendChild(fbar); }
                      else if (fbar.previousElementSibling !== gal) gal.parentNode.insertBefore(fbar, gal.nextSibling);
                    };
                    /* Print quality by size: pixels per inch of the photo at that size (long and short side).
                       A wall print is seen from a distance: about 85 ppi or more prints sharp. */
                    var sizeOf = function (txt) {
                      var m = String(txt || '').replace(/,/g, '.').match(/(\d+(?:\.\d+)?)\s*[x×]\s*(\d+(?:\.\d+)?)/i);
                      return m ? [parseFloat(m[1]), parseFloat(m[2])] : null;
                    };
                    var rate = function (sz) {
                      if (!photoW || !sz) return '';
                      var L = Math.max(sz[0], sz[1]) / 2.54, S = Math.min(sz[0], sz[1]) / 2.54;
                      var ppi = Math.min(Math.max(photoW, photoH) / L, Math.min(photoW, photoH) / S);
                      return ppi >= 85 ? 'ok' : ppi >= 60 ? 'good' : ppi >= 33 ? 'mid' : 'low';
                    };
                    var fmt = function (sz) { return sz.map(function (n) { return String(Math.round(n * 10) / 10).replace('.', ','); }).join('×') + ' cm'; };
                    var renderQuality = function () {
                      if (!fbar) return;
                      var sel = document.querySelector('[data-pdc-size]');
                      var opts = sel ? [].slice.call(sel.options).filter(function (o) { return o.value; }) : [];
                      var sizes = []; var seen = {};
                      opts.forEach(function (o) { var s = sizeOf(o.value); if (s && !seen[fmt(s)]) { seen[fmt(s)] = 1; sizes.push(s); } });
                      if (!sizes.length) sizes = [[21, 29.7], [29.7, 42], [42, 59.4], [50, 70], [59.4, 84.1], [60, 90]];
                      var chosen = sel && sel.value ? sizeOf(sel.value) : sizes[0];
                      var lvl = rate(chosen);
                      fbar.querySelector('.fbar__q').dataset.level = lvl;
                      if (qmodal) {
                        var ICON = { ok: '✓', good: '–', mid: '×', low: '×' };
                        qmodal.querySelector('[data-qlist]').innerHTML = sizes.map(function (s) {
                          var l = rate(s); return '<li data-level="' + l + '"><i>' + (ICON[l] || '') + '</i><b>' + fmt(s) + '</b></li>';
                        }).join('');
                      }
                    };
                    /* the controls live either under the photo or in the edit window */
                    var ed = function (sel) { return (editor && editor.querySelector(sel)) || (modal && modal.querySelector(sel)); };
                    var edAll = function (sel) { var a = []; if (editor) a = a.concat([].slice.call(editor.querySelectorAll(sel))); if (modal) a = a.concat([].slice.call(modal.querySelectorAll(sel))); return a; };
                    var openModal = function () {
                      if (!modal) return;
                      modal.hidden = false;
                      document.documentElement.classList.add('has-fmodal');
                      var ok = modal.querySelector('[data-fok]'); if (ok) ok.focus({ preventScroll: true });
                    };
                    var closeModal = function () {
                      if (!modal) return;
                      modal.hidden = true;
                      document.documentElement.classList.remove('has-fmodal');
                      paintRoomsSoon();
                    };
                    /* Where the frame hangs in each room photo (% of the photo: left, top, width, height, outer frame) */
                    var ROOMS = [
                      [/ en un salón de Navidad$/i, [31.49, 12.64, 33.61, 39.09]],
                      [/ en un despacho$/i, [26.52, 25.21, 35.82, 32.8]],
                      [/ en un salón con sofá$/i, [34.25, 15.06, 31.22, 32.11]],
                      [/ en un salón con sillones$/i, [27.26, 13.19, 32.23, 33.77]],
                      [/ en un salón$/i, [41.72, 24, 29.22, 29.73]],
                      [/ en un dormitorio$/i, [37.75, 16.93, 24.83, 28.93]],
                      [/ en un estudio$/i, [34.77, 13.2, 36.26, 37.47]]
                    ];
                    var roomOf = function (img) {
                      for (var k = 0; k < ROOMS.length; k++) if (ROOMS[k][0].test(img.alt || '')) return ROOMS[k][1];
                      return null;
                    };
                    var paintRooms = function () {
                      if (!photoUrl) return;
                      var white = !!guard.querySelector('input[name="properties[Borde]"][data-white]:checked');
                      var art = new Image();
                      art.onload = function () {
                        document.querySelectorAll('.product__gallery > .product__media > img').forEach(function (img) {
                          var r = roomOf(img);
                          if (!r) return;
                          var m = img.parentElement;
                          var draw = function () {
                            if (!img.naturalWidth) return;
                            /* the gallery may have loaded a small version of the room: fetch a big one (once) so the result is sharp */
                            if (img.naturalWidth < 1000 && !img._hi) {
                              var hi = new Image();
                              img._hi = hi;
                              hi.onload = draw;
                              hi.onerror = function () { img._hi = img; draw(); };
                              var u = img.currentSrc || img.src;
                              hi.src = /[?&]width=\d+/.test(u) ? u.replace(/([?&]width=)\d+/, '$11400') : u + (u.indexOf('?') < 0 ? '?' : '&') + 'width=1400';
                              return;
                            }
                            var bg = (img._hi && img._hi.naturalWidth) ? img._hi : img;
                            if (img._hi && !img._hi.complete) { img._hi.onload = draw; return; }
                            var c = m.querySelector('canvas.tart');
                            if (!c) { c = document.createElement('canvas'); c.className = 'tart'; c.setAttribute('role', 'img'); m.appendChild(c); }
                            c.setAttribute('aria-label', img.alt);
                            /* draw at the screen's real resolution (retina), not the room photo's, so the customer's photo stays sharp */
                            var bw = bg.naturalWidth, bh = bg.naturalHeight;
                            var shown = m.clientWidth || window.innerWidth || bw;
                            var S = Math.min(3, Math.max(1, shown * (window.devicePixelRatio || 1) / bw));
                            c.width = Math.round(bw * S); c.height = Math.round(bh * S);
                            var g = c.getContext('2d');
                            g.imageSmoothingEnabled = true; g.imageSmoothingQuality = 'high';
                            g.drawImage(bg, 0, 0, c.width, c.height);
                            var x = r[0] / 100 * c.width, y = r[1] / 100 * c.height, w = r[2] / 100 * c.width, h = r[3] / 100 * c.height;
                            var k = kind();
                            if (k !== 'none') {
                              /* the frame in the chosen colour, then the photo inside */
                              g.fillStyle = COLOR[k]; g.fillRect(x, y, w, h);
                              var f = Math.min(w, h) * 0.035; x += f; y += f; w -= f * 2; h -= f * 2;
                            }
                            if (white) {
                              g.fillStyle = bdColor(); g.fillRect(x, y, w, h);
                              var mg = Math.min(w, h) * 0.06; x += mg; y += mg; w -= mg * 2; h -= mg * 2;
                            }
                            /* same framing as the big preview: moved (crop.x, crop.y) and zoomed (crop.z) */
                            var s = Math.max(w / art.naturalWidth, h / art.naturalHeight) * crop.z;
                            /* big phone photos shrunk in one go look jagged: halve them step by step first */
                            var src = art, sc = 1;
                            while (s * sc < 0.5 && src.width > 64) {
                              var hc = document.createElement('canvas');
                              hc.width = Math.round(src.width / 2); hc.height = Math.round(src.height / 2);
                              var hg = hc.getContext('2d'); hg.imageSmoothingQuality = 'high';
                              hg.drawImage(src, 0, 0, hc.width, hc.height);
                              src = hc; sc *= 2;
                            }
                            var sw = w / s / sc, sh = h / s / sc;
                            var SW = src.width || src.naturalWidth, SH = src.height || src.naturalHeight;
                            if (filterCss() !== 'none') g.filter = filterCss();
                            g.drawImage(src, (SW - sw) * crop.x / 100, (SH - sh) * crop.y / 100, sw, sh, x, y, w, h);
                            g.filter = 'none';
                            img.hidden = true;
                          };
                          img.loading = 'eager';
                          if (img.complete) draw(); else img.addEventListener('load', draw, { once: true });
                        });
                      };
                      art.src = photoUrl;
                    };
                    var sync = function () {
                      if (!media) return;
                      var copy = wall.cloneNode(true);
                      copy.removeAttribute('data-cupload-wall');
                      var fr = copy.querySelector('[data-cupload-frame]');
                      if (fr) { fr.dataset.kind = kind(); turn(fr); dressFrame(fr); }
                      dressFrame(wall.querySelector('[data-cupload-frame]'));
                      turn(wall.querySelector('[data-cupload-frame]'));
                      media.replaceChildren(copy);
                      if (modalView) {
                        var c2 = wall.cloneNode(true);
                        c2.removeAttribute('data-cupload-wall');
                        var f2 = c2.querySelector('[data-cupload-frame]');
                        if (f2) { f2.dataset.kind = kind(); turn(f2); dressFrame(f2); }
                        modalView.replaceChildren(c2);
                      }
                      var src = wall.querySelector('[data-cupload-img]');
                      if (thumb && src) thumb.src = src.src;
                    };
                    var start = function () {
                      if (media || !window.arsnoirGallery) return;
                      media = document.createElement('div');
                      media.className = 'product__media--upload';
                      thumb = document.createElement('img');
                      thumb.alt = '';
                      handle = window.arsnoirGallery.add(media, thumb);
                      sync();
                      new MutationObserver(sync).observe(wall, { subtree: true, attributes: true, childList: true, characterData: true });
                      /* The example photos of the husky go: from now on only the customer's photo and its rooms */
                      document.querySelectorAll('.product__gallery > .product__media > img').forEach(function (img) {
                        if (/ con marco negro$|, la obra$/i.test(img.alt || '')) img.parentElement.hidden = true;
                      });
                      buildEditor();
                    };
                    /* Under the photo: move / zoom it inside the frame, write a text, and how well it will print */
                    var applyCrop = function () {
                      var src = wall.querySelector('[data-cupload-img]');
                      if (src) {
                        src.style.objectPosition = crop.x + '% ' + crop.y + '%';
                        src.style.transformOrigin = crop.x + '% ' + crop.y + '%';
                        src.style.transform = crop.z > 1 ? 'scale(' + crop.z + ')' : '';
                        src.style.filter = filterCss() === 'none' ? '' : filterCss();
                      }
                      window.arsnoirCrop = crop;
                      document.dispatchEvent(new CustomEvent('arsnoir:crop'));
                      if (!editor) return;
                      var moved = crop.x !== 50 || crop.y !== 50 || crop.z !== 1;
                      var prop = editor.querySelector('[data-crop-prop]');
                      prop.disabled = !moved;
                      prop.value = 'Horizontal ' + Math.round(crop.x) + ' % · Vertical ' + Math.round(crop.y) + ' % · Zoom ' + crop.z.toFixed(2) + '×';
                      var rb = ed('[data-crop-reset]'); if (rb) rb.hidden = !moved;
                    };
                    var placeEditor = function () {
                      if (!editor) return;
                      /* in the right column, right above Tipo · Tamaño · Marco and the button (like one grouped block) */
                      var upBox = guard.querySelector('.cupload');
                      if (upBox && editor.previousElementSibling !== upBox) upBox.parentNode.insertBefore(editor, upBox.nextSibling);
                    };
                    /* Photo filters: the same CSS filter on the preview, the rooms and the print file */
                    var FILTERS = [['Original', 'none'], ['Blanco y negro', 'grayscale(1)'], ['Cálido', 'sepia(.22) saturate(1.15) brightness(1.02)'],
                      ['Frío', 'saturate(.9) hue-rotate(-10deg) brightness(1.04)'], ['Suave', 'contrast(.9) brightness(1.06) saturate(.9)'], ['Intenso', 'contrast(1.15) saturate(1.25)']];
                    var filterCss = function () { for (var k = 0; k < FILTERS.length; k++) if (FILTERS[k][0] === photoFilter) return FILTERS[k][1]; return 'none'; };
                    var orient = '';
                    var buildEditor = function () {
                      if (editor) return;
                      editor = document.createElement('div');
                      editor.className = 'fedit';
                      guard.classList.add('has-fedit');
                      var ico = function (d) { return '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="' + d + '" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>'; };
                      var filters = FILTERS.map(function (f) {
                        return '<button type="button" class="fedit__flt' + (f[0] === 'Original' ? ' is-on' : '') + '" data-filter="' + f[0] + '"><img alt="" style="filter:' + f[1] + '"><span>' + f[0] + '</span></button>';
                      }).join('');
                      editor.innerHTML =
                        '<div class="fedit__q" data-q hidden><div class="fedit__qhead"><b>Calidad de impresión</b><span data-q-label></span></div>' +
                        '<div class="fedit__bar"><span data-q-fill></span></div><p class="fedit__qtext" data-q-text></p></div>' +
                        '<div class="fedit__ctrls"><div class="fedit__zoomrow">' + ico('M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM20 20l-4.8-4.8M7.5 10.5h6') +
                        '<input type="range" min="1" max="2.5" step="0.05" value="1" aria-label="Zoom" data-crop-zoom>' + ico('M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM20 20l-4.8-4.8M7.5 10.5h6M10.5 7.5v6') + '</div>' +
                        '<div class="fedit__tools">' +
                        '<button type="button" class="fedit__tool" data-orient="v">' + ico('M8 3h8v18H8z') + '<span>Vertical</span></button>' +
                        '<button type="button" class="fedit__tool" data-orient="h">' + ico('M3 8h18v8H3z') + '<span>Horizontal</span></button>' +
                        '<button type="button" class="fedit__tool" data-rotate>' + ico('M4 12a8 8 0 1 0 2.3-5.7M4 4v4h4') + '<span>Girar</span></button>' +
