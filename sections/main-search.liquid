<section class="page-width">
  {%- capture search_title -%}{% if search.performed %}«{{ search.terms }}»{% else %}{{ 'search.title' | t }}{% endif %}{%- endcapture -%}
  {%- capture search_sub -%}{% if search.performed %}{{ 'search.results' | t: count: search.results_count }}{% endif %}{%- endcapture -%}
  {%- assign search_eyebrow = 'search.eyebrow' | t -%}
  {% render 'page-head', eyebrow: search_eyebrow, title: search_title, subtitle: search_sub, crumbs: true %}

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-bar reveal">
    <input type="hidden" name="type" value="product">
    <label for="Search" class="visually-hidden">{{ 'search.title' | t }}</label>
    {% render 'icon', name: 'search' %}
    <input id="Search" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autofocus>
    <button class="button" type="submit">{{ 'search.title' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count > 0 -%}
        <ul class="product-grid collection-grid-art">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <li class="reveal">{% render 'product-card', product: item, index: forloop.index %}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="empty-note">
          <p class="empty-note__title">{{ 'search.no_results' | t: terms: search.terms }}</p>
          <p class="empty-note__text">{{ 'search.no_results_hint' | t }}</p>
          <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.see_all_works' | t }}</a>
        </div>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {%- if paginate.previous -%}<a class="round-btn" href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}">&larr;</a>{%- endif -%}
          <span class="current">{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="round-btn" href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}">&rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Búsqueda", "settings": [] }
{% endschema %}
