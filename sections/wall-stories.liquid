{%- comment -%}
  «Tu pared podría ser la siguiente» as customer stories: tall story cards (like Instagram stories).
  Tap one and it opens full screen, with progress bars, the review and a button to the artwork.
  - A card with a review = a REAL customer (photo of their wall + their Judge.me review, with their OK).
  - A card without a review = a styled room photo, and it says so on the card («Imagen de ambiente»).
  - The last card invites customers to send the photo of their wall.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section wstories" id="WallStories-{{ section.id }}">
  <div class="page-width">
    <header class="wstories__head">
      {%- if s.eyebrow != blank -%}<p class="wstories__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="wstories__title">{{ s.heading | newline_to_br }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="wstories__text">{{ s.text }}</p>{%- endif -%}
    </header>
  </div>

  {%- if request.design_mode -%}<p class="page-width wst__editor-note">👀 Solo lo ves tú en el editor: reseñas de EJEMPLO para ver el diseño. Los clientes ven solo las reseñas reales.</p>{%- endif -%}
  <div class="wst-row" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign p = b.product
        assign url = p.url | default: routes.all_products_collection_url
        assign label = b.caption | default: p.title
        assign is_review = false
        if b.quote != blank
          assign is_review = true
        endif
        assign img = b.image | default: p.featured_media
        # Theme editor only (request.design_mode): sample reviews so the layout can be judged.
        # Customers never see them.
        assign sample = false
        if is_review == false and request.design_mode
          assign sample = true
          assign is_review = true
          assign sample_quotes = 'Queda precioso en el salón, los colores son tal cual la vista previa.|Lo regalé por su cumpleaños y lloró de la emoción. Llegó muy bien embalado.|La calidad del marco me sorprendió, se ve mucho más caro de lo que es.|Me encanta cómo quedó mi perro, todo el mundo me pregunta dónde lo compré.|Fácil de pedir y llegó en una semana. Repetiré seguro.|El tamaño A3 es perfecto encima del sofá.' | split: '|'
          assign sample_names = 'Laura M.|Carlos R.|Marta G.|Javier P.|Lucía S.|Andrea V.' | split: '|'
          assign si = forloop.index0 | modulo: 6
        endif
      -%}
      <div class="wst" role="listitem" {{ block.shopify_attributes }}>
        <button type="button" class="wst__card{% if is_review %} wst__card--review{% endif %}" data-wst-open="{{ forloop.index0 }}" aria-label="{{ label | escape }}{% if is_review %}, reseña de {{ b.author | escape }}{% endif %}">
          <span class="wst__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 22vw, 62vw', alt: '' }}
            {%- endif -%}
          </span>
          <span class="wst__top">
            {%- if is_review -%}
              {%- if sample -%}{%- assign r_author = sample_names[si] | append: ' · EJEMPLO' -%}{%- assign r_rating = 5 -%}{%- else -%}{%- assign r_author = b.author -%}{%- assign r_rating = b.rating -%}{%- endif -%}
              <span class="wst__who"><span class="wst__avatar" aria-hidden="true">{{ r_author | slice: 0 }}</span>{{ r_author }}</span>
              <span class="wst__stars" aria-hidden="true">{% for i in (1..5) %}<span{% if i > r_rating %} class="is-off"{% endif %}>★</span>{% endfor %}</span>
            {%- else -%}
              <span class="wst__tag">Imagen de ambiente</span>
            {%- endif -%}
          </span>
          <span class="wst__bottom">
            {%- if is_review -%}<span class="wst__quote">«{% if sample %}{{ sample_quotes[si] }}{% else %}{{ b.quote }}{% endif %}»</span>{%- endif -%}
            <span class="wst__name">{{ label }}</span>
            {%- if p != blank -%}<span class="wst__price">{% render 'price', product: p, show_from: true %}</span>{%- endif -%}
          </span>
        </button>
        {%- comment -%}
          Under each story: this artwork's REAL Judge.me rating, read from the badge Judge.me keeps on
          the product. With no reviews yet it only invites to write the first one. Nothing is invented.
        {%- endcomment -%}
        {%- if p != blank -%}
          {%- liquid
            assign jm = p.metafields.judgeme.badge | append: ''
            assign jm_n = 0
            assign jm_avg = '0'
            if jm contains 'data-number-of-reviews='
              assign jm_n = jm | split: 'data-number-of-reviews=' | last | remove: '"' | remove: "'" | split: ' ' | first | split: '>' | first | plus: 0
              assign jm_avg = jm | split: 'data-average-rating=' | last | remove: '"' | remove: "'" | split: ' ' | first | split: '>' | first
            endif
            assign jm_avg_n = jm_avg | plus: 0
            assign jm_full = jm_avg_n | round
          -%}
          {%- if jm_n == 0 and request.design_mode -%}{%- assign jm_n = 12 -%}{%- assign jm_avg_n = 4.9 -%}{%- assign jm_full = 5 -%}{%- assign jm_sample = true -%}{%- else -%}{%- assign jm_sample = false -%}{%- endif -%}
          <a class="wst__rev{% if jm_n == 0 %} wst__rev--none{% endif %}" href="{{ p.url }}#Reviews">
            {%- if jm_n > 0 -%}
              <span class="wst__rev-stars" aria-hidden="true">{% for i in (1..5) %}<span{% if i > jm_full %} class="is-off"{% endif %}>★</span>{% endfor %}</span>
              <span class="wst__rev-txt"><b>{{ jm_avg_n | round: 1 | replace: '.', ',' }}</b> · {{ jm_n }} {% if jm_n == 1 %}reseña{% else %}reseñas{% endif %}{% if jm_sample %} · EJEMPLO{% endif %}</span>
            {%- else -%}
              <span class="wst__rev-txt">Aún sin reseñas · <u>Sé el primero en opinar</u> →</span>
            {%- endif -%}
          </a>
        {%- endif -%}
        {%- comment -%} Data for the full-screen viewer {%- endcomment -%}
        <template data-wst-item>
          <div class="wstv__slide"
            data-url="{{ url }}"
            data-label="{{ label | escape }}"
            data-review="{{ is_review }}"
            data-author="{% if sample %}{{ sample_names[si] }} · EJEMPLO{% else %}{{ b.author | escape }}{% endif %}"
            data-verified="{% if sample %}false{% else %}{{ b.verified }}{% endif %}"
            data-rating="{% if sample %}5{% else %}{{ b.rating }}{% endif %}">
            {%- if img != blank -%}{{ img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '720, 1080, 1400', sizes: '100vw', alt: label }}{%- endif -%}
            {%- if is_review -%}<p class="wstv__quote">«{% if sample %}{{ sample_quotes[si] }}{% else %}{{ b.quote }}{% endif %}»</p>{%- endif -%}
          </div>
        </template>
      </div>
    {%- endfor -%}

    {%- if s.upload_title != blank -%}
      <div class="wst" role="listitem">
        <a class="wst__card wst__card--upload" href="{{ s.upload_link | default: '/pages/contacto' }}">
          <span class="wst__plus" aria-hidden="true">+</span>
          <span class="wst__up-title">{{ s.upload_title }}</span>
          {%- if s.upload_text != blank -%}<span class="wst__up-text">{{ s.upload_text }}</span>{%- endif -%}
          {%- if s.upload_button != blank -%}<span class="wst__up-btn">{{ s.upload_button }}</span>{%- endif -%}
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Full-screen story viewer (filled from the templates above) {%- endcomment -%}
  <div class="wstv" data-wst-viewer hidden role="dialog" aria-modal="true" aria-label="Historias de paredes">
    <div class="wstv__frame">
      <div class="wstv__bars" data-wst-bars></div>
      <div class="wstv__head">
        <span class="wstv__who" data-wst-who></span>
        <button type="button" class="wstv__close" data-wst-close aria-label="Cerrar">×</button>
      </div>
      <div class="wstv__stage" data-wst-stage></div>
      <button type="button" class="wstv__nav wstv__nav--prev" data-wst-prev aria-label="Anterior"></button>
      <button type="button" class="wstv__nav wstv__nav--next" data-wst-next aria-label="Siguiente"></button>
      <div class="wstv__foot">
        <a class="wstv__cta" data-wst-cta href="#">Ver la obra →</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('WallStories-{{ section.id }}');
    if (!root) return;
    var viewer = root.querySelector('[data-wst-viewer]');
    var stage = root.querySelector('[data-wst-stage]');
    var bars = root.querySelector('[data-wst-bars]');
    var who = root.querySelector('[data-wst-who]');
    var cta = root.querySelector('[data-wst-cta]');
    var items = Array.prototype.map.call(root.querySelectorAll('template[data-wst-item]'), function (t) { return t; });
    var cur = 0, timer = null, DUR = 5000;

    function stars(n) { var s = ''; for (var i = 1; i <= 5; i++) s += i <= n ? '★' : '☆'; return s; }
    function show(i) {
      if (i < 0) i = 0;
      if (i >= items.length) { close(); return; }
      cur = i;
      stage.innerHTML = '';
      stage.appendChild(items[i].content.cloneNode(true));
      var slide = stage.firstElementChild;
      var img = slide.querySelector('img'); if (img) img.loading = 'eager';
      var isReview = slide.dataset.review === 'true';
      who.textContent = isReview
        ? slide.dataset.author + ' · ' + stars(parseInt(slide.dataset.rating, 10) || 5) + (slide.dataset.verified === 'true' ? ' · Compra verificada' : '')
        : 'Imagen de ambiente';
      cta.href = slide.dataset.url;
      cta.textContent = 'Ver «' + slide.dataset.label + '» →';
      Array.prototype.forEach.call(bars.children, function (b, k) {
        b.className = 'wstv__bar' + (k < i ? ' is-done' : k === i ? ' is-on' : '');
      });
      clearTimeout(timer);
      timer = setTimeout(function () { show(cur + 1); }, DUR);
    }
    function open(i) {
      bars.innerHTML = items.map(function () { return '<span class="wstv__bar"><i></i></span>'; }).join('');
      bars.style.setProperty('--wst-dur', DUR + 'ms');
      viewer.hidden = false;
      document.documentElement.classList.add('wst-lock');
      show(i);
    }
    function close() {
      clearTimeout(timer);
      viewer.hidden = true;
      stage.innerHTML = '';
      document.documentElement.classList.remove('wst-lock');
    }
    root.addEventListener('click', function (e) {
      var o = e.target.closest('[data-wst-open]');
      if (o) { open(parseInt(o.dataset.wstOpen, 10) || 0); return; }
      if (e.target.closest('[data-wst-close]')) { close(); return; }
      if (e.target.closest('[data-wst-next]')) { show(cur + 1); return; }
      if (e.target.closest('[data-wst-prev]')) { show(cur - 1); return; }
      if (e.target === viewer) close();
    });
    document.addEventListener('keydown', function (e) {
      if (viewer.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(cur + 1);
      if (e.key === 'ArrowLeft') show(cur - 1);
    });
  })();
</script>

{% schema %}
{
  "name": "Tu pared (historias)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "INSPIRACIÓN" },
    { "type": "textarea", "id": "heading", "label": "Titular (una línea por renglón)", "default": "Una buena decoración\nlo cambia todo.\nTu pared\npodría ser la siguiente." },
    { "type": "text", "id": "text", "label": "Texto", "default": "Ideas para cada rincón de tu casa. Toca una foto para verla en grande." },
    { "type": "text", "id": "note", "label": "(antiguo, sin uso)" },
    { "type": "header", "content": "Última tarjeta: «sube tu pared»" },
    { "type": "text", "id": "upload_title", "label": "Título", "default": "Tu pared aquí" },
    { "type": "textarea", "id": "upload_text", "label": "Texto", "default": "¿Ya tienes tu cuadro? Escribe tu reseña con una foto de tu pared en la ficha de tu obra, o mándanosla y la compartimos aquí (con tu permiso)." },
    { "type": "text", "id": "upload_button", "label": "Botón", "default": "Enviar mi foto" },
    { "type": "url", "id": "upload_link", "label": "Enlace del botón", "info": "Vacío = página de contacto." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Historia",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto (de la pared del cliente o de ambiente)" },
        { "type": "product", "id": "product", "label": "Obra que aparece" },
        { "type": "text", "id": "caption", "label": "Texto (vacío = nombre de la obra)" },
        { "type": "header", "content": "Reseña del cliente (solo reseñas reales)" },
        { "type": "paragraph", "content": "Copia aquí una reseña real de Judge.me y pon como foto la de la pared del cliente (con su permiso). Vacío = sale como «Imagen de ambiente»." },
        { "type": "textarea", "id": "quote", "label": "Texto de la reseña" },
        { "type": "text", "id": "author", "label": "Nombre (ej.: Laura M., Madrid)" },
        { "type": "range", "id": "rating", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Compra verificada en Judge.me", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Tu pared (historias)" }]
}
{% endschema %}
