<section class="page-width">
  <div class="collection-hero">
    <span class="eyebrow">Explorar</span>
    <h1>Secciones</h1>
  </div>

  <div class="collection-grid" style="--cols: 3; padding-bottom: clamp(48px, 8vw, 112px)">
    {%- for collection in collections -%}
      {%- if collection.handle == 'frontpage' or collection.handle == 'mas-vendidos' -%}{%- continue -%}{%- endif -%}
      <a class="collection-tile" href="{{ collection.url }}">
        <div class="collection-tile__media">
          {%- assign img = collection.featured_image -%}
          {%- if img != blank -%}
            {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 900px) 33vw, 50vw' }}
          {%- else -%}
            <div class="tile-ph" aria-hidden="true"><span>{{ collection.title }}</span></div>
          {%- endif -%}
        </div>
        <div class="collection-tile__info">
          <span class="collection-tile__title">{{ collection.title }}</span>
          <span class="collection-tile__count">{{ collection.products_count }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lista de secciones",
  "settings": []
}
{% endschema %}
