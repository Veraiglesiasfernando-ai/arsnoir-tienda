{%- comment -%}
  Customer reviews. Only real reviews should be added as blocks.
  With no blocks, sample reviews are shown ONLY inside the theme editor
  (request.design_mode) so the layout can be previewed; customers never see them.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign reviews = section.blocks | where: 'type', 'review'
  assign show_samples = false
  if reviews.size == 0 and request.design_mode
    assign show_samples = true
  endif
-%}

{%- if reviews.size > 0 or show_samples -%}
  {%- liquid
    if show_samples
      assign avg = '5'
      assign count = 3
    else
      assign total = 0
      for r in reviews
        assign total = total | plus: r.settings.rating
      endfor
      assign avg = total | times: 1.0 | divided_by: reviews.size | round: 1
      assign count = reviews.size
      if settings.rating_count > count and settings.rating_value != blank
        assign avg = settings.rating_value
        assign count = settings.rating_count
      endif
    endif
  -%}
  <section class="section reviews" id="Reviews">
    <div class="page-width">
      <div class="reviews__head">
        <div>
          {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ s.eyebrow }}</p>{%- endif -%}
          <h2 class="featured__title">{{ s.heading }}</h2>
        </div>
        <div class="reviews__summary">
          {% render 'stars', rating: avg, count: count %}
          {%- if show_samples -%}<p class="reviews__notice">Vista previa solo del editor: añade reseñas reales como bloques para mostrarlas en la tienda.</p>{%- endif -%}
        </div>
      </div>
    </div>

    <ul class="slider reviews__list" id="Reviews-{{ section.id }}">
      {%- if show_samples -%}
        {%- for i in (1..3) -%}
          <li class="slider__item review">
            {% render 'stars', rating: 5 %}
            <p class="review__text">Texto de ejemplo de una reseña. Sustitúyelo por la opinión real de un cliente sobre su obra.</p>
            <p class="review__author">Nombre del cliente · Ciudad</p>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in reviews -%}
          {%- assign r = block.settings -%}
          <li class="slider__item review" {{ block.shopify_attributes }}>
            {% render 'stars', rating: r.rating %}
            {%- if r.title != blank -%}<p class="review__title">{{ r.title }}</p>{%- endif -%}
            <p class="review__text">{{ r.text }}</p>
            <p class="review__author">
              {{ r.author }}{% if r.location != blank %} · {{ r.location }}{% endif %}
              {%- if r.verified %} <span class="review__verified">Compra verificada</span>{% endif -%}
            </p>
            {%- if r.product != blank -%}<a class="review__product" href="{{ r.product.url }}">{{ r.product.title }} &rarr;</a>{%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Reseñas",
  "settings": [
    { "type": "paragraph", "content": "Añade solo reseñas reales de clientes. Sin reseñas, la sección no aparece en la tienda (en el editor verás una vista previa de ejemplo)." },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "OPINIONES" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que dicen de sus paredes" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "range", "id": "rating", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Reseña" },
        { "type": "text", "id": "author", "label": "Nombre del cliente" },
        { "type": "text", "id": "location", "label": "Ciudad" },
        { "type": "checkbox", "id": "verified", "label": "Compra verificada", "default": true },
        { "type": "product", "id": "product", "label": "Obra comprada" }
      ]
    }
  ],
  "presets": [{ "name": "Reseñas" }]
}
{% endschema %}
