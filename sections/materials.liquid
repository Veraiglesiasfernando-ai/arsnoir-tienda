{%- comment -%}
  Materials: the four formats (poster, framed poster, canvas, framed canvas), each with a photo,
  a short text and a "from" price, with a button above to browse the works.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="mats">
  <div class="page-width">
    <div class="mats__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="mats__title">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="mats__text">{{ s.text }}</p>{%- endif -%}
      </div>
      {%- if s.button_label != blank and s.button_link != blank -%}
        <a class="button mats__btn" href="{{ s.button_link }}">{{ s.button_label }}</a>
      {%- endif -%}
    </div>
    <ul class="mats__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="mats__item reveal" {{ block.shopify_attributes }}>
          <div class="mats__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: b.title }}
            {%- endif -%}
          </div>
          <h3 class="mats__name">{{ b.title }}</h3>
          {%- if b.text != blank -%}<p class="mats__desc">{{ b.text }}</p>{%- endif -%}
          {%- if b.price != blank -%}<p class="mats__price">{{ b.price }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Materiales",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "MATERIALES" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige cómo la quieres" },
    { "type": "text", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver las obras" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "material",
      "name": "Material",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "title", "label": "Nombre", "default": "Póster" },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "text", "id": "price", "label": "Precio", "info": "Por ejemplo: Desde 24,95 €" }
      ]
    }
  ],
  "presets": [{ "name": "Materiales", "blocks": [{ "type": "material" }, { "type": "material" }, { "type": "material" }, { "type": "material" }] }]
}
{% endschema %}
