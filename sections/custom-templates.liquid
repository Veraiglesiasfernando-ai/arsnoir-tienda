{%- comment -%}
  Personalízalo: illustration styles. Each card shows the illustration (and optionally the
  original photo as "Antes") and links to its product page, where the photo-to-illustration
  app does the conversion. A block without a link
  is hidden on the live store; in the editor it shows as a placeholder.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign shown = 0
  for block in section.blocks
    if block.settings.link != blank or block.settings.image != blank or request.design_mode
      assign shown = shown | plus: 1
    endif
  endfor
-%}
{%- if shown > 0 -%}
<section class="ctpl" id="Plantillas">
  <div class="page-width">
    <div class="ctpl__head">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="ctpl__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="ctpl__text">{{ s.text }}</p>{%- endif -%}
      {%- if s.pets_note != blank -%}<p class="pets-ok pets-ok--center">{%- assign pets = s.pets_note | split: ',' -%}{%- for p in pets -%}<span>{{ p | strip }}</span>{%- endfor -%}</p>{%- endif -%}
    </div>
    {%- if s.video_url != blank -%}
      <div class="ctpl__video">
        <video data-src="{{ s.video_url }}" data-lazy-video muted loop playsinline preload="none"{% if s.video_poster != blank %} poster="{{ s.video_poster | image_url: width: 900 }}"{% endif %} aria-label="{{ s.heading | escape }}"></video>
      </div>
    {%- endif -%}
    {%- liquid
      # Theme tabs (Mascotas, Amor…) built from the blocks' "Tema" field, in order of appearance
      assign cats = ''
      for block in section.blocks
        if block.settings.link == blank and block.settings.image == blank and request.design_mode == false
          continue
        endif
        assign c = block.settings.category | strip
        if c != blank
          assign key = '|' | append: c | append: '|'
          assign check = '|' | append: cats | append: '|'
          unless check contains key
            if cats == ''
              assign cats = c
            else
              assign cats = cats | append: '|' | append: c
            endif
          endunless
        endif
      endfor
      assign cat_list = cats | split: '|'
    -%}
    {%- if cat_list.size > 1 and s.layout != 'sections' -%}
      <div class="ctpl__tabs" role="tablist" aria-label="{{ s.heading | escape }}" data-ctpl-tabs>
        <button type="button" class="ctpl__tab is-active" role="tab" aria-selected="true" data-cat="">{{ s.all_label }}</button>
        {%- for c in cat_list -%}
          <button type="button" class="ctpl__tab" role="tab" aria-selected="false" data-cat="{{ c | handleize }}">{{ c }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if s.layout == 'sections' and cat_list.size > 1 -%}
      {%- comment -%} One block per theme (Mascotas, Familia, Pareja…) with its own title; chips jump to each {%- endcomment -%}
      <nav class="ctpl__tabs ctpl__tabs--jump" aria-label="{{ s.heading | escape }}">
        {%- for c in cat_list -%}
          <a class="ctpl__tab" href="#ctpl-{{ c | handleize }}">{{ c }}</a>
        {%- endfor -%}
      </nav>
      {%- for c in cat_list -%}
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.link == blank and block.settings.image == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
          {%- assign bc = block.settings.category | strip -%}
          {%- if bc == c -%}{%- assign n = n | plus: 1 -%}{%- endif -%}
        {%- endfor -%}
        <div class="ctpl__group" id="ctpl-{{ c | handleize }}">
          <h3 class="ctpl__group-title">{{ c }}<span>{{ n }} {% if n == 1 %}estilo{% else %}estilos{% endif %}</span></h3>
          <ul class="ctpl__grid">
            {%- for block in section.blocks -%}
              {%- if block.settings.link == blank and block.settings.image == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
              {%- assign bc = block.settings.category | strip -%}
              {%- if bc == c -%}{%- render 'ctpl-card', block: block, s: s -%}{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    {%- else -%}
      <ul class="ctpl__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.link == blank and block.settings.image == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
          {%- render 'ctpl-card', block: block, s: s -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Ilustraciones",
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "ILUSTRACIONES" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu foto, convertida en ilustración" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Elige un estilo, sube tu foto y mírala convertida al momento." },
    { "type": "text", "id": "pets_note", "label": "Mascotas que valen (separadas por comas)", "default": "Perros, Gatos, Conejos, Y cualquier mascota", "info": "Se ven como etiquetas bajo el texto. Vacío para quitarlo." },
    { "type": "text", "id": "video_url", "label": "Vídeo «cómo funciona» (URL .mp4)", "info": "Archivo de Contenido → Archivos. Se ve encima de los estilos, en bucle y sin sonido." },
    { "type": "image_picker", "id": "video_poster", "label": "Imagen del vídeo mientras carga" },
    { "type": "select", "id": "layout", "label": "Cómo se agrupan", "default": "tabs", "options": [{ "value": "tabs", "label": "Pestañas (una cuadrícula)" }, { "value": "sections", "label": "Por secciones (Mascotas, Familia…)" }] },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Elegir estilo" },
    { "type": "text", "id": "all_label", "label": "Pestaña «todas»", "default": "Todas" },
    { "type": "text", "id": "before_label", "label": "Etiqueta de la foto original", "default": "Antes" },
    { "type": "text", "id": "soon_label", "label": "Etiqueta de estilos sin enlace", "default": "Muy pronto", "info": "Un estilo con foto pero sin enlace se ve como ejemplo, sin botón." },
    { "type": "text", "id": "no_link_label", "label": "Aviso sin enlace (solo en el editor)", "default": "Falta el enlace: oculta en la tienda" }
  ],
  "blocks": [
    {
      "type": "template",
      "name": "Estilo",
      "settings": [
        { "type": "text", "id": "category", "label": "Tema", "default": "Mascotas", "info": "Mascotas, Amor, Familia… Los estilos con el mismo tema se agrupan en una pestaña." },
        { "type": "text", "id": "name", "label": "Nombre", "default": "Estilo" },
        { "type": "text", "id": "tagline", "label": "Frase corta" },
        { "type": "image_picker", "id": "image", "label": "Ilustración de ejemplo" },
        { "type": "image_picker", "id": "before", "label": "Foto original del ejemplo (opcional)", "info": "Se ve pequeña en una esquina como «Antes»." },
        { "type": "url", "id": "link", "label": "Enlace a la ficha", "info": "Sin enlace ni foto, la tarjeta no se muestra en la tienda. Con foto y sin enlace, sale como ejemplo «Muy pronto»." }
      ]
    }
  ],
  "presets": [{ "name": "Ilustraciones" }]
}
{% endschema %}
