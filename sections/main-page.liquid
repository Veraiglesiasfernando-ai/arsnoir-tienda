<section class="page-width">
  {% render 'page-head', eyebrow: section.settings.eyebrow, title: page.title, crumbs: true %}
  <div class="story__card reveal">
    <div class="story__body rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Página",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño (rojo)", "default": "ARSNOIR" }
  ]
}
{% endschema %}
