{%- comment -%} Recently viewed artworks, from the visitor's browser (theme.js). Hidden until there is something to show. {%- endcomment -%}
<section class="section recent" data-recent data-limit="{{ section.settings.limit }}"{% if product %} data-current="{{ product.handle }}"{% endif %} hidden>
  <div class="page-width">
    <div class="featured__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="featured__title">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <ul class="product-grid collection-grid-art recent__grid" data-recent-grid></ul>
  </div>
</section>

{% schema %}
{
  "name": "Vistas recientemente",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "TU RECORRIDO" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Vistas recientemente" },
    { "type": "range", "id": "limit", "label": "Máximo de obras", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Vistas recientemente" }]
}
{% endschema %}
