{%- liquid
  assign s = section.settings
  assign nav_menu = linklists[s.sections_menu]
  assign title = collection.title
  if collection.handle == 'all'
    assign title = s.all_title
  endif
-%}

<section class="page-width collection-page">
  {% render 'page-head', eyebrow: s.eyebrow, title: title, subtitle: collection.description, crumbs: true %}

  {%- if s.show_nav -%}
    <nav class="collection-nav reveal" aria-label="{{ 'general.collections' | t }}">
      <a href="{{ routes.all_products_collection_url }}"{% if collection.handle == 'all' %} aria-current="page"{% endif %}>{{ 'collection.all' | t }}</a>
      {%- if nav_menu.links.size > 0 -%}
        {%- for link in nav_menu.links -%}
          <a href="{{ link.url }}"{% if link.url == collection.url %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- for c in collections -%}
          {%- if c.handle == 'frontpage' or c.handle == 'all' or c.handle == 'mas-vendidos' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
          <a href="{{ c.url }}"{% if c.handle == collection.handle %} aria-current="page"{% endif %}>{{ c.title }}</a>
        {%- endfor -%}
      {%- endif -%}
    </nav>
  {%- endif -%}

  {%- paginate collection.products by s.per_page -%}
    <form class="toolbar reveal" method="get" data-filter-form>
      <span class="toolbar__count">{{ 'general.works_count' | t: count: collection.products_count }}</span>

      <div class="toolbar__controls">
        {%- for filter in collection.filters -%}
          <details class="filter">
            <summary>
              {{ filter.label }}
              {%- if filter.active_values.size > 0 -%}<span class="filter__count">{{ filter.active_values.size }}</span>{%- endif -%}
            </summary>
            <div class="filter__panel">
              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  <div class="filter__price">
                    <label>{{ 'general.from' | t }} <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100 }}" placeholder="0" min="0"></label>
                    <label>{{ 'general.to' | t }} <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100 }}" placeholder="{{ filter.range_max | divided_by: 100 }}" min="0"></label>
                  </div>
                {%- else -%}
                  {%- for value in filter.values -%}
                    <label class="filter__option{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                      <span>{{ value.label }}</span>
                      <span class="filter__n">{{ value.count }}</span>
                    </label>
                  {%- endfor -%}
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}

        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <label class="visually-hidden" for="SortBy">{{ 'collection.sort_by' | t }}</label>
        <select id="SortBy" class="toolbar__sort" name="sort_by">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
      </div>
    </form>

    {%- assign active_count = 0 -%}
    {%- for filter in collection.filters -%}{%- assign active_count = active_count | plus: filter.active_values.size -%}{%- endfor -%}
    {%- if active_count > 0 -%}
      <div class="active-filters">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}" class="active-filters__pill">{{ value.label }} &times;</a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              <a href="{{ filter.url_to_remove }}" class="active-filters__pill">{{ 'collection.price' | t }} &times;</a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="active-filters__clear">{{ 'collection.clear_filters' | t }}</a>
      </div>
    {%- endif -%}

    {%- liquid
      assign show_pz = false
      if s.pz_show and paginate.current_page == 1 and collection.handle != 'personalizalo'
        assign show_pz = true
      endif
      assign pz_photo_url = s.pz_photo_link | default: '/products/tu-imagen-impresa'
      assign pz_tpl_url = s.pz_tpl_link | default: '/collections/personalizalo#Plantillas'
      assign pz_p = all_products['tu-imagen-impresa']
      assign pz_from = s.pz_photo_line
      if pz_p != blank
        assign pz_price = pz_p.price_min | money
        assign pz_from = 'general.from' | t | append: ' ' | append: pz_price
      endif
    -%}
    {%- if collection.products.size > 0 -%}
      <ul class="product-grid collection-grid-art" style="--cols: {{ s.columns }}">
        {%- for product in collection.products -%}
          {%- liquid
            # «Personalízalo» lives in its own collection, never in the author catalogue
            if collection.handle == 'all' and product.type == 'Personalizado'
              continue
            endif
            assign lazy = true
            if forloop.index <= 4
              assign lazy = false
            endif
            assign idx = paginate.current_offset | plus: forloop.index
          -%}
          <li class="reveal">{% render 'product-card', product: product, lazy: lazy, index: idx %}</li>
          {%- comment -%} Personalízalo tiles inside the grid, first page of the author catalogue only {%- endcomment -%}
          {%- if show_pz -%}
            {%- if forloop.index == s.pz_photo_pos or forloop.last and forloop.index < s.pz_photo_pos -%}
              <li class="reveal">{% render 'pz-card', image: s.pz_photo_image, title: s.pz_photo_title, line: pz_from, url: pz_photo_url, tag: s.pz_tag, lazy: lazy %}</li>
            {%- endif -%}
            {%- if forloop.index == s.pz_tpl_pos or forloop.last and forloop.index < s.pz_tpl_pos -%}
              <li class="reveal">{% render 'pz-card', image: s.pz_tpl_image, title: s.pz_tpl_title, line: s.pz_tpl_line, url: pz_tpl_url, tag: s.pz_tag, lazy: true %}</li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <ul class="product-grid collection-grid-art" style="--cols: {{ s.columns }}">
        {%- for i in (1..8) -%}<li>{% render 'product-card', product: blank, index: i %}</li>{%- endfor -%}
      </ul>
    {%- else -%}
      <div class="empty-note reveal">
        <p class="empty-note__title">{% if active_count > 0 %}{{ 'collection.empty_filtered' | t }}{% else %}{{ 'collection.empty' | t }}{% endif %}</p>
        <p class="empty-note__text">{% if active_count > 0 %}{{ 'collection.empty_filtered_hint' | t }}{% else %}{{ 'collection.empty_hint' | t }}{% endif %}</p>
        <a class="button" href="{% if active_count > 0 %}{{ collection.url }}{% else %}{{ routes.root_url }}#Join{% endif %}">{% if active_count > 0 %}{{ 'collection.clear_filters' | t }}{% else %}{{ 'collection.notify_me' | t }}{% endif %}</a>
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
        {%- if paginate.previous -%}<a class="round-btn" href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}">&larr;</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="current" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a class="round-btn" href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}">&rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Colección",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "OBRAS" },
    { "type": "text", "id": "all_title", "label": "Título de «todas las obras»", "default": "Todas las obras" },
    { "type": "range", "id": "per_page", "label": "Obras por página", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columnas en escritorio", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_nav", "label": "Mostrar navegación entre colecciones", "default": true },
    { "type": "header", "content": "Personalízalo en la cuadrícula" },
    { "type": "checkbox", "id": "pz_show", "label": "Mostrar las dos tarjetas de Personalízalo", "default": true, "info": "Solo en la primera página, nunca en la colección Personalízalo." },
    { "type": "text", "id": "pz_tag", "label": "Etiqueta", "default": "Personalízalo" },
    { "type": "range", "id": "pz_photo_pos", "label": "«Con tu foto»: después de la obra nº", "min": 1, "max": 24, "step": 1, "default": 3 },
    { "type": "image_picker", "id": "pz_photo_image", "label": "«Con tu foto»: imagen" },
    { "type": "text", "id": "pz_photo_title", "label": "«Con tu foto»: título", "default": "Tu foto, en un cuadro" },
    { "type": "text", "id": "pz_photo_line", "label": "«Con tu foto»: línea inferior", "default": "Sube tu foto", "info": "Si existe el producto «tu-imagen-impresa», se muestra su precio desde." },
    { "type": "url", "id": "pz_photo_link", "label": "«Con tu foto»: enlace", "info": "Vacío = /products/tu-imagen-impresa" },
    { "type": "range", "id": "pz_tpl_pos", "label": "«Con plantilla»: después de la obra nº", "min": 1, "max": 24, "step": 1, "default": 9 },
    { "type": "image_picker", "id": "pz_tpl_image", "label": "«Con plantilla»: imagen" },
    { "type": "text", "id": "pz_tpl_title", "label": "«Con plantilla»: título", "default": "Tu foto, en ilustración" },
    { "type": "text", "id": "pz_tpl_line", "label": "«Con plantilla»: línea inferior", "default": "Ver plantillas" },
    { "type": "url", "id": "pz_tpl_link", "label": "«Con plantilla»: enlace", "info": "Vacío = /collections/personalizalo#Plantillas" },
    { "type": "link_list", "id": "sections_menu", "label": "Menú de colecciones", "info": "Opcional. Si lo dejas vacío se listan las colecciones con obras." }
  ]
}
{% endschema %}
