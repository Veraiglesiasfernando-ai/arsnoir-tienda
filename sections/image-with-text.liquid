{%- assign s = section.settings -%}
<section class="section{% if s.border_top %} section--border-top{% endif %}">
  <div class="page-width">
    <div class="image-text{% if s.reverse %} image-text--reverse{% endif %}">
      <div class="image-text__media{% if s.grayscale %} hero__media--grayscale{% endif %}">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 750px) 50vw, 100vw' }}
        {%- else -%}
          <div class="tile-ph" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      <div class="image-text__content">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte muted">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="button button--outline" style="margin-top:1.5rem" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imagen con texto",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "checkbox", "id": "grayscale", "label": "Imagen en blanco y negro", "default": true },
    { "type": "checkbox", "id": "reverse", "label": "Imagen a la derecha", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "El proceso" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Impreso, no fabricado en serie." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Cuenta aquí cómo trabajas: quién hace las obras, en qué papel se imprimen, cómo se revisa cada lámina antes de enviarla. Los detalles reales son lo que diferencia una tienda de arte de un catálogo genérico.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Sobre nosotros" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "border_top", "label": "Línea superior", "default": false }
  ],
  "presets": [{ "name": "Imagen con texto" }]
}
{% endschema %}
