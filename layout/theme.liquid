<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {{ 'space-grotesk-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}

    <style>
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url({{ 'space-grotesk-latin.woff2' | asset_url }}) format('woff2');
      }

      :root {
        --font-body: 'Space Grotesk', system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        --font-body-weight: 400;
        --font-heading: 'Space Grotesk', system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        --font-heading-weight: 700;
        --color-bg: {{ settings.color_background }};
        --color-fg: {{ settings.color_foreground }};
        --color-muted: {{ settings.color_muted }};
        --color-line: {{ settings.color_line }};
        --color-surface: {{ settings.color_surface }};
        --color-accent: {{ settings.color_accent }};
        --page-width: {{ settings.page_width }}px;
        --radius: {{ settings.button_radius }}px;
      }
    </style>

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'arsnoir.css' | asset_url | stylesheet_tag }}
    {% render 'q4-config' %}
    <script>
      window.themeStrings = {
        addShort: {{ 'product.add_short' | t | json }},
        cartCount: {{ 'cart.count' | t: count: '[count]' | json }},
        addError: {{ 'cart.add_error' | t | json }},
        packError: {{ 'cart.pack_error' | t | json }},
        scaleWith: {{ 'product.scale_with' | t | json }},
        chooseSize: {{ 'product.choose_size' | t: size: '[size]' | json }},
        saveFavorite: {{ 'cards.save_favorite' | t | json }},
        removeFavorite: {{ 'cards.remove_favorite' | t | json }},
        from: {{ 'general.from' | t | json }},
        soldOut: {{ 'cards.sold_out' | t | json }},
        copied: {{ 'general.copied' | t | json }},
        free: {{ 'cart.free' | t | json }},
        shipFrom: {{ 'cart.ship_from' | t: amount: '[AMOUNT]' | json }},
        delivery: {{ 'q4.delivery' | t | json }},
        beforeXmas: {{ 'q4.before_xmas' | t | json }},
        beforeReyes: {{ 'q4.before_reyes' | t | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}" data-template="{{ template.name }}">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% section 'cookie-banner' %}
    {% section 'newsletter-popup' %}
  </body>
</html>
