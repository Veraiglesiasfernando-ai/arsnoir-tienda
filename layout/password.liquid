<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ 'space-grotesk-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}

    <style>
      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url({{ 'space-grotesk-latin.woff2' | asset_url }}) format('woff2');
      }

      :root {
        --font-body: 'Space Grotesk', system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        --font-body-weight: 400;
        --font-heading: 'Space Grotesk', system-ui, -apple-system, 'Helvetica Neue', Arial, sans-serif;
        --font-heading-weight: 700;
        --color-bg: {{ settings.color_background }};
        --color-fg: {{ settings.color_foreground }};
        --color-muted: {{ settings.color_muted }};
        --color-line: {{ settings.color_line }};
        --color-surface: {{ settings.color_surface }};
        --color-accent: {{ settings.color_accent }};
        --page-width: {{ settings.page_width }}px;
        --radius: {{ settings.button_radius }}px;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'arsnoir.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
