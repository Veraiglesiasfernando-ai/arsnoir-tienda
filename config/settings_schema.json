  {
    "name": "Conversión",
    "settings": [
      {
        "type": "header",
        "content": "Envío"
      },
      {
        "type": "text",
        "id": "shipping_message",
        "label": "Mensaje de envío",
        "info": "Solo si el envío es siempre gratis (umbral 0). Vacío = el envío se calcula en el pago según la dirección del cliente."
      },
      {
        "type": "text",
        "id": "shipping_details",
