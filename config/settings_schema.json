[
  {
    "name": "theme_info",
    "theme_name": "Ars Noir",
    "theme_version": "1.0.0",
    "theme_author": "ARSNOIR",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Fondo",
        "default": "#F4F4F3"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Texto y negro",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Texto secundario",
        "default": "#6B6B6B"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Líneas y bordes",
        "default": "#E2E2E0"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Fondo de huecos vacíos",
        "default": "#E9E9E7"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Acento (rojo)",
        "default": "#E4231A"
      }
    ]
  },
  {
    "name": "Diseño",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Ancho máximo de página",
        "min": 1000,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Redondeo de botones",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 100
      },
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Proporción de las obras en listados",
        "default": "square",
        "options": [
          {
            "value": "portrait",
            "label": "Vertical (4:5)"
          },
          {
            "value": "square",
            "label": "Cuadrado (1:1)"
          },
          {
            "value": "tall",
            "label": "Vertical alto (2:3)"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "card_frame",
        "label": "Marco negro en las obras de los listados",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Redes sociales",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "info": "https://instagram.com/tu_cuenta"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok"
      }
    ]
  },
  {
    "name": "Conversión",
    "settings": [
      {
        "type": "header",
        "content": "Envío gratis"
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Envío gratis a partir de",
        "min": 0,
        "max": 200,
        "step": 5,
        "unit": "€",
        "default": 60,
        "info": "Debe coincidir con tu tarifa de envío en Configuración → Envíos. 0 = desactivado."
      },
      {
        "type": "header",
        "content": "Valoración de la tienda"
      },
      {
        "type": "text",
        "id": "rating_value",
        "label": "Nota media (ej. 4,9)",
        "info": "Solo con reseñas reales. Déjalo vacío hasta tenerlas."
      },
      {
        "type": "number",
        "id": "rating_count",
        "label": "Número de reseñas",
        "info": "Solo reseñas reales. Si es 0 o vacío, las estrellas no se muestran."
      },
      {
        "type": "header",
        "content": "Garantías"
      },
      {
        "type": "text",
        "id": "returns_days",
        "label": "Días para devolver",
        "default": "14"
      }
    ]
  }
]