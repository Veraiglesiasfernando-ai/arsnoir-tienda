{%- comment -%} One style card of sections/custom-templates.liquid (block, s = section settings) {%- endcomment -%}
{%- assign b = block.settings -%}
{%- comment -%}
  The style's product (from its link): its framed picture with a clear background (no grey around the frame),
  its «from» price, and its best real offer (a variant with an earlier price, e.g. the canvas).
{%- endcomment -%}
{%- assign c_prod = nil -%}{%- assign c_art = nil -%}{%- assign c_deal = nil -%}
{%- if b.link != blank and b.link contains '/products/' -%}
  {%- assign c_handle = b.link | split: '/products/' | last | split: '?' | first -%}
  {%- assign c_prod = all_products[c_handle] -%}
  {%- if c_prod != blank and c_prod.id -%}
    {%- for m in c_prod.media -%}
      {%- assign ma = m.alt | downcase -%}
      {%- if ma contains 'con marco' -%}{%- assign c_art = m -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- assign c_best = 0 -%}
    {%- for v in c_prod.variants -%}
      {%- if v.available and v.compare_at_price > v.price -%}
        {%- assign v_pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round -%}
        {%- if c_deal == nil or v.price < c_deal.price -%}{%- assign c_deal = v -%}{%- assign c_best = v_pct -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- assign c_prod = nil -%}
  {%- endif -%}
{%- endif -%}
{%- comment -%} A style whose product is not on sale (draft or hidden) would lead to a missing page: hidden on the store, shown in the editor {%- endcomment -%}
{%- assign c_missing = false -%}
{%- if b.link != blank and b.link contains '/products/' and c_prod == nil -%}{%- assign c_missing = true -%}{%- endif -%}
{%- unless c_missing and request.design_mode == false -%}
<li class="ctpl__item reveal" data-cat="{{ b.category | strip | handleize }}" {{ block.shopify_attributes }}>
  {%- capture card_inner -%}
    <span class="ctpl__media">
      {%- if b.image != blank -%}
        {%- if c_art -%}
          {{ c_art | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, 70vw', alt: b.name, class: 'ctpl__art ctpl__art--clear' }}
        {%- else -%}
          {{ b.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, 70vw', alt: b.name, class: 'ctpl__art' }}
        {%- endif -%}
        {%- if b.link != blank -%}
          <span class="ctpl__hover" aria-hidden="true">
            <span class="ctpl__hover-icon"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 16V4m0 0-4.5 4.5M12 4l4.5 4.5"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg></span>
            <span class="ctpl__hover-title">Personalízalo</span>
            <span class="ctpl__hover-text">Sube tu foto y míralo gratis</span>
          </span>
        {%- endif -%}
      {%- else -%}
        <span class="ctpl__ph" aria-hidden="true"></span>
      {%- endif -%}
      {%- if b.before != blank -%}
        <span class="ctpl__before">
          {{ b.before | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
          <span class="ctpl__before-label">{{ s.before_label }}</span>
        </span>
      {%- endif -%}
      {%- if b.badge != blank -%}<span class="ctpl__badge">{{ b.badge }}</span>{%- endif -%}
      {%- if c_prod -%}<span class="ctpl__price">{{ 'general.from' | t }} <b>{{ c_prod.price_min | money }}</b></span>{%- endif -%}

      {%- if b.link != blank -%}<span class="ctpl__go" aria-hidden="true">→</span>{%- endif -%}
      {%- if b.link == blank and b.image != blank -%}<span class="ctpl__soon">{{ s.soon_label }}</span>{%- endif -%}
      {%- if b.link == blank and b.image == blank -%}<span class="ctpl__draft">{{ s.no_link_label }}</span>{%- endif -%}
    </span>
    {%- if b.category != blank -%}<span class="ctpl__cat">{{ b.category }}</span>{%- endif -%}
    <span class="ctpl__name">{{ b.name }}</span>
    {%- if c_deal -%}
        {%- assign dt = c_deal.title | downcase -%}
        {%- if dt contains 'lienzo' or dt contains 'canvas' -%}{%- assign d_label = 'Lienzo' -%}{%- elsif dt contains 'sin marco' or dt contains 'unframed' -%}{%- assign d_label = 'Lámina' -%}{%- elsif dt contains 'marco' or dt contains 'frame' -%}{%- assign d_label = 'Con marco' -%}{%- else -%}{%- assign d_label = '' -%}{%- endif -%}
        <span class="ctpl__deal">{% if d_label != '' %}{{ d_label }} {% endif %}<b>{{ c_deal.price | money }}</b> <s>{{ c_deal.compare_at_price | money }}</s> <em>-{{ c_best }} %</em></span>
      {%- endif -%}
    {%- if b.tagline != blank -%}<span class="ctpl__tagline">{{ b.tagline }}</span>{%- endif -%}
  {%- endcapture -%}
  {%- if b.link != blank -%}
    <a class="ctpl__card" href="{{ b.link }}">{{ card_inner }}<span class="ctpl__cta">{{ s.button_label }}</span></a>
  {%- else -%}
    <div class="ctpl__card is-soon">{{ card_inner }}</div>
  {%- endif -%}
</li>
{%- endunless -%}
