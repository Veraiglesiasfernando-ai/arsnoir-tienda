{%- comment -%}
  MIXPIX tab of «Compón tu pared» (sections/pet-packs.liquid, block type 'mixpix'): one pack size per tab
  (2, 3 or 6 tiles of 20×20). Shows a wall with that many tiles (one style each, from the block's
  products), the price of that pack read from the variants of style 1 («MIXPIX 20×20 · pack de N»,
  «Sin marco» and «Marco negro»), and a button to style 1 with that pack already selected, where the
  customer ticks the other styles (snippets/mixpix-styles.liquid).
  - block, index, active
{%- endcomment -%}
{%- liquid
  assign b = block.settings
  assign n = b.pack | default: '3' | plus: 0
  assign first = b.product_1 | default: b.product_2 | default: b.product_3
  assign size = 'MIXPIX 20×20 · pack de ' | append: n
  if n == 1
    assign size = 'MIXPIX 20×20 · suelto'
  endif
  assign bare = nil
  assign framed = nil
  assign bare_id = nil
  for v in first.variants
    if v.option1 == size and v.option2 == 'Sin marco'
      assign bare = v.price
      assign bare_id = v.id
    elsif v.option1 == size and v.option2 == 'Marco negro'
      assign framed = v.price
    endif
  endfor
  assign names = ''
  assign shown = 0
  # The other styles of this pack, ticked for the customer on arrival (mixpix-styles reads ?mx=)
  assign mx = ''
  assign extra = b.product_2.title | append: '|' | append: b.product_3.title | append: '|' | append: b.product_4.title | append: '|' | append: b.product_5.title | append: '|' | append: b.product_6.title
  assign extra = extra | split: '|'
  for t in extra limit: 5
    if forloop.index >= n
      break
    endif
    if t != blank
      if mx != ''
        assign mx = mx | append: '|'
      endif
      assign mx = mx | append: t
    endif
  endfor
  assign mx_q = ''
  if mx != ''
    assign mx_q = 'mx=' | append: mx | url_encode
  endif
-%}
<div class="ppk__panel mxpk mxpk--{{ n }}{% if active %} is-active{% endif %}" role="tabpanel" data-ppk-panel="{{ index }}"{% unless active %} hidden{% endunless %} {{ block.shopify_attributes }}>
  <a class="mxpk__art" href="{{ first.url | default: '/collections/personalizalo' }}{% if bare_id %}?variant={{ bare_id }}{% if mx_q != '' %}&{{ mx_q }}{% endif %}{% elsif mx_q != '' %}?{{ mx_q }}{% endif %}" tabindex="-1" aria-hidden="true">
    {%- for k in (1..n) -%}
      {%- liquid
        assign key = 'product_' | append: k
        assign p = b[key] | default: first
        if b[key] != blank and shown < 3
          if names != ''
            assign names = names | append: ' · '
          endif
          assign names = names | append: p.title
          assign shown = shown | plus: 1
        endif
        # The square MIXPIX version of the style (Files: «mixpix-<handle>.jpg», framed without cutting
        # faces or names by tools/mixpix-cuadrado.js); else the clean illustration («-obra»)
        assign fname = 'mixpix-' | append: p.handle | append: '.jpg'
        assign art = images[fname]
        if art == blank
          assign art = p.featured_media
          for m in p.media
            if m.preview_image.src contains '-obra'
              assign art = m
              break
            endif
          endfor
        endif
      -%}
      <span class="mxpk__tile mxpk__tile--{{ k }}">
        {%- if art != blank -%}
          {{ art | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 20vw, 45vw', alt: '' }}
        {%- endif -%}
      </span>
    {%- endfor -%}
  </a>
  <div class="fcol__copy">
    <p class="ppk__count">MIXPIX · {{ n }} cuadros de 20×20</p>
    <h3 class="ppk__name">{{ b.title }}</h3>
    {%- if names != '' -%}<p class="ppk__styles">{{ names }}{% if n > 3 %} y más{% endif %}</p>{%- endif -%}
    {%- if b.text != blank -%}<p class="fcol__text">{{ b.text }}</p>{%- endif -%}
    {%- if bare -%}
      <p class="ppk__price"><b>{{ bare | money }}</b> <span>· sin marco</span>{% if framed %} <span>· con marco {{ framed | money }}</span>{% endif %}</p>
    {%- endif -%}
    {%- comment -%} Choose the styles here: tap to tick (up to N); the button carries them to the product page {%- endcomment -%}
    <div class="mxch" data-mxch hidden role="dialog" aria-modal="true" aria-label="Elige los estilos de tu pack" data-n="{{ n }}" data-base="{{ first.url }}{% if bare_id %}?variant={{ bare_id }}{% endif %}">
      <div class="mxch__box">
      <button type="button" class="mxch__x" data-mxch-close aria-label="Cerrar">✕</button>
      <p class="mxch__eyebrow">MIXPIX · Pack de {{ n }}</p>
      <p class="mxch__title">Elige tus {{ n }} estilos <span data-mxch-count></span></p>
      <p class="mxch__sub">Usamos la misma foto para todos. Puedes meter también tu foto tal cual, sin ilustración. Después la subes y lo ves gratis antes de pagar.</p>
      <ul class="mxch__list" role="list">
        {%- liquid
          assign picked_t = ''
          for k in (1..n)
            assign key = 'product_' | append: k
            assign pp = b[key]
            if pp != blank
              assign pt = pp.title
              assign picked_t = picked_t | append: '|' | append: pt | append: '|'
            endif
          endfor
        -%}
        <li><button type="button" class="mxch__opt mxch__opt--photo" data-title="Tu foto, sin ilustración" data-photo="1" aria-pressed="false">
          <span class="mxch__ph"><span>+</span>Tu foto tal cual</span>
          <span>Tu foto, sin ilustración</span>
        </button></li>
        {%- for p in collections['personalizalo'].products limit: 40 -%}
          {%- unless p.tags contains 'mascotas' and p.available -%}{%- continue -%}{%- endunless -%}
          {%- assign tk = '|' | append: p.title | append: '|' -%}
          <li><button type="button" class="mxch__opt{% if picked_t contains tk %} is-on{% endif %}" data-title="{{ p.title | escape }}" data-url="{{ p.url }}" aria-pressed="{% if picked_t contains tk %}true{% else %}false{% endif %}">
            {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 360 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
            <span>{{ p.title }}</span>
          </button></li>
        {%- endfor -%}
      </ul>
      <a class="mxch__go" data-mxch-next href="#">Continuar · sube tu foto →</a>
      </div>
    </div>
    <div class="fcol__actions">
      <a class="fcol__btn" data-mxch-go href="{{ first.url | default: '/collections/personalizalo' }}{% if bare_id %}?variant={{ bare_id }}{% if mx_q != '' %}&{{ mx_q }}{% endif %}{% elsif mx_q != '' %}?{{ mx_q }}{% endif %}">{{ b.button_label | default: 'Crear mi pack' }}</a>
    </div>
    <p class="fcol__note">Se pegan a la pared sin clavos y se pueden mover. Usamos la misma foto para todos y la ves gratis antes de pagar.</p>
  </div>
</div>
<script>
  (function () {
    var box = document.currentScript.previousElementSibling.querySelector('[data-mxch]');
    if (!box || box.dataset.ready) return; box.dataset.ready = '1';
    var n = +box.dataset.n, panel = box.closest('.mxpk'), go = panel.querySelector('[data-mxch-go]'), art = panel.querySelector('.mxpk__art');
    var opts = Array.prototype.slice.call(box.querySelectorAll('.mxch__opt'));
    var order = opts.filter(function (o) { return o.classList.contains('is-on'); }).map(function (o) { return o.dataset.title; });
    document.body.appendChild(box); /* outside the tabs, so the panel covers the whole screen */
    var next = box.querySelector('[data-mxch-next]');
    var label = go.textContent;
    function sync() {
      opts.forEach(function (o) { var on = order.indexOf(o.dataset.title) > -1; o.classList.toggle('is-on', on); o.setAttribute('aria-pressed', on); o.disabled = !on && order.length >= n; });
      box.querySelector('[data-mxch-count]').textContent = order.length + '/' + n;
      /* the product page is an illustration's: the first illustrated style leads, «Tu foto» goes with the others */
      var ill = order.filter(function (t) { return t !== 'Tu foto, sin ilustración'; });
      var rest = order.filter(function (t) { return t !== ill[0]; });
      var first = opts.find(function (o) { return o.dataset.title === ill[0]; });
      var base = box.dataset.base, q = base.indexOf('?') > -1 ? base.slice(base.indexOf('?')) : '';
      var url = (first ? first.dataset.url : base.split('?')[0]) + q;
      if (rest.length) url += (q ? '&' : '?') + 'mx=' + encodeURIComponent(rest.join('|'));
      next.href = url + '#subir';
      var bad = order.length < n || !ill.length;
      next.classList.toggle('is-off', bad);
      next.textContent = (order.length >= n && !ill.length) ? 'Elige al menos 1 ilustración' : order.length < n ? 'Elige ' + (n - order.length) + ' estilo' + (n - order.length > 1 ? 's' : '') + ' más' : 'Continuar · sube tu foto →';
    }
    opts.forEach(function (o) { o.addEventListener('click', function () { var i = order.indexOf(o.dataset.title); if (i > -1) order.splice(i, 1); else if (order.length < n) order.push(o.dataset.title); sync(); }); });
    next.addEventListener('click', function (e) { if (next.classList.contains('is-off')) e.preventDefault(); });
    var open = function (e) { e.preventDefault(); box.hidden = false; document.documentElement.style.overflow = 'hidden'; };
    var close = function () { box.hidden = true; document.documentElement.style.overflow = ''; };
    go.addEventListener('click', open); if (art) art.addEventListener('click', open);
    box.addEventListener('click', function (e) { if (e.target === box || e.target.closest('[data-mxch-close]')) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !box.hidden) close(); });
    sync();
  })();
</script>
