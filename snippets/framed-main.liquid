{%- comment -%}
  First gallery image. When it is the «… con marco negro» photo, it carries the
  white / wood / no-frame / canvas versions (Shopify Files: <handle>-marco-<kind>.webp)
  so theme.js can swap it when the frame changes.
{%- endcomment -%}
{%- liquid
  # The product's main picture is what the customer waits for: fetch it first
  assign priority = 'auto'
  assign early = false
  if load == 'eager'
    assign priority = 'high'
    assign early = true
  endif
  assign alt_l = media.alt | downcase
  assign base = product.handle | append: '-marco-'
  assign alt_text = media.alt | default: product.title
-%}
{%- if alt_l contains 'con marco negro' -%}
  {%- liquid
    assign black_src = media | image_url: width: 1600
    assign white_src = base | append: 'white.webp' | file_url | append: '&width=1400'
    assign wood_src = base | append: 'wood.webp' | file_url | append: '&width=1400'
    assign none_src = base | append: 'none.webp' | file_url | append: '&width=1400'
    assign canvas_src = base | append: 'canvas.webp' | file_url | append: '&width=1400'
  -%}
  {{ media | image_url: width: 1600 | image_tag:
    loading: load,
    fetchpriority: priority,
    preload: early,
    widths: '500, 800, 1100, 1400, 1600',
    sizes: '(min-width: 990px) 50vw, 92vw',
    alt: alt_text,
    data-black: black_src,
    data-white: white_src,
    data-wood: wood_src,
    data-none: none_src,
    data-canvas: canvas_src
  }}
{%- else -%}
  {{ media | image_url: width: 1600 | image_tag:
    loading: load,
    fetchpriority: priority,
    preload: early,
    widths: '500, 800, 1100, 1400, 1600',
    sizes: '(min-width: 990px) 50vw, 92vw',
    alt: alt_text
  }}
{%- endif -%}
