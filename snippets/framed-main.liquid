{%- comment -%}
  First gallery image. When it is the «… con marco negro» photo, it carries the
  white / wood / no-frame / canvas versions (Shopify Files: <handle>-marco-<kind>.png, see frame-src)
  so theme.js can swap it when the frame changes.
{%- endcomment -%}
{%- liquid
  # The product's main picture is what the customer waits for: fetch it first
  assign priority = 'auto'
  assign early = false
  if load == 'eager'
    assign priority = 'high'
    assign early = true
  endif
  assign alt_l = media.alt | downcase
  assign base = product.handle | append: '-marco-'
  assign alt_text = media.alt | default: product.title
-%}
{%- if alt_l contains 'con marco negro' -%}
  {%- liquid
    assign black_src = media | image_url: width: 1100
    assign white_name = base | append: 'white'
    capture white_src
      render 'frame-src', name: white_name, width: 1000
    endcapture
    assign wood_name = base | append: 'wood'
    capture wood_src
      render 'frame-src', name: wood_name, width: 1000
    endcapture
    assign none_name = base | append: 'none'
    capture none_src
      render 'frame-src', name: none_name, width: 1000
    endcapture
    assign canvas_name = base | append: 'canvas'
    capture canvas_src
      render 'frame-src', name: canvas_name, width: 1000
    endcapture
  -%}
  {{ media | image_url: width: 1600 | image_tag:
    loading: load,
    fetchpriority: priority,
    preload: early,
    widths: '500, 800, 1100, 1400, 1600',
    sizes: '(min-width: 990px) 50vw, 92vw',
    alt: alt_text,
    data-black: black_src,
    data-white: white_src,
    data-wood: wood_src,
    data-none: none_src,
    data-canvas: canvas_src
  }}
{%- else -%}
  {{ media | image_url: width: 1600 | image_tag:
    loading: load,
    fetchpriority: priority,
    preload: early,
    widths: '500, 800, 1100, 1400, 1600',
    sizes: '(min-width: 990px) 50vw, 92vw',
    alt: alt_text
  }}
{%- endif -%}
