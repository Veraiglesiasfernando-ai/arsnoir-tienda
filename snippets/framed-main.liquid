{%- comment -%}
  First gallery image. When it is the «… con marco negro» photo, it carries the
  white / wood / no-frame / canvas versions (Shopify Files: <handle>-marco-<kind>.webp)
  so theme.js can swap it when the frame changes.
{%- endcomment -%}
{%- liquid
  # The product's main picture is what the customer waits for: fetch it first
  assign priority = 'auto'
  assign early = false
  if load == 'eager'
    assign priority = 'high'
    assign early = true
  endif
  assign alt_l = media.alt | downcase
  assign base = product.handle | append: '-marco-'
  assign alt_text = media.alt | default: product.title
-%}
{%- if alt_l contains 'con marco negro' -%}
  {%- liquid
    assign black_src = media | image_url: width: 1100
    assign white_name = base | append: 'white.webp'
    assign white_img = images[white_name]
    if white_img.width > 0
      assign white_src = white_img | image_url: width: 1000, format: 'pjpg'
    else
      assign white_src = white_name | file_url | append: '&width=1000'
    endif
    assign wood_name = base | append: 'wood.webp'
    assign wood_img = images[wood_name]
    if wood_img.width > 0
      assign wood_src = wood_img | image_url: width: 1000, format: 'pjpg'
    else
      assign wood_src = wood_name | file_url | append: '&width=1000'
    endif
    assign none_name = base | append: 'none.webp'
    assign none_img = images[none_name]
    if none_img.width > 0
      assign none_src = none_img | image_url: width: 1000, format: 'pjpg'
    else
      assign none_src = none_name | file_url | append: '&width=1000'
    endif
    assign canvas_name = base | append: 'canvas.webp'
    assign canvas_img = images[canvas_name]
    if canvas_img.width > 0
      assign canvas_src = canvas_img | image_url: width: 1000, format: 'pjpg'
    else
      assign canvas_src = canvas_name | file_url | append: '&width=1000'
    endif
  -%}
  {{ media | image_url: width: 1600 | image_tag:
    loading: load,
    fetchpriority: priority,
    preload: early,
    widths: '500, 800, 1100, 1400, 1600',
    sizes: '(min-width: 990px) 50vw, 92vw',
    alt: alt_text,
    data-black: black_src,
    data-white: white_src,
    data-wood: wood_src,
    data-none: none_src,
    data-canvas: canvas_src
  }}
{%- else -%}
  {{ media | image_url: width: 1600 | image_tag:
    loading: load,
    fetchpriority: priority,
    preload: early,
    widths: '500, 800, 1100, 1400, 1600',
    sizes: '(min-width: 990px) 50vw, 92vw',
    alt: alt_text
  }}
{%- endif -%}
