{%- comment -%}
  «Opiniones de los clientes» under the product: the shop's average and count on the left, review cards
  in a sideways row on the right. Everything comes from Judge.me (shop metafields written by the app):
  nothing is invented. With no reviews yet, one honest card and Judge.me's own «write a review» form.
  - product, heading
{%- endcomment -%}
{%- liquid
  assign jm = shop.metafields.judgeme
  assign count = jm.all_reviews_count | plus: 0
  assign avg = jm.all_reviews_rating | plus: 0.0
  assign grid = jm.reviews_grid.value
  assign list = grid.all_reviews.reviews
  if list == blank
    assign list = grid.reviews
  endif
  assign avg_r = avg | round: 1
  assign label = 'Muy buenas'
  if avg >= 4.5
    assign label = 'Excelentes'
  elsif avg < 4
    assign label = 'Buenas'
  endif
-%}
<section class="section rvc" id="Reviews">
  <div class="page-width">
    <h2 class="rvc__title">{{ heading | default: 'Opiniones de los clientes' }}</h2>
    <div class="rvc__row">
      <div class="rvc__sum">
        {%- if count > 0 -%}
          <p class="rvc__avg">{{ avg_r | replace: '.', ',' }}</p>
          <p class="rvc__label">{{ label }}</p>
          <span class="rvc__stars rvc__stars--big" style="--r: {{ avg | divided_by: 5.0 | times: 100 }}%" aria-label="{{ avg_r }} de 5"></span>
          <p class="rvc__based">Basado en {{ count }} {% if count == 1 %}opinión{% else %}opiniones{% endif %}.</p>
        {%- else -%}
          <p class="rvc__avg rvc__avg--none">Nuevo</p>
          <p class="rvc__label">Aún sin opiniones</p>
          <span class="rvc__stars rvc__stars--big" style="--r: 0%" aria-hidden="true"></span>
          <p class="rvc__based">ARSNOIR acaba de abrir. Publicamos todas las opiniones, sin filtrar.</p>
        {%- endif -%}
        <p class="rvc__by">Opiniones verificadas con Judge.me</p>
      </div>
      <div class="rvc__track-wrap">
        <ul class="rvc__track" data-rvc-track>
          {%- if count > 0 and list != blank -%}
            {%- for r in list limit: 12 -%}
              {%- liquid
                assign rating = r.rating | plus: 0
                assign name = r.reviewer_name | default: r.reviewer.name | default: r.author | default: 'Cliente'
                assign body = r.body | default: r.body_html | strip_html | strip | truncatewords: 40
                assign verified = false
                if r.verified_buyer or r.verified == 'buyer' or r.reviewer.verified_buyer
                  assign verified = true
                endif
              -%}
              <li class="rvc__card">
                <div class="rvc__card-top">
                  <span class="rvc__stars" style="--r: {{ rating | times: 20 }}%" aria-label="{{ rating }} de 5"></span>
                  {%- if verified -%}<span class="rvc__ok">Comprador verificado</span>{%- endif -%}
                </div>
                {%- if r.title != blank -%}<p class="rvc__card-title">{{ r.title | escape }}</p>{%- endif -%}
                <p class="rvc__text">{{ body | escape }}</p>
                {%- assign mi = r.created_at | date: '%-m' | minus: 1 -%}
                {%- assign months = 'ene,feb,mar,abr,may,jun,jul,ago,sept,oct,nov,dic' | split: ',' -%}
                <p class="rvc__date">{{ r.created_at | date: '%-d' }} {{ months[mi] }} {{ r.created_at | date: '%Y' }}</p>
                <p class="rvc__name">{{ name | escape }}</p>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="rvc__card rvc__card--first">
              <span class="rvc__stars" style="--r: 0%" aria-hidden="true"></span>
              <p class="rvc__card-title">Tu opinión puede ser la primera</p>
              <p class="rvc__text">Cuando recibas tu cuadro te escribiremos para que nos cuentes qué tal. Si ya lo tienes, déjala aquí abajo.</p>
            </li>
          {%- endif -%}
        </ul>
        {%- if count > 1 -%}
          <button type="button" class="rvc__arrow rvc__arrow--prev" data-rvc-prev aria-label="{{ 'general.previous' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
          <button type="button" class="rvc__arrow rvc__arrow--next" data-rvc-next aria-label="{{ 'general.next' | t }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
        {%- endif -%}
      </div>
    </div>
    {%- if product != blank -%}
      <details class="rvc__write">
        <summary>{% if count > 0 %}Ver todas las opiniones o escribir la tuya{% else %}Escribir una opinión{% endif %}</summary>
        <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">{{ product.metafields.judgeme.widget }}</div>
      </details>
    {%- endif -%}
  </div>
</section>
<script>
  (function () {
    var s = document.currentScript.previousElementSibling;
    var t = s && s.querySelector('[data-rvc-track]');
    if (!t) return;
    var step = function (d) { var c = t.querySelector('.rvc__card'); t.scrollBy({ left: d * ((c ? c.offsetWidth : 300) + 20), behavior: 'smooth' }); };
    var p = s.querySelector('[data-rvc-prev]'), n = s.querySelector('[data-rvc-next]');
    if (p) p.addEventListener('click', function () { step(-1); });
    if (n) n.addEventListener('click', function () { step(1); });
  })();
</script>
