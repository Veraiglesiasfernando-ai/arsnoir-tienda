{%- comment -%}
  Personalízalo · template editor: the customer uploads a photo (and a name when the template has
  one), the illustration is made on Replicate through the ARSNOIR worker, and the preview link is
  saved in the order (properties). Without a preview the work can't be added to the cart.
  - block, form_id, product, section_id
{%- endcomment -%}
{%- assign b = block.settings -%}
<div class="tstudio" id="subir" data-tstudio
  data-endpoint="{{ b.endpoint | strip }}"
  data-template="{{ b.template_id | strip }}"
  data-needs-name="{{ b.needs_name }}"
  data-text-optional="{{ b.text_optional }}"
  data-max="{{ b.max_previews }}"
  data-key="tstudio-{{ b.template_id | default: 'all' }}"
  data-t-working="{{ b.working_text | escape }}"
  data-steps="{{ b.loading_steps | escape }}"
  data-t-wait="{{ b.loading_wait | escape }}"
  data-t-ready="{{ b.loading_ready | default: '¡Listo!' | escape }}"
  {%- assign example_media = product.media[1] | default: product.featured_media -%}
  data-example="{{ example_media | image_url: width: 900 }}"
  data-t-error="{{ b.error_text | escape }} Si sigue sin salir, escríbenos a hola@arsnoir.com y te la preparamos nosotros."
  data-t-limit="{{ b.limit_text | escape }}"
  data-t-left="{{ b.left_text | escape }}"
  data-t-missing="{{ b.missing_text | escape }}"
  data-t-busy="Hay mucha gente creando ahora mismo: seguimos intentándolo…"
  data-t-image="No hemos podido leer esa foto. Prueba con otra en JPG o PNG."
  {{ block.shopify_attributes }}>
  {%- if b.endpoint == blank -%}
    <p class="tstudio__soon">{{ b.soon_text }}</p>
  {%- else -%}
    {%- comment -%} What happens, before anything is asked: the preview is free, quick, and the format comes after {%- endcomment -%}
    <ul class="tpromise" role="list">
      <li><span>Ves tu ilustración <b>gratis</b> antes de pagar</span></li>
      <li>Suele estar en menos de un minuto</li>
      <li>Después eliges póster, lienzo y marco</li>
    </ul>
    {%- if b.ba_photo != blank and b.ba_result != blank -%}
      {%- comment -%} Before / after: a real photo and the illustration this style made from it {%- endcomment -%}
      <div class="tba">
        <figure class="tba__pic">{{ b.ba_photo | image_url: width: 240 | image_tag: loading: 'lazy', alt: 'Foto original' }}<figcaption>Antes</figcaption></figure>
        <span class="tba__arrow" aria-hidden="true">→</span>
        <figure class="tba__pic tba__pic--art">{{ b.ba_result | image_url: width: 240 | image_tag: loading: 'lazy', alt: 'La ilustración hecha con esa foto' }}<figcaption>Después</figcaption></figure>
        {%- if b.ba_note != blank -%}<p class="tba__note">{{ b.ba_note }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- render 'howto-button', product: product -%}
    {%- if b.allow_pair -%}
      {%- comment -%} One or two pets: with two, a second photo (and name) and the illustration comes out horizontal {%- endcomment -%}
      <div class="tstudio__opts tpair" role="radiogroup" aria-label="¿Cuántas mascotas?">
        <span class="tstudio__opts-label">¿Cuántas mascotas?</span>
        <label class="tstudio__font"><input type="radio" name="tpair-{{ section_id }}" value="1" checked data-tpair><span>1 mascota</span></label>
        <label class="tstudio__font"><input type="radio" name="tpair-{{ section_id }}" value="2" data-tpair><span>2 mascotas · horizontal</span></label>
      </div>
    {%- endif -%}
    <p class="vstep__head"><span class="vstep__num">1</span><span class="vstep__title">{{ b.photo_label }}</span></p>
    {%- comment -%} Upload, plain and big: a dashed square with a + (the photo shows inside once chosen), a black button, the formats {%- endcomment -%}
    <label class="tstudio__drop" for="TStudio-{{ section_id }}">
      <input class="tstudio__file" id="TStudio-{{ section_id }}" type="file" accept="image/jpeg,image/png,image/webp" data-tstudio-file>
      <img class="tstudio__thumb" alt="" width="128" height="160" data-tstudio-thumb hidden>
      <span class="tstudio__plus" aria-hidden="true"></span>
      <span class="visually-hidden" data-tstudio-drop-text>{{ b.photo_cta }}</span>
    </label>
    <label class="tstudio__pick" for="TStudio-{{ section_id }}" data-tstudio-pick><span data-tstudio-pick-text>Sube tu foto</span> <span aria-hidden="true">→</span></label>
    <p class="tstudio__formats">JPG o PNG · Desde la galería del móvil o el ordenador</p>
    <div class="tmob" data-tmob hidden>
      <button type="button" class="tmob__toggle" data-tmob-toggle aria-expanded="false">¿Tienes la foto en el móvil? <u>Ábrelo allí</u></button>
      <div class="tmob__box" data-tmob-box hidden>
        <div class="tmob__qr" data-tmob-qr aria-hidden="true"></div>
        <div class="tmob__txt">
          <p><b>Escanea con la cámara del móvil</b> y sigue desde allí: se abre esta misma página.</p>
          <button type="button" class="tmob__copy" data-tmob-copy>Copiar enlace</button> <span class="tmob__ok" data-tmob-ok role="status"></span>
        </div>
      </div>
    </div>
    <script src="{{ 'qrcode-generator.min.js' | asset_url }}" defer></script>
    <script>
      (function () {
        var w = document.currentScript.previousElementSibling.previousElementSibling;
        if (!w || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        w.hidden = false;
        var url = location.origin + location.pathname + '?utm_source=web&utm_medium=qr_movil';
        var box = w.querySelector('[data-tmob-box]'), t = w.querySelector('[data-tmob-toggle]'), done = false;
        t.addEventListener('click', function () {
          box.hidden = !box.hidden; t.setAttribute('aria-expanded', String(!box.hidden));
          if (!done && window.qrcode) { var q = qrcode(0, 'M'); q.addData(url); q.make(); w.querySelector('[data-tmob-qr]').innerHTML = q.createSvgTag({ cellSize: 4, margin: 2, scalable: true }); done = true; }
        });
        w.querySelector('[data-tmob-copy]').addEventListener('click', function () {
          var ok = w.querySelector('[data-tmob-ok]');
          (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject()).then(function () { ok.textContent = 'Copiado'; }, function () { ok.textContent = url; });
        });
      })();
    </script>
    {%- if b.allow_pair -%}
      <div class="tpair__second" data-tpair-box hidden>
        <p class="tpair__label">Foto de la segunda mascota</p>
        <label class="tstudio__drop tstudio__drop--second" for="TStudio2-{{ section_id }}">
          <input class="tstudio__file" id="TStudio2-{{ section_id }}" type="file" accept="image/jpeg,image/png,image/webp" data-tstudio-file2>
          <img class="tstudio__thumb" alt="" width="128" height="160" data-tstudio-thumb2 hidden>
          <span class="tstudio__plus" aria-hidden="true"></span>
          <span class="visually-hidden">Elige la foto de la segunda mascota</span>
        </label>
      </div>
    {%- endif -%}

    <script>
      (function () {
        var p = document.querySelector('[data-tstudio-pick]');
        var i = document.getElementById('TStudio-{{ section_id }}');
        if (i && p) i.addEventListener('change', function () { if (i.files && i.files.length) p.querySelector('[data-tstudio-pick-text]').textContent = 'Cambiar foto'; });
      })();
    </script>
    {%- comment -%} One short line: pet templates work with any furry pet (the prompts say «the pet / the animal») {%- endcomment -%}
    {%- capture pets_ok -%}{%- unless b.template_id contains 'familia' or b.template_id contains 'momento' or b.template_id contains 'pareja' -%}Perros, gatos, conejos… cualquier mascota.{%- endunless -%}{%- endcapture -%}
    {%- if b.photo_hint != blank or pets_ok != blank -%}<p class="tstudio__hint">{{ pets_ok }}{% if pets_ok != blank and b.photo_hint != blank %} {% endif %}{{ b.photo_hint }}</p>{%- endif -%}

    {%- assign has_text = false -%}
    {%- if b.needs_name or b.text_optional -%}{%- assign has_text = true -%}{%- endif -%}
    {%- if has_text -%}
      <p class="vstep__head"><span class="vstep__num">2</span><span class="vstep__title">{% if b.needs_name %}{{ b.name_label }}{% else %}{{ b.text_label }}{% endif %}</span></p>
      <input class="tstudio__name" type="text" maxlength="24" autocomplete="off" placeholder="{% if b.needs_name %}{{ b.name_placeholder | escape }}{% else %}{{ b.text_placeholder | escape }}{% endif %}" data-tstudio-name>
      {%- if b.allow_pair -%}<input class="tstudio__name tpair__name2" type="text" maxlength="24" autocomplete="off" placeholder="Nombre de la segunda (ej. LUNA)" data-tstudio-name2 hidden>{%- endif -%}
      {%- if b.show_fonts -%}
        {%- comment -%} Keys must match FONTS in workers/plantillas/worker.js {%- endcomment -%}
        <div class="tstudio__opts" role="radiogroup" aria-label="{{ b.font_label | escape }}">
          <span class="tstudio__opts-label">{{ b.font_label }}</span>
          {%- assign fonts = 'pincel|Pincel,manuscrita|Manuscrita,clasica|Clásica,moderna|Moderna' | split: ',' -%}
          {%- for f in fonts -%}
            {%- assign fk = f | split: '|' | first -%}
            <label class="tstudio__font tstudio__font--{{ fk }}">
              <input type="radio" name="tstudio-font-{{ section_id }}" value="{{ fk }}"{% if fk == b.default_font %} checked{% endif %} data-tstudio-font>
              <span>{{ f | split: '|' | last }}</span>
            </label>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
    {%- if b.colors != blank -%}
      {%- comment -%} One per line: key|Name|#hex — keys must match the template's colours in workers/plantillas/templates.js {%- endcomment -%}
      <div class="tstudio__opts" role="radiogroup" aria-label="{{ b.color_label | escape }}">
        <span class="tstudio__opts-label">{{ b.color_label }}</span>
        {%- assign color_lines = b.colors | newline_to_br | split: '<br />' -%}
        {%- for line in color_lines -%}
          {%- assign parts = line | strip | split: '|' -%}
          {%- if parts.size < 3 -%}{%- continue -%}{%- endif -%}
          <label class="tstudio__color" title="{{ parts[1] | strip | escape }}">
            <input type="radio" name="tstudio-color-{{ section_id }}" value="{{ parts[0] | strip }}" data-label="{{ parts[1] | strip | escape }}"{% if forloop.first %} checked{% endif %} data-tstudio-color>
            <span style="background: {{ parts[2] | strip }}"></span>
            <em>{{ parts[1] | strip }}</em>
          </label>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if b.show_border -%}
      {%- comment -%} Saved in the order as «Borde»: the print file is prepared full-bleed or with a white margin {%- endcomment -%}
      <div class="tstudio__opts" role="radiogroup" aria-label="{{ b.border_label | escape }}">
        <span class="tstudio__opts-label">{{ b.border_label }}</span>
        <label class="tstudio__font">
          <input type="radio" name="tstudio-border-{{ section_id }}" value="{{ b.border_full | escape }}" checked data-tstudio-border>
          <span>{{ b.border_full }}</span>
        </label>
        <label class="tstudio__font">
          <input type="radio" name="tstudio-border-{{ section_id }}" value="{{ b.border_white | escape }}" data-white="true" data-tstudio-border>
          <span>{{ b.border_white }}</span>
        </label>
      </div>
      <input type="hidden" name="properties[Borde]" value="{{ b.border_full | escape }}" form="{{ form_id }}" data-tstudio-border-prop>
    {%- endif -%}

    <button type="button" class="button tstudio__go" data-tstudio-go disabled>{{ b.button_label }}</button>
    <p class="tstudio__status" role="status" aria-live="polite" data-tstudio-status></p>

    <figure class="tstudio__result" data-tstudio-result hidden>
      {%- comment -%} Watermark on screen only: the order and the email get the clean image {%- endcomment -%}
      <div class="tstudio__shot">
        <img alt="{{ b.result_alt | escape }}" width="720" height="900" data-tstudio-img>
        <span class="pv-mark" aria-hidden="true"></span>
      </div>
      <figcaption>{{ b.result_note }}</figcaption>
    </figure>
    {%- if b.accessories != blank -%}
      {%- comment -%} Optional step once the illustration exists: the AI adds a collar, hat… on top of the SAME illustration.
        One per line: key|Name|emoji — keys must match ACCESSORIES in workers/plantillas/worker-dashboard.js {%- endcomment -%}
      <div class="tacc" data-tacc hidden>
        <p class="tacc__head">{{ b.acc_title | default: '¿Le ponemos algo?' }} <span>(opcional)</span></p>
        <p class="tacc__sub">{{ b.acc_text | default: 'Lo añadimos sobre su misma ilustración. Elige hasta 2.' }}</p>
        <div class="tacc__list">
          {%- assign acc_lines = b.accessories | newline_to_br | split: '<br />' -%}
          {%- for line in acc_lines -%}
            {%- assign parts = line | strip | split: '|' -%}
            {%- if parts.size < 2 -%}{%- continue -%}{%- endif -%}
            <label class="tacc__item">
              <input type="checkbox" value="{{ parts[0] | strip }}" data-label="{{ parts[1] | strip | escape }}" data-tacc-item>
              <span>{% if parts[2] != blank %}<i aria-hidden="true">{{ parts[2] | strip }}</i>{% endif %}{{ parts[1] | strip }}</span>
            </label>
          {%- endfor -%}
        </div>
        <button type="button" class="button tacc__go" data-tacc-go disabled>{{ b.acc_button | default: 'Añadir a su ilustración' }}</button>
        <button type="button" class="tacc__undo" data-tacc-undo hidden>Quitar los accesorios</button>
        <p class="tacc__status" role="status" aria-live="polite" data-tacc-status></p>
      </div>
      <input type="hidden" name="properties[Accesorios]" value="" form="{{ form_id }}" data-tacc-prop>
    {%- endif -%}
    {%- comment -%} Straight from the preview to the size step (it sits under the studio, out of sight on mobile) {%- endcomment -%}
    <div class="tstudio__next tnext" data-tstudio-next hidden>
      <p class="tnext__ok">✓ Tu retrato está listo</p>
      <ol class="tnext__steps">
        <li><span>1</span>Elige el tamaño</li>
        <li><span>2</span>Lámina sola o con marco</li>
        <li><span>3</span>Pulsa «Añadir al carrito»</li>
      </ol>
      {%- assign tv = product.selected_or_first_available_variant -%}
      <p class="tnext__sum"><span class="tnext__sum-l">Tu elección:</span> <span data-tnext-variant></span> <b data-tnext-price>{{ tv.price | money }}</b></p>
      <button type="button" class="button button--accent tstudio__next-btn" data-tstudio-next-go>Elegir tamaño y marco ↓</button>
      <ul class="tnext__get">
        <li>Recibes tu retrato impreso <b>sin marca de agua</b>: la marca solo sale en esta vista previa.</li>
        <li>Llega en {{ settings.delivery_min | default: 4 }}-{{ settings.delivery_max | default: 10 }} días hábiles{% if settings.free_shipping_threshold > 0 %} · Envío gratis desde {{ settings.free_shipping_threshold }} €{% endif %}.</li>
        <li>−10 % en tu primer pedido con el código <b>WELCOME10</b> (no se suma a otras ofertas).</li>
      </ul>
    </div>

    {%- comment -%} «Send it to me»: the illustration by email (worker /send) and, only with the box ticked, a subscriber tagged «ilustracion» {%- endcomment -%}
    <div class="tsend" data-tstudio-send hidden>
      <p class="tsend__title">¿Te la guardamos? 💌</p>
      <p class="tsend__text">Te la enviamos por email para que la enseñes o la pidas más tarde.</p>
      <div class="tsend__row">
        <label class="visually-hidden" for="TSendEmail-{{ section_id }}">Tu email</label>
        <input class="tsend__email" id="TSendEmail-{{ section_id }}" type="email" placeholder="Tu email" autocomplete="email" inputmode="email" data-tstudio-send-email>
        <button type="button" class="button tsend__go" data-tstudio-send-go>Envíamela</button>
      </div>
      <label class="tsend__opt"><input type="checkbox" data-tstudio-send-consent> Quiero recibir ofertas y novedades de ARSNOIR (opcional)</label>
      <p class="tsend__msg" role="status" aria-live="polite" data-tstudio-send-msg></p>
      <p class="tsend__legal">Usamos tu email para enviarte esta ilustración{% if shop.privacy_policy %} · <a href="{{ shop.privacy_policy.url }}">Privacidad</a>{% endif %}.</p>
    </div>

    {%- comment -%} No box to tick: adding to the cart is the confirmation, and it is still saved in the order {%- endcomment -%}
    <input type="hidden" name="properties[Derechos de imagen]" value="Confirmados al añadir al carrito" form="{{ form_id }}">
    <p class="cguard__rights-note">Al añadir al carrito confirmas que tienes derecho a usar esta foto.</p>

    <input type="hidden" name="properties[_Ilustración]" form="{{ form_id }}" data-tstudio-url>
    <input type="hidden" name="properties[Plantilla]" value="{{ b.template_name | escape }}" form="{{ form_id }}">
    {%- if has_text -%}<input type="hidden" name="properties[{% if b.needs_name %}Nombre{% else %}Texto{% endif %}]" form="{{ form_id }}" data-tstudio-name-prop>{%- endif -%}
    {%- if b.show_fonts and has_text -%}<input type="hidden" name="properties[Letra]" form="{{ form_id }}" data-tstudio-font-prop>{%- endif -%}
    {%- if b.colors != blank -%}<input type="hidden" name="properties[Color]" form="{{ form_id }}" data-tstudio-color-prop>{%- endif -%}
    {%- if b.allow_pair -%}<input type="hidden" name="properties[Mascotas]" form="{{ form_id }}" data-tpair-prop><input type="hidden" name="properties[Nombre 2]" form="{{ form_id }}" data-tpair-name-prop>{%- endif -%}
  {%- endif -%}
</div>
{%- comment -%} Mobile: the gallery fills the first screen, so the upload box starts out of sight {%- endcomment -%}
<button type="button" class="tjump" data-tstudio-jump hidden><span class="tjump__main">Sube su foto</span><span class="tjump__sub">Lo ves gratis antes de pagar</span></button>
<script src="{{ 'template-studio.js' | asset_url }}" defer></script>
