{%- comment -%}
  "Mírala en tu pared": the artwork on a wall at real scale. It follows the
  selected size and frame (see theme.js → wall-preview).
{%- endcomment -%}
{%- liquid
  assign bs = block.settings
  assign art = product.featured_media
  assign room_keys = 'salón,dormitorio,estudio' | split: ','
  assign room_labels = 'Salón,Dormitorio,Estudio' | split: ','
  assign room_photos = 0
  for key in room_keys
    assign needle = 'en un ' | append: key
    for m in product.media
      assign alt = m.alt | downcase
      if alt contains needle
        assign room_photos = room_photos | plus: 1
        break
      endif
    endfor
  endfor
-%}
{%- if room_photos > 0 -%}
{%- comment -%} The artwork's own room photos (alt «… en un salón / dormitorio / estudio»). {%- endcomment -%}
<wall-preview class="wallp wallp--photos" data-photos {{ block.shopify_attributes }}>
  <div class="wallp__head">
    <p class="wallp__title">{{ bs.heading }}</p>
    <div class="wallp__tabs" role="tablist">
      {%- assign n = 0 -%}
      {%- for key in room_keys -%}
        {%- assign ri = forloop.index -%}
        {%- assign rlabel = room_labels[forloop.index0] -%}
        {%- assign needle = 'en un ' | append: key -%}
        {%- for m in product.media -%}
          {%- assign alt = m.alt | downcase -%}
          {%- if alt contains needle -%}
            {%- assign n = n | plus: 1 -%}
            <button type="button" class="wallp__tab" role="tab" data-room="{{ ri }}" aria-selected="{% if n == 1 %}true{% else %}false{% endif %}">{{ rlabel }}</button>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="wallp__stage" data-stage>
    {%- assign n = 0 -%}
    {%- for key in room_keys -%}
      {%- assign ri = forloop.index -%}
      {%- assign needle = 'en un ' | append: key -%}
      {%- for m in product.media -%}
        {%- assign alt = m.alt | downcase -%}
        {%- if alt contains needle -%}
          {%- assign n = n | plus: 1 -%}
          {%- liquid
            assign slug = key | replace: 'ó', 'o'
            assign base = product.handle | append: '-' | append: slug
            assign black_src = m | image_url: width: 1200
            assign white_src = base | append: '-white.jpg' | file_url
            assign wood_src = base | append: '-wood.jpg' | file_url
            assign none_src = base | append: '-none.jpg' | file_url
          -%}
          <div class="wallp__room{% if n == 1 %} is-active{% endif %}" data-room-panel="{{ ri }}">
            {{ m | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 40vw, 90vw', alt: m.alt, data-black: black_src, data-white: white_src, data-wood: wood_src, data-none: none_src }}
          </div>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</wall-preview>
{%- else -%}
<wall-preview class="wallp" data-default-size="{{ bs.default_size | escape }}" {{ block.shopify_attributes }}>
  <div class="wallp__head">
    <p class="wallp__title">{{ bs.heading }}</p>
    <div class="wallp__tabs" role="tablist">
      {%- for i in (1..3) -%}
        {%- assign label_key = 'room_' | append: i | append: '_label' -%}
        {%- if bs[label_key] != blank -%}
          <button type="button" class="wallp__tab" role="tab" data-room="{{ i }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ bs[label_key] }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="wallp__stage" data-stage>
    {%- for i in (1..3) -%}
      {%- liquid
        assign label_key = 'room_' | append: i | append: '_label'
        assign image_key = 'room_' | append: i | append: '_image'
        assign wall_key = 'room_' | append: i | append: '_wall'
        assign bottom_key = 'room_' | append: i | append: '_bottom'
        assign ref_key = 'room_' | append: i | append: '_ref'
      -%}
      {%- if bs[label_key] != blank -%}
        <div class="wallp__room wallp__room--{{ i }}{% if forloop.first %} is-active{% endif %}" data-room-panel="{{ i }}" data-wall="{{ bs[wall_key] }}" data-bottom="{{ bs[bottom_key] }}" data-ref="{{ bs[ref_key] | escape }}">
          {%- if bs[image_key] != blank -%}
            {{ bs[image_key] | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 40vw, 90vw', alt: bs[label_key] }}
          {%- else -%}
            <span class="wallp__wall"></span>
            <span class="wallp__floor"></span>
            <span class="wallp__furniture" aria-hidden="true"><span></span></span>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    <div class="wallp__art" data-art data-frame="none">
      <div class="wallp__paper">
        {%- if art -%}
          {{ art | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '20vw', alt: product.title }}
        {%- else -%}
          <span class="wallp__ph"></span>
        {%- endif -%}
      </div>
    </div>
  </div>

  <p class="wallp__caption"><strong data-wallp-size></strong> <span data-wallp-ref></span></p>
</wall-preview>
{%- endif -%}
