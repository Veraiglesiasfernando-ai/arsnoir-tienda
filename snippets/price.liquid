{%- comment -%}
  Renders a product or variant price.
  - product: product object (required)
  - variant: optional variant object; when given, shows that variant's price
  - show_from: show «Desde <lowest price>» when prices vary (for cards)
  - show_save: with a compare-at price, add a «−X €» saving tag (product page)
  - show_split: with show_from, say both «Lámina desde … · Con marco desde …» (taken from the real
    variants) instead of the single lowest price. Not used on cards for now: one short price reads better.
{%- endcomment -%}
{%- liquid
  if variant
    assign price = variant.price
    assign compare = variant.compare_at_price
  else
    assign price = product.price
    assign compare = product.compare_at_price
  endif
  assign print_min = 0
  assign framed_min = 0
  if show_split and show_from and product.price_varies
    for v in product.variants
      unless v.available
        continue
      endunless
      assign t = v.title | downcase
      # Canvas is its own format: it counts neither as the print nor as the framed print
      if t contains 'canvas' or t contains 'lienzo'
        continue
      endif
      assign framed = false
      if t contains 'framed'
        assign framed = true
      elsif t contains 'marco'
        assign framed = true
        if t contains 'sin marco'
          assign framed = false
        endif
      endif
      if framed
        if framed_min == 0 or v.price < framed_min
          assign framed_min = v.price
        endif
      elsif print_min == 0 or v.price < print_min
        assign print_min = v.price
      endif
    endfor
  endif
-%}
<span class="price{% if print_min > 0 and framed_min > 0 %} price--split{% endif %}">
  {%- if print_min > 0 and framed_min > 0 -%}
    <span class="price__line">{{ 'general.print_from' | t }} <b>{{ print_min | money }}</b></span>
    <span class="price__line">{{ 'general.framed_from' | t }} <b>{{ framed_min | money }}</b></span>
  {%- elsif show_from and product.price_varies -%}
    {%- comment -%}
      «From» = the cheapest print (or the cheapest variant if there is no print), at today's price with
      offers (snippets/deal-price.liquid), its earlier price struck through when it has one. Then, when the
      cheapest framed print also has an earlier price, «Con marco 54,95 € 34,95 €». Only two variants are
      priced through deal-price, to keep collection pages light.
    {%- endcomment -%}
    {%- assign sorted_v = product.variants | sort: 'price' -%}
    {%- assign pv = nil -%}{%- assign fv = nil -%}{%- assign anyv = nil -%}
    {%- for v in sorted_v -%}
      {%- unless v.available -%}{%- continue -%}{%- endunless -%}
      {%- if anyv == nil -%}{%- assign anyv = v -%}{%- endif -%}
      {%- assign vt = v.title | downcase -%}
      {%- if vt contains 'canvas' or vt contains 'lienzo' or vt contains 'mixpix' -%}{%- continue -%}{%- endif -%}
      {%- assign vf = false -%}
      {%- if vt contains 'frame' or vt contains 'marco' -%}{%- assign vf = true -%}{%- endif -%}
      {%- if vt contains 'sin marco' -%}{%- assign vf = false -%}{%- endif -%}
      {%- if vf -%}
        {%- if fv == nil -%}{%- assign fv = v -%}{%- endif -%}
      {%- elsif pv == nil -%}
        {%- assign pv = v -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign min_framed = false -%}
    {%- if pv == nil -%}
      {%- assign pv = fv | default: anyv -%}
      {%- if fv -%}{%- assign min_framed = true -%}{%- endif -%}
    {%- endif -%}
    {%- assign from_p = product.price_min -%}{%- assign from_c = 0 -%}
    {%- if pv -%}
      {%- capture dp -%}{% render 'deal-price', variant: pv, product: product %}{%- endcapture -%}
      {%- assign dps = dp | strip | split: '|' -%}
      {%- assign from_p = dps[0] | plus: 0 -%}{%- assign from_c = dps[1] | plus: 0 -%}
    {%- endif -%}
    {% if min_framed %}{{ 'general.from' | t }}{% else %}{{ 'general.print_from' | t }}{% endif %} {{ from_p | money }}
    {%- if from_c > from_p %} <s class="muted">{{ from_c | money }}</s>{%- endif -%}
    {%- if fv and min_framed == false -%}
      {%- capture dpf -%}{% render 'deal-price', variant: fv, product: product %}{%- endcapture -%}
      {%- assign dfs = dpf | strip | split: '|' -%}
      {%- assign fp = dfs[0] | plus: 0 -%}{%- assign fc = dfs[1] | plus: 0 -%}
      {%- if fc > fp -%}
        <span class="price__deal">{{ 'general.framed_from' | t | default: 'Con marco desde' }} {{ fp | money }} <s>{{ fc | money }}</s></span>
      {%- endif -%}
    {%- endif -%}
  {%- else -%}
    {%- if compare > price -%}<s class="muted">{{ compare | money }}</s>{%- endif -%}
    <span>{{ price | money }}</span>
    {%- if show_save and compare > price -%}<span class="price__save">−{{ compare | minus: price | money }}</span>{%- endif -%}
  {%- endif -%}
</span>
