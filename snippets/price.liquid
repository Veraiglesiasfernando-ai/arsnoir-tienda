{%- comment -%}
  Renders a product or variant price.
  - product: product object (required)
  - variant: optional variant object; when given, shows that variant's price
  - show_from: show «Desde <lowest price>» when prices vary (for cards)
  - show_save: with a compare-at price, add a «−X €» saving tag (product page)
  - show_split: with show_from, say both «Lámina desde … · Con marco desde …» (taken from the real
    variants) instead of the single lowest price. Not used on cards for now: one short price reads better.
{%- endcomment -%}
{%- liquid
  if variant
    assign price = variant.price
    assign compare = variant.compare_at_price
  else
    assign price = product.price
    assign compare = product.compare_at_price
  endif
  assign print_min = 0
  assign framed_min = 0
  if show_split and show_from and product.price_varies
    for v in product.variants
      unless v.available
        continue
      endunless
      assign t = v.title | downcase
      # Canvas is its own format: it counts neither as the print nor as the framed print
      if t contains 'canvas' or t contains 'lienzo'
        continue
      endif
      assign framed = false
      if t contains 'framed'
        assign framed = true
      elsif t contains 'marco'
        assign framed = true
        if t contains 'sin marco'
          assign framed = false
        endif
      endif
      if framed
        if framed_min == 0 or v.price < framed_min
          assign framed_min = v.price
        endif
      elsif print_min == 0 or v.price < print_min
        assign print_min = v.price
      endif
    endfor
  endif
-%}
<span class="price{% if print_min > 0 and framed_min > 0 %} price--split{% endif %}">
  {%- if print_min > 0 and framed_min > 0 -%}
    <span class="price__line">{{ 'general.print_from' | t }} <b>{{ print_min | money }}</b></span>
    <span class="price__line">{{ 'general.framed_from' | t }} <b>{{ framed_min | money }}</b></span>
  {%- elsif show_from and product.price_varies -%}
    {%- comment -%} Say what the «from» price buys: usually the unframed print {%- endcomment -%}
    {%- assign min_v = product.variants | sort: 'price' | first -%}
    {%- assign min_t = min_v.title | downcase -%}
    {%- assign min_framed = false -%}
    {%- if min_t contains 'frame' or min_t contains 'marco' -%}{%- assign min_framed = true -%}{%- endif -%}
    {%- if min_t contains 'sin marco' -%}{%- assign min_framed = false -%}{%- endif -%}
    {% if min_framed %}{{ 'general.from' | t }}{% else %}{{ 'general.print_from' | t }}{% endif %} {{ product.price_min | money }}
    {%- comment -%}
      Cards: when some variants have a real earlier price (compare-at), also show the cheapest of
      them struck through, e.g. «Con marco 39,95 € 34,95 €». Only variants that carry it count.
    {%- endcomment -%}
    {%- assign deal_v = nil -%}
    {%- for v in product.variants -%}
      {%- if v.available and v.compare_at_price > v.price -%}
        {%- if deal_v == nil or v.price < deal_v.price -%}{%- assign deal_v = v -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if deal_v -%}
      <span class="price__deal">{{ 'general.framed_from' | t | default: 'Con marco' | split: ' desde' | first }} <s>{{ deal_v.compare_at_price | money }}</s> <b>{{ deal_v.price | money }}</b></span>
    {%- endif -%}
  {%- else -%}
    {%- if compare > price -%}<s class="muted">{{ compare | money }}</s>{%- endif -%}
    <span>{{ price | money }}</span>
    {%- if show_save and compare > price -%}<span class="price__save">−{{ compare | minus: price | money }}</span>{%- endif -%}
  {%- endif -%}
</span>
