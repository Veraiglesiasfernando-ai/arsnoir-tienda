{%- comment -%}
  Product card for grids.
  - product: product object (blank renders a placeholder card)
  - lazy: boolean, lazy-load image (default true)
{%- endcomment -%}
{%- liquid
  assign ratio_class = 'card__media--' | append: settings.card_ratio
  assign load = 'lazy'
  if lazy == false
    assign load = 'eager'
  endif
-%}
{%- if product != blank -%}
  <a href="{{ product.url }}" class="card">
    <div class="card__media {{ ratio_class }}">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 900 | image_tag:
          loading: load,
          widths: '300, 450, 600, 900',
          sizes: '(min-width: 1100px) 22vw, (min-width: 750px) 30vw, 45vw',
          alt: product.featured_media.alt | default: product.title
        }}
        {%- if product.media.size > 1 -%}
          {{ product.media[1] | image_url: width: 900 | image_tag:
            loading: 'lazy',
            class: 'card__img--hover',
            widths: '300, 450, 600, 900',
            sizes: '(min-width: 1100px) 22vw, (min-width: 750px) 30vw, 45vw',
            alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
      {%- unless product.available -%}
        <span class="card__badge">Agotado</span>
      {%- else -%}
        {%- if product.compare_at_price > product.price -%}<span class="card__badge">Rebajas</span>{%- endif -%}
      {%- endunless -%}
    </div>
    <div class="card__info">
      {%- if settings.card_show_vendor -%}<div class="card__vendor">{{ product.vendor }}</div>{%- endif -%}
      <h3 class="card__title">{{ product.title }}</h3>
      <div class="card__price">{% render 'price', product: product, show_from: true %}</div>
    </div>
  </a>
{%- else -%}
  <div class="card">
    <div class="card__media {{ ratio_class }}">
      {%- assign ph_index = placeholder_index | default: 1 -%}
      {{ 'product-' | append: ph_index | placeholder_svg_tag }}
    </div>
    <div class="card__info">
      <h3 class="card__title">Título de la obra</h3>
      <div class="card__price">Desde 45,00 €</div>
    </div>
  </div>
{%- endif -%}
