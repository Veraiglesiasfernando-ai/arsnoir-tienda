{%- comment -%}
  Product card for grids.
  - product: product object (blank renders an empty framed placeholder)
  - lazy: boolean, lazy-load image (default true)
  - placeholder_index: number used for the placeholder title ("Obra 01")
  - placeholder_price: price text for the placeholder
{%- endcomment -%}
{%- liquid
  assign ratio_class = 'card__media--' | append: settings.card_ratio
  assign load = 'lazy'
  if lazy == false
    assign load = 'eager'
  endif
-%}
{%- if product != blank -%}
  <a href="{{ product.url }}" class="card{% if settings.card_frame %} card--framed{% endif %}">
    <div class="card__media {{ ratio_class }}">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 900 | image_tag:
          loading: load,
          widths: '300, 450, 600, 900',
          sizes: '(min-width: 1100px) 22vw, (min-width: 750px) 30vw, 45vw',
          alt: product.featured_media.alt | default: product.title
        }}
      {%- else -%}
        {% render 'frame-placeholder' %}
      {%- endif -%}
      {%- unless product.available -%}
        <span class="card__badge">Agotado</span>
      {%- endunless -%}
    </div>
    <div class="card__info">
      <h3 class="card__title">{{ product.title }}</h3>
      <div class="card__price">{% render 'price', product: product, show_from: true %}</div>
    </div>
  </a>
{%- else -%}
  {%- assign ph_index = placeholder_index | default: 1 -%}
  <div class="card">
    <div class="card__media {{ ratio_class }}">
      {% render 'frame-placeholder' %}
    </div>
    <div class="card__info">
      <h3 class="card__title">Obra {{ ph_index | prepend: '0' | slice: -2, 2 }}</h3>
      <div class="card__price">{{ placeholder_price | default: '39,95 €' }}</div>
    </div>
  </div>
{%- endif -%}
