{%- comment -%}
  Product card: square glass frame with photo-mount corners.
  - product: product object (blank renders an empty placeholder)
  - index: position number, shown as [001]
  - lazy: boolean (default true)
  - placeholder_price: price text for the placeholder
{%- endcomment -%}
{%- liquid
  assign load = 'lazy'
  if lazy == false
    assign load = 'eager'
  endif
  assign idx = index | default: 1
  assign idx_label = '00' | append: idx | slice: -3, 3
-%}
{%- if product != blank -%}
  <a href="{{ product.url }}" class="art-card">
    {% render 'glass-card', image: product.featured_media.preview_image, tone: 'light', loading: load, sizes: '(min-width: 900px) 24vw, 70vw' %}
    <div class="art-card__info">
      <span class="art-card__index">[{{ idx_label }}]</span>
      <h3 class="art-card__title">{{ product.title }}</h3>
      <span class="art-card__price">
        {%- unless product.available -%}Agotado{%- else -%}{% render 'price', product: product, show_from: true %}{%- endunless -%}
      </span>
    </div>
  </a>
{%- else -%}
  <div class="art-card">
    {% render 'glass-card', tone: 'light' %}
    <div class="art-card__info">
      <span class="art-card__index">[{{ idx_label }}]</span>
      <h3 class="art-card__title">Obra {{ idx_label }}</h3>
      <span class="art-card__price">{{ placeholder_price | default: '39,95 €' }}</span>
    </div>
  </div>
{%- endif -%}
