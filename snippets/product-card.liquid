{%- comment -%}
  Product card: the same 4:5 poster used in the hero, so every listing matches.
  - product: product object (blank renders an empty placeholder)
  - index: position number, shown as [001]
  - lazy: boolean (default true)
  - placeholder_price: price text for the placeholder
{%- endcomment -%}
{%- liquid
  assign load = 'lazy'
  if lazy == false
    assign load = 'eager'
  endif
  assign idx = index | default: 1
  assign idx_label = '00' | append: idx | slice: -3, 3
  assign tone_i = idx | modulo: 3
  if tone_i == 1
    assign tone = 'dark'
  elsif tone_i == 2
    assign tone = 'light'
  else
    assign tone = 'accent'
  endif
-%}
{%- if product != blank -%}
  <div class="card-wrap">
  <a href="{{ product.url }}" class="poster poster--{{ tone }} art-card">
    <div class="poster__frame">
      <div class="poster__media">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 900 | image_tag:
            loading: load,
            widths: '300, 450, 600, 900',
            sizes: '(min-width: 1100px) 24vw, (min-width: 750px) 32vw, 48vw',
            alt: product.featured_media.alt | default: product.title
          }}
        {%- else -%}
          <div class="poster__ph" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      {%- liquid
        # Real labels only: from the collections the work is in, and the live pack offer
        assign is_best = false
        assign is_new = false
        assign is_obra = false
        for c in product.collections
          case c.handle
            when 'mas-vendidos'
              assign is_best = true
            when 'novedades'
              assign is_new = true
            when 'obras'
              assign is_obra = true
          endcase
        endfor
        assign pack_pct = settings.pack_percent | default: 0
        assign today = 'now' | date: '%Y-%m-%d'
        assign pack_on = false
        if is_obra and pack_pct > 0
          assign pack_on = true
          if settings.pack_until != blank and today > settings.pack_until
            assign pack_on = false
          endif
        endif
      -%}
      {%- if product.available == false -%}
        <span class="poster__tag">{{ 'cards.sold_out' | t }}</span>
      {%- elsif product.metafields.custom.edition_size.value > 0 -%}
        <span class="poster__tag">{{ 'cards.limited' | t }}</span>
      {%- elsif is_best -%}
        <span class="poster__tag">{{ 'cards.best' | t }}</span>
      {%- elsif is_new -%}
        <span class="poster__tag">{{ 'cards.new' | t }}</span>
      {%- endif -%}
      {%- if pack_on and product.available -%}
        <span class="poster__deal">{{ 'cards.pack' | t: min: settings.pack_min, pct: pack_pct }}</span>
      {%- endif -%}
      <span class="poster__cart" aria-hidden="true">{% render 'icon', name: 'bag' %}</span>
    </div>
    <span class="poster__info">
      <span class="poster__meta">
        <span class="poster__title"><span class="art-card__index">[{{ idx_label }}]</span> {{ product.title }}</span>
        <span class="poster__price">{% render 'price', product: product, show_from: true %}</span>
      </span>
      <span class="poster__plus" aria-hidden="true">+</span>
    </span>
  </a>
  {% render 'fav-button', handle: product.handle %}
  </div>
{%- else -%}
  <div class="poster poster--{{ tone }} art-card">
    <div class="poster__frame"><div class="poster__media"><div class="poster__ph" aria-hidden="true"></div></div></div>
    <span class="poster__info">
      <span class="poster__meta">
        <span class="poster__title"><span class="art-card__index">[{{ idx_label }}]</span> {{ 'cards.placeholder' | t: number: idx_label }}</span>
        <span class="poster__price">{{ placeholder_price | default: '24,95 €' }}</span>
      </span>
      <span class="poster__plus" aria-hidden="true">+</span>
    </span>
  </div>
{%- endif -%}
