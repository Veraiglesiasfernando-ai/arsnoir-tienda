{%- comment -%} Progress towards free shipping, from Configuración del tema → Conversión. {%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  if threshold > 0
    assign remaining = threshold | minus: cart.total_price
    assign pct = cart.total_price | times: 100.0 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
{%- if threshold > 0 -%}
  <div class="ship-bar{% if remaining <= 0 %} ship-bar--done{% endif %}">
    <p class="ship-bar__text">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}{{ 'cart.remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        <strong>{{ 'cart.free_shipping_done' | t }}</strong>
      {%- endif -%}
    </p>
    <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct | round }}">
      <span style="width: {{ pct }}%"></span>
    </div>
  </div>
{%- elsif settings.shipping_message != blank -%}
  <div class="ship-bar ship-bar--done ship-bar--static">
    <p class="ship-bar__text"><strong>{{ settings.shipping_message }}</strong></p>
    {%- if settings.shipping_details != blank -%}<p class="ship-bar__sub">{{ settings.shipping_details }}</p>{%- endif -%}
  </div>
{%- endif -%}
