{%- comment -%}
  Square frosted-glass card with photo-mount corners.
  - image: optional image object shown inside
  - tone: 'dark' | 'light' | 'accent' — placeholder colour when there is no image
  - label: optional text over the placeholder (e.g. "PRÓXIMAMENTE")
  - button_label / button_url: optional glass pill button at the bottom
  - sizes: image sizes attribute
  - loading: 'lazy' (default) or 'eager'
{%- endcomment -%}
<div class="glass-card glass-card--{{ tone | default: 'light' }}">
  <div class="glass-card__photo">
    {%- if image != blank -%}
      {{ image | image_url: width: 1200 | image_tag:
        loading: loading | default: 'lazy',
        widths: '400, 600, 900, 1200',
        sizes: sizes | default: '(min-width: 900px) 30vw, 80vw',
        alt: image.alt
      }}
    {%- else -%}
      <div class="glass-card__ph" aria-hidden="true"></div>
    {%- endif -%}
    <span class="glass-card__corner glass-card__corner--tl" aria-hidden="true"></span>
    <span class="glass-card__corner glass-card__corner--tr" aria-hidden="true"></span>
    <span class="glass-card__corner glass-card__corner--bl" aria-hidden="true"></span>
    <span class="glass-card__corner glass-card__corner--br" aria-hidden="true"></span>
    {%- if label != blank -%}<span class="glass-card__label">{{ label }}</span>{%- endif -%}
  </div>
  {%- if button_label != blank -%}
    <a class="glass-card__button" href="{{ button_url | default: routes.all_products_collection_url }}">
      <span>{{ button_label }}</span>
      <span class="glass-card__plus" aria-hidden="true">+</span>
    </a>
  {%- endif -%}
</div>
