{%- comment -%}
  «Otros estilos»: every illustration style in one swipeable row, so trying another one doesn't
  mean going back to Personalízalo. The photo already uploaded comes along (template-studio.js).
  - product: the product on screen (marked as the current style)
{%- endcomment -%}
{%- assign handles = 'retrato-comic,retrato-glam,tu-mascota-en-acuarela,retrato-con-nombre,retrato-con-sudadera,oleo-vintage,en-su-rincon,ilustracion-plana,navidad-papa-noel,navidad-verde,retrato-de-pareja-en-acuarela,pareja-en-acuarela-sin-rostro,familia-en-acuarela,momento-ilustrado,acuarela-en-casa' | split: ',' -%}
<nav class="pzstrip" aria-label="Otros estilos">
  <p class="pzstrip__title">Otros estilos <span>· tu foto se mantiene</span></p>
  <ul class="pzstrip__list">
    {%- for h in handles -%}
      {%- assign p = all_products[h] -%}
      {%- if p == empty or p.available == false and p.handle != product.handle -%}{%- continue -%}{%- endif -%}
      {%- liquid
        # Card image file name (the newer styles use a shorter name than their product handle)
        case h
          when 'tu-mascota-en-acuarela'
            assign card_name = 'mascota-acuarela'
          when 'retrato-de-pareja-en-acuarela'
            assign card_name = 'pareja-acuarela'
          when 'pareja-en-acuarela-sin-rostro'
            assign card_name = 'pareja-sin-rostro'
          when 'familia-en-acuarela'
            assign card_name = 'familia-acuarela'
          else
            assign card_name = h
        endcase
        assign card = 'pz-card-' | append: card_name | append: '.jpg'
        assign img = images[card]
        # Only a real uploaded image (a missing file must never break the page)
        assign img_ok = false
        if img.width > 0
          assign img_ok = true
        endif
      -%}
      <li>
        <a class="pzstrip__item{% if p.handle == product.handle %} is-current{% endif %}" href="{{ p.url }}"{% if p.handle == product.handle %} aria-current="page"{% endif %}>
          {%- if img_ok -%}
            {{ img | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, height: 100, alt: '' }}
          {%- elsif p.featured_media -%}
            {{ p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, height: 100, alt: '' }}
          {%- endif -%}
          <span>{{ p.title }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</nav>
