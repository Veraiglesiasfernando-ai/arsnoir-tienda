{%- comment -%}
  Personalízalo tile inside the artwork grid, same shape as product-card.
  - image, title, line (text under the title), url, tag, lazy
{%- endcomment -%}
{%- liquid
  assign load = 'lazy'
  if lazy == false
    assign load = 'eager'
  endif
-%}
<div class="card-wrap">
  <a href="{{ url }}" class="poster poster--light art-card pz-card">
    <div class="poster__frame">
      <div class="poster__media">
        {%- if image != blank -%}
          {{ image | image_url: width: 900 | image_tag: loading: load, widths: '300, 450, 600, 900', sizes: '(min-width: 1100px) 24vw, (min-width: 750px) 32vw, 48vw', alt: title }}
        {%- else -%}
          <div class="poster__ph" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      {%- if tag != blank -%}<span class="poster__tag pz-card__tag">{{ tag }}</span>{%- endif -%}
    </div>
    <span class="poster__info">
      <span class="poster__meta">
        <span class="poster__title">{{ title }}</span>
        <span class="poster__price">{{ line }}</span>
      </span>
      <span class="poster__plus" aria-hidden="true">&rarr;</span>
    </span>
  </a>
</div>
