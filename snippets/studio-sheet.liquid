{%- comment -%}
  Phone, portrait products: while the illustration is made and once it is ready, everything shows in a
  sheet over the page, where the customer already is (no scrolling, nothing to look for):
  their photo + progress → their portrait, the size already chosen (cheapest) with «Cambiar tamaño»,
  and «Añadir al carrito · price». Events come from assets/template-studio.js.
{%- endcomment -%}
<div class="ssheet" data-ssheet hidden role="dialog" aria-modal="true" aria-label="Tu retrato">
  <div class="ssheet__card">
    <button type="button" class="ssheet__x" data-ssheet-close aria-label="Cerrar">✕</button>
    <div class="ssheet__wait" data-ssheet-wait>
      <div class="ssheet__ph"><img data-ssheet-photo alt=""><span class="ssheet__spin" aria-hidden="true"></span></div>
      <p class="ssheet__t">Creando su retrato…</p>
      <p class="ssheet__s" data-ssheet-step>Suele estar en menos de un minuto. No cierres esta página.</p>
      <div class="ssheet__bar"><i></i></div>
    </div>
    <div class="ssheet__done" data-ssheet-done hidden>
      <p class="ssheet__ok">✓ ¡Su retrato está listo!</p>
      <img class="ssheet__art" data-ssheet-art alt="Tu retrato">
      <p class="ssheet__choice"><span data-ssheet-choice></span> <button type="button" class="ssheet__link" data-ssheet-size>Cambiar tamaño o marco</button></p>
      <button type="button" class="button button--accent ssheet__add" data-ssheet-add>Añadir al carrito</button>
      <div class="ssheet__row">
        <button type="button" class="ssheet__link" data-ssheet-close>Seguir mirando</button>
        <a class="ssheet__link" href="/collections/personalizalo#ctpl-mascotas">Probar otro estilo</a>
      </div>
    </div>
  </div>
</div>
<style>
  .ssheet { position: fixed; inset: 0; z-index: 2147482000; display: flex; align-items: flex-end; justify-content: center; background: rgba(10,10,10,.5); }
  .ssheet[hidden] { display: none; }
  .ssheet__card { position: relative; width: 100%; max-width: 520px; max-height: 92vh; overflow: auto; background: #fff; border-radius: 20px 20px 0 0; padding: 22px 18px calc(18px + env(safe-area-inset-bottom)); text-align: center; animation: ssUp .28s ease-out; }
  @keyframes ssUp { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
  .ssheet__x { position: absolute; top: 10px; right: 10px; width: 36px; height: 36px; border: 0; border-radius: 50%; background: #f1f1f1; font-size: 16px; cursor: pointer; }
  .ssheet__ph { position: relative; width: 150px; height: 150px; margin: 10px auto 14px; }
  .ssheet__ph img { width: 100%; height: 100%; object-fit: cover; border-radius: 14px; }
  .ssheet__spin { position: absolute; inset: -6px; border: 3px solid #e6e6e6; border-top-color: #0a3d5a; border-radius: 18px; animation: ssSpin 1.1s linear infinite; }
  @keyframes ssSpin { to { transform: rotate(360deg); } }
  .ssheet__t { margin: 0 0 4px; font-size: 20px; font-weight: 700; }
  .ssheet__s { margin: 0 0 14px; font-size: 14px; color: #555; min-height: 2.6em; }
  .ssheet__bar { height: 4px; border-radius: 4px; background: #eee; overflow: hidden; }
  .ssheet__bar i { display: block; height: 100%; width: 0; background: #0a3d5a; animation: ssFill 60s linear forwards; }
  @keyframes ssFill { to { width: 92%; } }
  .ssheet__ok { margin: 4px 0 10px; font-size: 18px; font-weight: 700; color: #1d6b34; }
  .ssheet__art { display: block; width: auto; max-width: 100%; max-height: 46vh; margin: 0 auto 12px; border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.18); }
  .ssheet__choice { margin: 0 0 12px; font-size: 14px; color: #333; }
  .ssheet__link { padding: 0; border: 0; background: none; color: #0a0a0a; font: inherit; font-size: 14px; text-decoration: underline; cursor: pointer; }
  .ssheet__add { width: 100%; min-height: 54px; font-size: 16px; }
  .ssheet__row { display: flex; justify-content: center; gap: 22px; margin-top: 14px; }
  html.ssheet-lock, html.ssheet-lock body { overflow: hidden; }
  @media (min-width: 990px) { .ssheet { display: none !important; } }
</style>
<script>
(function () {
  if (window.matchMedia('(min-width: 990px)').matches) return;
  var sh = document.querySelector('[data-ssheet]');
  if (!sh) return;
  document.body.appendChild(sh);
  var wait = sh.querySelector('[data-ssheet-wait]'), done = sh.querySelector('[data-ssheet-done]');
  var stepEl = sh.querySelector('[data-ssheet-step]'), addEl = sh.querySelector('[data-ssheet-add]');
  var addBtn = function () { return document.querySelector('.product__info button.pdc-add') || document.querySelector('.product__info [name="add"]'); };
  var price = function () { var b = addBtn(); var m = b && (b.textContent || '').match(/[0-9]+,[0-9]{2}\s*€/); return m ? m[0] : ''; };
  var sync = function () {
    var p = price(); addEl.textContent = 'Añadir al carrito' + (p ? ' · ' + p : '');
    var sum = document.querySelector('[data-variant-summary]');
    var t = sum && sum.textContent.trim().replace(/\s+/g, ' ');
    sh.querySelector('[data-ssheet-choice]').textContent = t ? t + (p ? ' · ' + p : '') : (p ? 'Tamaño elegido · ' + p : '');
  };
  var open = function () { window.arsnoirSheet = true; sh.hidden = false; document.documentElement.classList.add('ssheet-lock'); };
  var close = function () { sh.hidden = true; document.documentElement.classList.remove('ssheet-lock'); };
  window.arsnoirSheet = true; /* the studio must not scroll the page on phones */
  document.addEventListener('arsnoir:studio-start', function (e) {
    var ph = e.detail && e.detail.photo;
    var im = sh.querySelector('[data-ssheet-photo]');
    if (ph) im.src = ph;
    var bar = sh.querySelector('.ssheet__bar i'); bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = '';
    wait.hidden = false; done.hidden = true; open();
  });
  var st = document.querySelector('[data-tstudio-status]');
  if (st) new MutationObserver(function () { var t = st.textContent.trim(); if (t && !wait.hidden) stepEl.textContent = t; }).observe(st, { childList: true, characterData: true, subtree: true });
  document.addEventListener('arsnoir:studio-ready', function () {
    setTimeout(function () {
      var art = document.querySelector('.tlive .tlive__art') || document.querySelector('[data-tstudio-img]');
      if (!art || !art.src) return;
      sh.querySelector('[data-ssheet-art]').src = art.src;
      sync(); wait.hidden = true; done.hidden = false; open();
    }, 200);
  });
  document.addEventListener('arsnoir:studio-fail', function () {
    close();
    var s = document.querySelector('[data-tstudio]'); if (s) s.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
  var ab = addBtn(); if (ab) new MutationObserver(sync).observe(ab, { childList: true, subtree: true, characterData: true });
  addEl.addEventListener('click', function () { var b = addBtn(); close(); if (b) b.click(); });
  sh.querySelector('[data-ssheet-size]').addEventListener('click', function () {
    close();
    var pdc = document.querySelector('.product__info [data-pdc]') || document.querySelector('[data-pdc]');
    if (pdc) pdc.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  sh.querySelectorAll('[data-ssheet-close]').forEach(function (b) { b.addEventListener('click', close); });
  sh.addEventListener('click', function (e) { if (e.target === sh) close(); });
})();
</script>
