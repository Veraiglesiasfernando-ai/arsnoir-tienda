{%- comment -%}
  New product page picker (docs/ficha-producto-plan.md): Tipo · Tamaño · Marco.
  - Tipo: big buttons with a drawing. Works: Lámina · Lienzo. Portraits: Lámina · Lienzo · MIXPIX.
  - Tamaño: a dropdown («Elige un tamaño» · N tamaños disponibles · Hasta …) + «Guía de tamaños».
  - Marco: cards with a photo of the frame, in a horizontal row (Sin marco · Negro · Blanco · Madera,
    only those made for the chosen type).
  It is only a front: the real option radios stay in <variant-picker> (hidden with .vsteps--v2).
  Choosing here ticks those radios and fires «change» on the picker, so price, add-to-cart, the
  MIXPIX styles box and everything else listening to the picker keep working as before.
  Variants are sorted into type / size / frame from their option values (Gelato: Size + Product + Style;
  portraits: Tamaño + Acabado).
  - product, picker_id, step_offset, size_help
{%- endcomment -%}
{%- liquid
  assign step = step_offset | default: 0
  assign guide = size_help | default: '/pages/guia-de-tamanos'
  assign art = product.featured_media
  for m in product.media
    if m.preview_image.src contains '-obra'
      assign art = m
      break
    endif
  endfor
  assign preselect = false
  if product.selected_variant
    assign preselect = true
  endif
-%}
<div class="pdc" data-pdc data-picker="{{ picker_id }}" data-preselect="{{ preselect }}">
  {%- assign step = step | plus: 1 -%}
  <div class="pdc__step" data-pdc-step="type">
    <p class="pdc__head"><span class="pdc__num">{{ step }}</span><span class="pdc__title">Tipo</span></p>
    <div class="pdc__types" role="radiogroup" aria-label="Tipo">
      <button type="button" class="pdc__type" role="radio" aria-checked="false" data-type="lamina" hidden>
        <svg class="pdc__icon pdc__icon--paper" viewBox="0 0 48 48" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="pdcBg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e4e4e2"/><stop offset="1" stop-color="#c9c9c7"/></linearGradient><linearGradient id="pdcSheet" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#f1f1f3"/></linearGradient></defs><rect width="48" height="48" fill="url(#pdcBg)"/><path d="M0 0H48V27L26 40L0 31Z" fill="#000" opacity=".08" transform="translate(0 2)"/><path d="M0 0H48V27L26 40L0 31Z" fill="url(#pdcSheet)"/></svg>
        <span class="pdc__type-txt"><span class="pdc__type-name">Lámina</span><span class="pdc__type-from" data-from></span></span>
      </button>
      <button type="button" class="pdc__type" role="radio" aria-checked="false" data-type="lienzo" hidden>
        <svg class="pdc__icon pdc__icon--paper" viewBox="0 0 48 48" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="pdcBg2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e4e4e2"/><stop offset="1" stop-color="#c9c9c7"/></linearGradient><linearGradient id="pdcSheet2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#f1f1f3"/></linearGradient></defs><rect width="48" height="48" fill="url(#pdcBg2)"/><path d="M0 0H48V24L26 36L0 28Z" fill="#000" opacity=".1" transform="translate(0 6)"/><path d="M0 28L26 36V42L0 34Z" fill="#dcdcdc"/><path d="M26 36L48 24V30L26 42Z" fill="#c4c4c4"/><path d="M0 0H48V24L26 36L0 28Z" fill="url(#pdcSheet2)"/></svg>
        <span class="pdc__type-txt"><span class="pdc__type-name">Lienzo</span><span class="pdc__type-from" data-from></span></span>
      </button>
      <button type="button" class="pdc__type" role="radio" aria-checked="false" data-type="mixpix" hidden>
        <svg class="pdc__icon pdc__icon--art" viewBox="5 2 38 44" aria-hidden="true"><rect class="pdc__fr" x="4.5" y="4.5" width="18" height="18"/><g clip-path="url(#pdcM1)"><rect x="6" y="6" width="15" height="15" fill="#efe3d3"/><circle cx="16.200000000000003" cy="10.5" r="2.1" fill="#e3a35a"/><path d="M6 16.799999999999997 Q10.5 13.5 14.25 16.200000000000003 T21 15.0 V21 H6z" fill="#7d9c86"/><path d="M6 18.9 Q12.75 16.5 21 19.2 V21 H6z" fill="#3f5f52"/></g><clipPath id="pdcM1"><rect x="6" y="6" width="15" height="15"/></clipPath><rect class="pdc__fr" x="25.5" y="4.5" width="18" height="18"/><g clip-path="url(#pdcM2)"><rect x="27" y="6" width="15" height="15" fill="#efe3d3"/><circle cx="37.2" cy="10.5" r="2.1" fill="#e3a35a"/><path d="M27 16.799999999999997 Q31.5 13.5 35.25 16.200000000000003 T42 15.0 V21 H27z" fill="#7d9c86"/><path d="M27 18.9 Q33.75 16.5 42 19.2 V21 H27z" fill="#3f5f52"/></g><clipPath id="pdcM2"><rect x="27" y="6" width="15" height="15"/></clipPath><rect class="pdc__fr" x="4.5" y="25.5" width="18" height="18"/><g clip-path="url(#pdcM3)"><rect x="6" y="27" width="15" height="15" fill="#efe3d3"/><circle cx="16.200000000000003" cy="31.5" r="2.1" fill="#e3a35a"/><path d="M6 37.8 Q10.5 34.5 14.25 37.2 T21 36.0 V42 H6z" fill="#7d9c86"/><path d="M6 39.9 Q12.75 37.5 21 40.2 V42 H6z" fill="#3f5f52"/></g><clipPath id="pdcM3"><rect x="6" y="27" width="15" height="15"/></clipPath><rect class="pdc__fr" x="25.5" y="25.5" width="18" height="18"/><g clip-path="url(#pdcM4)"><rect x="27" y="27" width="15" height="15" fill="#efe3d3"/><circle cx="37.2" cy="31.5" r="2.1" fill="#e3a35a"/><path d="M27 37.8 Q31.5 34.5 35.25 37.2 T42 36.0 V42 H27z" fill="#7d9c86"/><path d="M27 39.9 Q33.75 37.5 42 40.2 V42 H27z" fill="#3f5f52"/></g><clipPath id="pdcM4"><rect x="27" y="27" width="15" height="15"/></clipPath></svg>
        <span class="pdc__type-txt"><span class="pdc__type-name">MIXPIX</span><span class="pdc__type-from" data-from></span></span>
      </button>
    </div>
  </div>

  {%- assign step = step | plus: 1 -%}
  <div class="pdc__step" data-pdc-step="size">
    <p class="pdc__head"><span class="pdc__num">{{ step }}</span><span class="pdc__title">Tamaño</span></p>
    <div class="pdc__sizerow">
      <div class="pdc__select" data-pdc-face role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="false" aria-label="Elige un tamaño">
        <select data-pdc-size hidden tabindex="-1" aria-hidden="true">
          <option value="" disabled selected>Elige un tamaño</option>
        </select>
        <span class="pdc__selface">
          <span class="pdc__seltxt" data-pdc-seltxt>Elige un tamaño</span>
          <span class="pdc__meta" data-pdc-sizemeta></span>
        </span>
        <svg class="pdc__caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        <ul class="pdc__list" data-pdc-list role="listbox" aria-label="Tamaños" hidden></ul>
      </div>
      <a class="pdc__guide" href="{{ guide }}">Guía de tamaños</a>
    </div>
  </div>

  {%- assign step = step | plus: 1 -%}
  <div class="pdc__step" data-pdc-step="frame">
    <p class="pdc__head"><span class="pdc__num">{{ step }}</span><span class="pdc__title">Marco</span><span class="pdc__value" data-pdc-framename></span></p>
    <div class="pdc__frames" role="radiogroup" aria-label="Marco">
      <button type="button" class="pdc__frame" role="radio" aria-checked="false" data-frame="sin" hidden>
        <span class="pdc__frame-img pdc__frame-img--none">
          {%- if art != blank -%}{{ art | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
        </span>
        <span class="pdc__frame-name">Sin marco</span>
        <span class="pdc__frame-price" data-price></span>
      </button>
      <button type="button" class="pdc__frame" role="radio" aria-checked="false" data-frame="negro" hidden>
        <span class="pdc__frame-img">{{ images['arsnoir-marco-black-detalle.webp'] | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}</span>
        <span class="pdc__frame-name" data-name-lamina="Negro" data-name-lienzo="Flotante negro">Negro</span>
        <span class="pdc__frame-price" data-price></span>
      </button>
      <button type="button" class="pdc__frame" role="radio" aria-checked="false" data-frame="blanco" hidden>
        <span class="pdc__frame-img">{{ images['arsnoir-marco-white-detalle.webp'] | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}</span>
        <span class="pdc__frame-name" data-name-lamina="Blanco" data-name-lienzo="Flotante blanco">Blanco</span>
        <span class="pdc__frame-price" data-price></span>
      </button>
      <button type="button" class="pdc__frame" role="radio" aria-checked="false" data-frame="madera" hidden>
        <span class="pdc__frame-img">{{ images['arsnoir-marco-wood-detalle.webp'] | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}</span>
        <span class="pdc__frame-name" data-name-lamina="Madera" data-name-lienzo="Flotante madera">Madera</span>
        <span class="pdc__frame-price" data-price></span>
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    var box = document.querySelector('[data-pdc]');
    if (!box || box.dataset.ready) return;
    box.dataset.ready = '1';
    var picker = document.getElementById(box.dataset.picker);
    if (!picker) return;
    var json = picker.querySelector('script[data-variants]');
    var variants = json ? JSON.parse(json.textContent) : [];
    var sets = Array.prototype.slice.call(picker.querySelectorAll('fieldset'));
    var sizeSet = picker.querySelector('fieldset[data-option-kind="size"]');
    var sizeI = sets.indexOf(sizeSet);
    var priceEl = document.getElementById(picker.dataset.price);
    var form = document.getElementById(picker.dataset.form);
    var button = form && form.querySelector('[type="submit"]');
    var select = box.querySelector('[data-pdc-size]');
    var meta = box.querySelector('[data-pdc-sizemeta]');
    var seltxt = box.querySelector('[data-pdc-seltxt]');
    var face = box.querySelector('[data-pdc-face]');
    var sizeList = box.querySelector('[data-pdc-list]');
    var openList = function (on) {
      sizeList.hidden = !on;
      face.setAttribute('aria-expanded', String(on));
      face.classList.toggle('is-open', on);
      if (on) {
        box.querySelector('[data-pdc-step="size"]').classList.remove('is-needed');
        var act = sizeList.querySelector('.is-active') || sizeList.firstElementChild;
        if (act) act.focus({ preventScroll: true });
        var r = sizeList.getBoundingClientRect();
        if (r.bottom > window.innerHeight) window.scrollBy({ top: r.bottom - window.innerHeight + 16, behavior: 'smooth' });
      }
    };
    var pickSize = function (sz) {
      select.value = sz;
      openList(false);
      face.focus({ preventScroll: true });
      select.dispatchEvent(new Event('change'));
    };
    face.addEventListener('click', function (e) {
      var row = e.target.closest('.pdc__row');
      if (row) { pickSize(row.dataset.size); return; }
      openList(sizeList.hidden);
    });
    face.addEventListener('keydown', function (e) {
      var row = e.target.closest('.pdc__row');
      if (e.key === 'Escape') { openList(false); face.focus(); return; }
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (row) pickSize(row.dataset.size); else openList(sizeList.hidden);
        return;
      }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (sizeList.hidden) { openList(true); return; }
        var rows = Array.prototype.slice.call(sizeList.children);
        var i = rows.indexOf(row);
        var next = rows[Math.max(0, Math.min(rows.length - 1, i + (e.key === 'ArrowDown' ? 1 : -1)))];
        if (next) next.focus();
      }
    });
    document.addEventListener('click', function (e) { if (!sizeList.hidden && !face.contains(e.target)) openList(false); });
    var frameName = box.querySelector('[data-pdc-framename]');
    var lang = document.documentElement.lang || 'es';
    var currency = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'EUR';
    var money = function (c) { return new Intl.NumberFormat(lang, { style: 'currency', currency: currency }).format(c / 100); };
    var FRAMES = { sin: 'Sin marco', negro: 'Negro', blanco: 'Blanco', madera: 'Madera' };
    var TYPES = ['lamina', 'lienzo', 'mixpix'];

    /* Size labels and order from the hidden size radios (snippets/option-label.liquid) */
    var sizeInfo = {};
    var shortLabel = function (l) {
      /* «MIXPIX 20×20 · pack de 3» → «Pack de 3 cuadros» (the type already says MIXPIX 20×20) */
      var m = /^MIXPIX[^·]*·\s*(.+)$/i.exec(l);
      if (!m) return l;
      var p = /pack de (\d+)/i.exec(m[1]);
      return p ? 'Pack de ' + p[1] + ' cuadros' : '1 cuadro suelto';
    };
    if (sizeSet) sizeSet.querySelectorAll('input').forEach(function (i) {
      sizeInfo[i.value] = { label: shortLabel(i.dataset.display || i.value), rank: parseInt(i.style.order, 10) || 99 };
    });

    var low = function (s) { return String(s || '').toLowerCase(); };
    var items = variants.map(function (v) {
      var opts = v.options || [];
      var all = low(opts.join(' '));
      var rest = low(opts.filter(function (o, i) { return i !== sizeI; }).join(' '));
      var type = all.indexOf('mixpix') > -1 ? 'mixpix' : (rest.indexOf('canvas') > -1 || rest.indexOf('lienzo') > -1) ? 'lienzo' : 'lamina';
      var frame = /black|negr/.test(rest) ? 'negro' : /white|blanc/.test(rest) ? 'blanco' : /wood|madera|natural/.test(rest) ? 'madera' : 'sin';
      return { v: v, type: type, frame: frame, size: opts[sizeI] };
    });

    var state = { type: null, size: null, frame: 'sin' };
    var of = function (t, s, f) {
      return items.filter(function (x) {
        return (!t || x.type === t) && (!s || x.size === s) && (!f || x.frame === f);
      });
    };
    var cheapest = function (list) {
      return list.reduce(function (a, x) { return !a || x.v.price < a.v.price ? x : a; }, null);
    };
    var sizesOf = function (t) {
      var seen = [];
      of(t).forEach(function (x) { if (seen.indexOf(x.size) < 0) seen.push(x.size); });
      return seen.sort(function (a, b) { return (sizeInfo[a] || {}).rank - (sizeInfo[b] || {}).rank; });
    };

    /* Types present: show the buttons with their real «desde» price */
    TYPES.forEach(function (t) {
      var b = box.querySelector('[data-type="' + t + '"]');
      var c = cheapest(of(t));
      if (!b || !c) return;
      b.hidden = false;
      b.querySelector('[data-from]').textContent = 'Desde ' + money(c.v.price);
    });

    /* Real discount only: the variant's own «compare at» price (set in Shopify), never invented */
    var pct = function (v) { return v && v.compare_at_price > v.price ? Math.round((v.compare_at_price - v.price) * 100 / v.compare_at_price) : 0; };
    var off = function (v) {
      var n = pct(v);
      return n ? ' <s class="pdc-was">' + money(v.compare_at_price) + '</s> <span class="pdc-off">-' + n + ' %</span>' : '';
    };
    function setPrice(text) {
      if (priceEl) priceEl.innerHTML = '<span class="price"><span>' + text + '</span></span>';
      document.querySelectorAll('.sticky-buy__price').forEach(function (el) { el.innerHTML = '<span>' + text + '</span>'; });
    }

    function renderSizes() {
      var list = sizesOf(state.type);
      select.innerHTML = '';
      var ph = document.createElement('option');
      ph.value = ''; ph.disabled = true; ph.textContent = 'Elige un tamaño';
      select.appendChild(ph);
      list.forEach(function (s) {
        var o = document.createElement('option');
        var c = cheapest(of(state.type, s, state.frame)) || cheapest(of(state.type, s));
        o.value = s;
        o.textContent = (sizeInfo[s] || {}).label + (c ? ' — ' + money(c.v.price) : '');
        select.appendChild(o);
      });
      select.value = state.size || '';
      /* The visible list: size, its paper format in grey, price on the right (red + old price when really reduced) */
      sizeList.innerHTML = '';
      list.forEach(function (sz) {
        var c = cheapest(of(state.type, sz, state.frame)) || cheapest(of(state.type, sz));
        var label = (sizeInfo[sz] || {}).label || sz;
        var parts = String(label).split(' · ');
        var main = label, hint = '';
        if (parts.length > 1 && /^(A\d|XL)$/i.test(parts[0])) { main = parts.slice(1).join(' · '); hint = parts[0]; }
        var li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', String(sz === state.size));
        li.tabIndex = -1;
        li.className = 'pdc__row' + (sz === state.size ? ' is-active' : '');
        li.dataset.size = sz;
        var n = c ? pct(c.v) : 0;
        li.innerHTML = '<span class="pdc__row-size">' + main + (hint ? ' <span class="pdc__row-hint">→ ' + hint + '</span>' : '') + '</span>' +
          (c ? '<span class="pdc__row-price' + (n ? ' is-off' : '') + '"><b>' + money(c.v.price) + '</b>' + (n ? '<s>' + money(c.v.compare_at_price) + '</s>' : '') + '</span>' : '');
        sizeList.appendChild(li);
      });
      var picked = select.options[select.selectedIndex];
      seltxt.textContent = state.size && picked ? picked.textContent.split(' — ')[0] : 'Elige un tamaño';
      var last = list.length ? (sizeInfo[list[list.length - 1]] || {}).label : '';
      var biggest = String(last).replace(/^[A-Z0-9]+ · /, '');
      var unit = state.type === 'mixpix' ? (list.length === 1 ? ' opción' : ' opciones') : (list.length === 1 ? ' tamaño disponible' : ' tamaños disponibles');
      meta.textContent = list.length + unit +
        (state.type === 'mixpix' ? ' · Cuadros de 20 × 20 cm' : (last ? ' · Hasta\u00a0' + biggest.replace(/ /g, '\u00a0') : ''));
    }

    function renderFrames() {
      var any = false;
      box.querySelectorAll('[data-frame]').forEach(function (b) {
        var f = b.dataset.frame;
        var made = of(state.type, null, f).length > 0;
        var here = state.size ? of(state.type, state.size, f) : [];
        b.hidden = !made;
        any = any || made;
        b.classList.toggle('is-unavailable', !!state.size && !here.length);
        var on = f === state.frame;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-checked', String(on));
        var n = b.querySelector('.pdc__frame-name');
        if (n && n.dataset.nameLamina) n.textContent = state.type === 'lienzo' ? n.dataset.nameLienzo : n.dataset.nameLamina;
        var c = here.length ? cheapest(here) : cheapest(of(state.type, null, f));
        b.querySelector('[data-price]').textContent = c ? (here.length ? '' : 'desde ') + money(c.v.price) : '';
        /* «-N %» on the frame photo when that frame really has a lower price than before (this size, or any) */
        var best = (here.length ? here : of(state.type, null, f)).reduce(function (m, x) { return Math.max(m, pct(x.v)); }, 0);
        var tag = b.querySelector('.pdc__frame-off');
        if (best) {
          if (!tag) { tag = document.createElement('span'); tag.className = 'pdc__frame-off'; b.querySelector('.pdc__frame-img').appendChild(tag); }
          tag.textContent = (here.length ? '-' : 'Hasta -') + best + ' %';
        } else if (tag) tag.remove();
      });
      box.querySelector('[data-pdc-step="frame"]').hidden = !any;
      var active = box.querySelector('[data-frame].is-active .pdc__frame-name');
      frameName.textContent = active ? active.textContent : '';
    }

    function renderTypes() {
      box.querySelectorAll('[data-type]').forEach(function (b) {
        var on = b.dataset.type === state.type;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-checked', String(on));
      });
    }

    /* Tick the hidden radios of the chosen variant and let the picker do the rest */
    function apply() {
      box.dataset.frame = state.frame;
      renderTypes(); renderSizes(); renderFrames();
      box.classList.toggle('is-incomplete', !state.size);
      if (!state.size) {
        var c = cheapest(of(state.type));
        if (c) setPrice('Desde ' + money(c.v.price) + off(c.v));
        return;
      }
      var hit = of(state.type, state.size, state.frame);
      var x = hit.filter(function (h) { return h.v.available; })[0] || hit[0];
      if (!x) return;
      x.v.options.forEach(function (val, i) {
        var fs = sets[i];
        if (fs) fs.querySelectorAll('input').forEach(function (inp) { inp.checked = inp.value === val; });
      });
      picker.dispatchEvent(new Event('change', { bubbles: true }));
    }

    box.addEventListener('click', function (e) {
      var t = e.target.closest('[data-type]');
      var f = e.target.closest('[data-frame]');
      if (t) {
        if (state.type === t.dataset.type) return;
        state.type = t.dataset.type;
        if (state.size && !of(state.type, state.size).length) state.size = null;
        if (!of(state.type, null, state.frame).length) state.frame = 'sin';
        if (!of(state.type, null, state.frame).length) state.frame = (of(state.type)[0] || {}).frame || 'sin';
        apply();
      } else if (f && !f.hidden) {
        state.frame = f.dataset.frame;
        /* Frame not made in this size: move to the closest size that has it */
        if (state.size && !of(state.type, state.size, state.frame).length) {
          var want = (sizeInfo[state.size] || {}).rank || 0;
          var fit = sizesOf(state.type).filter(function (s) { return of(state.type, s, state.frame).length; })
            .sort(function (a, b) { return Math.abs(sizeInfo[a].rank - want) - Math.abs(sizeInfo[b].rank - want); })[0];
          state.size = fit || null;
        }
        apply();
      }
    });
    select.addEventListener('change', function () {
      state.size = select.value || null;
      if (state.size && !of(state.type, state.size, state.frame).length) {
        var c = cheapest(of(state.type, state.size));
        if (c) state.frame = c.frame;
      }
      apply();
    });

    /* Add to cart without a size: point at the dropdown instead */
    if (form) form.addEventListener('submit', function (e) {
      if (state.size) return;
      e.preventDefault(); e.stopImmediatePropagation();
      box.querySelector('[data-pdc-step="size"]').classList.add('is-needed');
      face.focus({ preventScroll: true });
      face.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }, true);

    /* Start: a variant in the URL is shown as chosen; otherwise the cheapest type, no size yet */
