{%- comment -%}
  Black Friday countdown on the product page (real end date: the gift offer's last day,
  settings.gift_until, until 23:59 Madrid time). Hidden before the start and after the end.
{%- endcomment -%}
{%- liquid
  assign bf_end = settings.gift_until | default: settings.q4_bf_end
  assign bf_start = settings.gift_from | default: settings.q4_start
-%}
{%- if settings.gift_enabled and bf_end != blank and variant == 'bar' -%}
  {%- comment -%}
    Thin bar. On a product page (pass product) it lists that product's own real discounts
    (current price vs struck price, rounded down); elsewhere it shows the shop's highest real one.
  {%- endcomment -%}
  {%- liquid
    assign d_lam = 0
    assign d_lie = 0
    assign d_mar = 0
    assign d_max = 0
    if product
      for v in product.variants
        if v.compare_at_price > v.price
          assign pct = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price
          assign t = v.title | downcase
          if t contains 'sin marco'
            if pct > d_lam
              assign d_lam = pct
            endif
          elsif t contains 'marco' or t contains 'frame'
            if pct > d_mar
              assign d_mar = pct
            endif
          elsif t contains 'lienzo' or t contains 'canvas'
            if pct > d_lie
              assign d_lie = pct
            endif
          else
            if pct > d_lam
              assign d_lam = pct
            endif
          endif
          if pct > d_max
            assign d_max = pct
          endif
        endif
      endfor
    else
      assign d_max = 33
    endif
    assign d_kinds = 0
    if d_lam > 0
      assign d_kinds = d_kinds | plus: 1
    endif
    if d_lie > 0
      assign d_kinds = d_kinds | plus: 1
    endif
    if d_mar > 0
      assign d_kinds = d_kinds | plus: 1
    endif
  -%}
  {%- if d_max > 0 -%}
  <a class="bfc bfc--bar{% if product %} bfc--bar-inline{% elsif flow %} bfc--bar-flow{% endif %}" href="{% if product %}#{% else %}/collections/personalizalo{% endif %}"{% if product %} onclick="return false"{% endif %} data-bfc data-end="{{ bf_end }}T23:59:59+01:00" data-start="{{ bf_start }}T00:00:00+01:00" hidden>
    <b>BLACK FRIDAY</b><span class="bfc--bar__sep">·</span>
    {%- if d_kinds > 1 -%}
      <span>hasta</span>
      {%- if d_lam > 0 -%}<span><em>−{{ d_lam }} %</em> láminas</span><span class="bfc--bar__sep">·</span>{%- endif -%}
      {%- if d_lie > 0 -%}<span><em>−{{ d_lie }} %</em> lienzos</span><span class="bfc--bar__sep">·</span>{%- endif -%}
      {%- if d_mar > 0 -%}<span><em>−{{ d_mar }} %</em> con marco</span><span class="bfc--bar__sep">·</span>{%- endif -%}
    {%- else -%}
      <span>hasta <em>−{{ d_max }} %</em></span><span class="bfc--bar__sep">·</span>
    {%- endif -%}
    <span class="bfc--bar__t">termina en <span data-bfc-d>0</span>d <span data-bfc-h>00</span>:<span data-bfc-m>00</span>:<span data-bfc-s>00</span></span>
  </a>
  {%- endif -%}
{%- elsif settings.gift_enabled and bf_end != blank -%}
  <div class="bfc{% if variant == 'hero' %} bfc--hero{% endif %}" data-bfc data-end="{{ bf_end }}T23:59:59+01:00" data-start="{{ bf_start }}T00:00:00+01:00" hidden>
    {%- if variant == 'hero' -%}<p class="bfc__badge">BLACK FRIDAY</p>{%- endif -%}
    <p class="bfc__title"><span aria-hidden="true">⏳</span> {% if variant == 'hero' %}Termina en{% else %}El Black Friday termina en{% endif %}</p>
    <div class="bfc__time" role="timer" aria-live="off">
      <span><b data-bfc-d>0</b><i>días</i></span>
      <span><b data-bfc-h>00</b><i>horas</i></span>
      <span><b data-bfc-m>00</b><i>min</i></span>
      <span><b data-bfc-s>00</b><i>seg</i></span>
    </div>
    {%- comment -%} Real discounts: the shop's current price vs its struck price {%- endcomment -%}
    {%- if variant == 'hero' -%}
    <ul class="bfc__deals" role="list">
      <li><b>−32 %</b> Láminas desde 16,95 €</li>
      <li><b>−25 %</b> Lienzos desde 29,95 €</li>
      <li><b>−33 %</b> Lienzo con marco desde 39,95 €</li>
    </ul>
    {%- endif -%}
    {%- if settings.q4_bf_offer != blank -%}<p class="bfc__offer">{{ settings.q4_bf_offer }}</p>{%- endif -%}
    {%- if variant == 'hero' -%}<a class="bfc__cta" href="/collections/personalizalo">Crear su retrato →</a>{%- endif -%}
  </div>
{%- endif -%}
{%- if settings.gift_enabled and bf_end != blank -%}
  <script>
    (function () {
      var el = document.currentScript.previousElementSibling;
      var end = Date.parse(el.dataset.end), start = Date.parse(el.dataset.start);
      if (isNaN(end)) return;
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      var q = function (s) { return el.querySelector(s); };
      var tick = function () {
        var now = Date.now(), left = end - now;
        if (left <= 0 || (!isNaN(start) && now < start)) { el.hidden = true; return false; }
        el.hidden = false;
        var s = Math.floor(left / 1000);
        q('[data-bfc-d]').textContent = Math.floor(s / 86400);
        q('[data-bfc-h]').textContent = pad(Math.floor(s % 86400 / 3600));
        q('[data-bfc-m]').textContent = pad(Math.floor(s % 3600 / 60));
        q('[data-bfc-s]').textContent = pad(s % 60);
        return true;
      };
      if (tick()) var t = setInterval(function () { if (!tick()) clearInterval(t); }, 1000);
    })();
  </script>
{%- endif -%}
