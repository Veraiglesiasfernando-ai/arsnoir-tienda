{%- comment -%}
  «Tu foto en un cuadro»: ready-made looks under the product (border colour, filter, a short text and its
  lettering). Each card shows an example photo until the customer uploads theirs, then their photo.
  Choosing one applies it to the editor (the same fields the customer can change by hand) and goes up to
  the photo; before a photo is uploaded it opens the photo picker first and applies it afterwards.
{%- endcomment -%}
{%- liquid
  assign ex1 = 'arsnoir-card-tu-foto-familia.jpg' | file_url | append: '&width=600'
  assign ex2 = product.media[2] | image_url: width: 600
  assign ex3 = 'arsnoir-estilo-veranos-contigo.jpg' | file_img_url: '600x'
  assign ex4 = 'arsnoir-estilo-mejores-amigos.jpg' | file_img_url: '600x'
  assign ex5 = 'arsnoir-estilo-te-quiero-papa.jpg' | file_img_url: '600x'
  # name | border (blanco, negro, arena, sin) | filter | text | lettering | colour | position | example
  assign looks = 'Minimalista|blanco|Original|Nuestro gran día · 2026|Clásica|Negro|Abajo|1;Contraste|negro|Blanco y negro|Un futuro brillante|Clásica|Blanco|Abajo|1;Paseo|blanco|Cálido|Te quiero, papá|Moderna|Negro|Abajo|5;Arena|arena|Suave|Mejores amigos|Manuscrita|Granate|Abajo|4;Blanco y negro|blanco|Blanco y negro|Veranos contigo|Moderna|Negro|Abajo|3;A sangre|sin|Intenso|Verano 2026|Manuscrita|Blanco|Abajo|3' | split: ';'
-%}
<section class="pstyles" id="Estilos" data-pstyles>
  <div class="page-width">
    <div class="pstyles__head">
      <h2 class="pstyles__title">Pon tus recuerdos en la pared</h2>
      <p class="pstyles__text">Tienes cientos de fotos en el móvil. Elige un estilo y conviértelas en un cuadro: luego puedes cambiar el texto, el borde y el filtro.</p>
      <div class="pstyles__ori" role="group" aria-label="Orientación">
        <button type="button" class="pstyles__obtn is-on" data-pori="v" aria-pressed="true"><span class="pstyles__oico pstyles__oico--v"></span>Vertical</button>
        <button type="button" class="pstyles__obtn" data-pori="h" aria-pressed="false"><span class="pstyles__oico pstyles__oico--h"></span>Horizontal</button>
      </div>
    </div>
    <ul class="pstyles__grid" role="list">
      {%- for l in looks -%}
        {%- assign f = l | split: '|' -%}
        {%- if f[7] == '1' -%}{%- assign ex = ex1 -%}{%- elsif f[7] == '3' -%}{%- assign ex = ex3 -%}{%- elsif f[7] == '4' -%}{%- assign ex = ex4 -%}{%- elsif f[7] == '5' -%}{%- assign ex = ex5 -%}{%- else -%}{%- assign ex = ex2 -%}{%- endif -%}
        <li>
          <button type="button" class="pstyles__card" data-look="{{ f[0] | escape }}" data-border="{{ f[1] }}" data-filter="{{ f[2] | escape }}" data-text="{{ f[3] | escape }}" data-font="{{ f[4] }}" data-color="{{ f[5] }}" data-pos="{{ f[6] }}">
            <span class="pstyles__frame pstyles__frame--{{ f[1] }}">
              <img src="{{ ex }}" alt="" loading="lazy" data-pstyles-img class="pstyles__img pstyles__img--{{ f[2] | handleize }}">
              <span class="pstyles__cap pstyles__cap--{{ f[4] | handleize }} pstyles__cap--{{ f[5] | handleize }}">{{ f[3] }}</span>
            </span>
            <span class="pstyles__name">{{ f[0] }}</span>
            <span class="pstyles__go">Usar este estilo →</span>
          </button>
        </li>
      {%- endfor -%}
    </ul>
    <p class="pstyles__swipe" aria-hidden="true">Desliza para ver los {{ looks.size }} estilos <span>→</span></p>
    {%- assign cp = all_products['crea-tu-poster'] -%}
    {%- if cp.id and cp.available -%}
      {%- comment -%} The «Crea tu póster» designs: each card opens the editor with that design chosen {%- endcomment -%}
      <div class="pmore">
        <h3 class="pmore__title">Más diseños para tu póster</h3>
        <p class="pmore__text">Sube tus fotos, escribe tus textos y míralo en directo antes de comprar.</p>
        <ul class="pmore__grid" role="list">
          {%- assign designs = 'collage|Collage|collage,cancion|Portada de canción|canción,revista|Portada de revista|revista,fotomaton|Fotomatón|fotomatón,tipo|Tipográfico|tipográfico,estrellas|Mapa de estrellas|estrellas,mapa|Mapa de un lugar|mapa' | split: ',' -%}
          {%- for d in designs -%}
            {%- assign p = d | split: '|' -%}
            {%- assign img = nil -%}
            {%- for m in cp.media -%}{%- assign al = m.alt | downcase -%}{%- if al contains p[2] -%}{%- assign img = m -%}{%- break -%}{%- endif -%}{%- endfor -%}
            <li><a class="pmore__card" href="{{ cp.url }}#{{ p[0] }}">
              <span class="pmore__media">{%- if img -%}{{ img | image_url: width: 500 | image_tag: loading: 'lazy', widths: '300, 500', sizes: '(min-width: 990px) 14vw, 44vw', alt: p[1] }}{%- else -%}<span class="pmore__ph"><b>{{ p[1] }}</b><small>Tu lugar · tus coordenadas</small></span>{%- endif -%}</span>
              <span class="pmore__name">{{ p[1] }}</span>
              <span class="pmore__go">Crear el mío →</span>
            </a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>
<script>
  (function () {
    var box = document.querySelector('[data-pstyles]');
    if (!box) return;
    var BORDER = { blanco: 'Con borde blanco', negro: 'Con borde negro', arena: 'Con borde arena', sin: 'A sangre' };
    var pending = null;
    var ori = 'v';
    var grid = box.querySelector('.pstyles__grid');
    /* Vertical / Horizontal: the cards turn at once, and the chosen one goes to the editor with the look */
    var setOri = function (o) {
      ori = o;
      grid.classList.toggle('is-h', o === 'h');
      box.querySelectorAll('[data-pori]').forEach(function (b) { var on = b.dataset.pori === o; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', on); });
    };
    box.querySelectorAll('[data-pori]').forEach(function (b) { b.addEventListener('click', function () { setOri(b.dataset.pori); }); });
    var pick = function (sel) { var i = document.querySelector(sel); if (i && !i.checked) { i.checked = true; i.dispatchEvent(new Event('change', { bubbles: true })); } };
    var apply = function (b) {
      pick('input[name="properties[Borde]"][value="' + BORDER[b.dataset.border] + '"]');
      var flt = document.querySelector('.fedit__flt[data-filter="' + b.dataset.filter + '"]');
      if (flt) flt.click();
      var tx = document.getElementById('PhotoText');
      if (tx) { tx.value = b.dataset.text; tx.dispatchEvent(new Event('input', { bubbles: true })); }
      pick('input[name="properties[Tipografía]"][value="' + b.dataset.font + '"]');
      pick('input[name="properties[Color del texto]"][value="' + b.dataset.color + '"]');
      pick('input[name="properties[Posición del texto]"][value="' + b.dataset.pos + '"]');
      if (tx) tx.dispatchEvent(new Event('input', { bubbles: true }));
      var ob = document.querySelector('[data-orient="' + ori + '"]');
      if (ob && !ob.classList.contains('is-on')) ob.click();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };
    box.addEventListener('click', function (e) {
      var b = e.target.closest('[data-look]');
      if (!b) return;
      if (document.querySelector('.fedit')) { apply(b); return; }
      /* no photo yet: choose one first, the look is applied once the photo is in */
      pending = b;
      var f = document.querySelector('[data-fintro-file]') || document.querySelector('input[data-cupload]');
      if (f) f.click();
    });
    document.addEventListener('change', function (e) {
      var t = e.target;
      if (!(t.matches && t.matches('input[data-cupload]') && t.files && t.files[0])) return;
      var url = URL.createObjectURL(t.files[0]);
      box.querySelectorAll('[data-pstyles-img]').forEach(function (im) { im.src = url; });
      var probe = new Image();
      probe.onload = function () { if (!pending) setOri(probe.naturalWidth > probe.naturalHeight ? 'h' : 'v'); };
      probe.src = url;
      if (pending) { var b = pending; pending = null; setTimeout(function () { apply(b); }, 900); }
    });
  })();
</script>
