{%- comment -%}
  «1 obra / 2 obras −15 %» tiles above the add-to-cart button (catalogue artworks only).
  Mirrors the real automatic discount in Shopify (settings: pack_percent, pack_min, pack_until):
  «2 obras» opens a search over every work of the shop to pick the second one (or the same one twice;
  on personalised products also «Crear otra personalizada»). Shown on works and personalised products;
  the discount is applied by Shopify in the cart. Hidden after pack_until.
  Prices follow the selected variant (assets/pack-picker.js).
{%- endcomment -%}
{%- liquid
  assign pack_pct = settings.pack_percent | default: 0
  assign pack_min = settings.pack_min | default: 2
  assign today = 'now' | date: '%Y-%m-%d'
  assign show = false
  assign custom = false
  if product.type == 'Personalizado'
    assign custom = true
  endif
  # Personalised pieces say what they are: an illustration (studio templates) or a photo frame
  assign one_label = '1 obra'
  assign two_label = pack_min | append: ' obras'
  assign another = 'obra'
  if custom
    assign one_label = '1 cuadro'
    assign two_label = 'Añade otro cuadro'
    assign another = 'cuadro'
    if product.template_suffix contains 'ilustracion'
      assign one_label = '1 ilustración'
      assign two_label = 'Añade otra ilustración'
      assign another = 'ilustración'
    endif
  endif
  if pack_pct > 0
    if custom
      assign show = true
    endif
    for c in product.collections
      if c.handle == 'obras'
        assign show = true
      endif
    endfor
  endif
  if settings.pack_until != blank and today > settings.pack_until
    assign show = false
  endif
-%}
{%- if show -%}
  {%- liquid
    assign keep = 100 | minus: pack_pct
    assign one = current_variant.price
    assign full = one | times: pack_min
    assign packed = full | times: keep | divided_by: 100
    assign saved = full | minus: packed
  -%}
  <div class="ppick" data-pack-picker data-form="{{ form_id }}" data-min="{{ pack_min }}" data-pct="{{ pack_pct }}">
    <button type="button" class="ppick__tile is-active" data-pack-qty="1" aria-pressed="true">
      <span class="ppick__name">{{ one_label }}</span>
      <span class="ppick__price" data-pack-one>{{ one | money }}</span>
    </button>
    <button type="button" class="ppick__tile ppick__tile--pack" data-pack-qty="{{ pack_min }}" aria-pressed="false">
      <span class="ppick__tag">-{{ pack_pct }} %</span>
      <span class="ppick__name">{{ two_label }}</span>
      <span class="ppick__price"><s data-pack-full>{{ full | money }}</s> <span data-pack-total>{{ packed | money }}</span></span>
      <span class="ppick__save">Ahorras <span data-pack-saved>{{ saved | money }}</span></span>
    </button>
    {%- comment -%} «2 obras»: search any work of the shop and pick it as the second one (pack-picker.js) {%- endcomment -%}
    <div class="ppick__more" data-pack-more data-current="{{ product.id }}" data-key="{{ current_variant.title | escape }}" hidden>
      <p class="ppick__more-title">{% if custom %}Elige tu segunda pieza{% else %}Elige tu segunda obra{% endif %}</p>
      {%- if custom -%}
        {%- comment -%} Adds this one to the cart, then goes to make the second one (the -15 % applies in the cart):
            another illustration (Personalízalo) or any image printed as it is («Tu foto, en un cuadro») {%- endcomment -%}
        {%- assign photo_product = all_products['tu-foto-en-un-cuadro'] -%}
        {%- if another == 'ilustración' -%}
          {%- liquid
            assign pair = blank
            if product.handle == 'retrato-glam'
              assign pair = all_products['retrato-comic']
            elsif product.handle == 'retrato-comic'
              assign pair = all_products['retrato-glam']
            endif
          -%}
          {%- if pair != blank -%}
            <button type="button" class="ppick__create" data-pack-create="{{ pair.url }}">
              <span>Ahora en estilo {% if product.handle == 'retrato-glam' %}cómic{% else %}glam{% endif %}</span>
              <small>Añadimos esta al carrito y creas la otra con la misma foto: pack Glam + Cómic</small>
            </button>
          {%- endif -%}
          <button type="button" class="ppick__create" data-pack-create="{{ routes.collections_url }}/personalizalo#Plantillas">
            <span>Crear otra ilustración</span>
            <small>Añadimos esta al carrito y eliges otro estilo u otra foto</small>
          </button>
          {%- if photo_product != blank -%}
            <button type="button" class="ppick__create" data-pack-create="{{ photo_product.url }}">
              <span>Subir otra imagen, tal cual</span>
              <small>Sin ilustración: imprimimos la foto o imagen que quieras</small>
            </button>
          {%- endif -%}
        {%- else -%}
          <button type="button" class="ppick__create" data-pack-create="{{ product.url }}">
            <span>Subir otra imagen</span>
            <small>Añadimos esta al carrito y subes la siguiente</small>
          </button>
          <button type="button" class="ppick__create" data-pack-create="{{ routes.collections_url }}/personalizalo#Plantillas">
            <span>Convertir una foto en ilustración</span>
            <small>Elige un estilo: mascota, familia, momento…</small>
          </button>
        {%- endif -%}
        <p class="ppick__or">o elige una obra de la tienda</p>
      {%- endif -%}
      <label class="ppick__search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8"/></svg>
        <input type="search" placeholder="Busca cualquier obra: coche, tigre, flores…" data-pack-q autocomplete="off" aria-label="Buscar obra">
      </label>
      <p class="ppick__hint" data-pack-hint>Toca una y se añaden las 2 al carrito con el -{{ pack_pct }} %. Mismo tamaño y acabado que esta.</p>
      <ul class="ppick__list" data-pack-list aria-live="polite"></ul>
      <p class="ppick__empty" data-pack-empty hidden>No hay ninguna obra con ese nombre.</p>
      <input type="hidden" data-pack-extra value="">
      <button type="button" class="ppick__same" data-pack-same aria-pressed="false">{% if custom %}O la misma dos veces (para regalar){% else %}O llévate esta misma dos veces{% endif %}</button>
    </div>
    <p class="ppick__note">
      {%- if custom -%}Con 2 en el carrito, el -{{ pack_pct }} % se aplica solo{%- elsif pack_min == 2 -%}O combina 2 obras distintas: el -{{ pack_pct }} % se aplica solo en el carrito{%- else -%}El -{{ pack_pct }} % se aplica solo en el carrito{%- endif -%}
      {%- if settings.pack_until != blank -%}{%- assign end_day = settings.pack_until | date: '%-d' -%}{%- assign end_month = settings.pack_until | date: '%-m' | minus: 1 -%} · hasta el {{ end_day }} de {{ 'enero,febrero,marzo,abril,mayo,junio,julio,agosto,septiembre,octubre,noviembre,diciembre' | split: ',' | slice: end_month | first | default: '' }}{%- endif -%}
    </p>
  </div>
  <script src="{{ 'pack-picker.js' | asset_url }}" defer></script>
{%- endif -%}
