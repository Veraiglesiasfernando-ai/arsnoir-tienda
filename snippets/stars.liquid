{%- comment -%}
  Five-star rating.
  - rating: number (e.g. 4.8)
  - max: scale max (default 5)
  - count: optional number of reviews
  - label: optional text after the count (default "reseñas")
{%- endcomment -%}
{%- liquid
  assign max = max | default: 5
  assign num = rating | append: '' | replace: ',', '.' | plus: 0
  assign pct = num | times: 100.0 | divided_by: max
  assign shown = num | round: 1 | append: '' | replace: '.', ','
-%}
<span class="stars" role="img" aria-label="{{ shown }} de {{ max }} estrellas">
  <span class="stars__track" aria-hidden="true">★★★★★<span class="stars__fill" style="width: {{ pct }}%">★★★★★</span></span>
  <span class="stars__value">{{ shown }}</span>
  {%- if count != blank and count > 0 -%}<span class="stars__count">· {{ count }} {{ label | default: 'reseñas' }}</span>{%- endif -%}
</span>
